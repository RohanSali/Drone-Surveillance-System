<Window x:Class="DroneSurveillanceSystem.Views.NetworkProfileManager"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network Profile Manager" Height="900" Width="1400"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#FF0A0A0A"
        FontFamily="Segoe UI">
    
    &lt;Window.Resources&gt;
        &lt;!-- Modern Button Style --&gt;
        &lt;Style x:Key="ModernButton" TargetType="Button"&gt;
            &lt;Setter Property="Background" Value="#FF0078D4"/&gt;
            &lt;Setter Property="Foreground" Value="White"/&gt;
            &lt;Setter Property="BorderThickness" Value="0"/&gt;
            &lt;Setter Property="Padding" Value="20,12"/&gt;
            &lt;Setter Property="Margin" Value="8"/&gt;
            &lt;Setter Property="FontWeight" Value="Bold"/&gt;
            &lt;Setter Property="FontSize" Value="14"/&gt;
            &lt;Setter Property="Cursor" Value="Hand"/&gt;
            &lt;Setter Property="MinWidth" Value="140"/&gt;
            &lt;Setter Property="Height" Value="45"/&gt;
            &lt;Setter Property="Template"&gt;
                &lt;Setter.Value&gt;
                    &lt;ControlTemplate TargetType="Button"&gt;
                        &lt;Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"&gt;
                            &lt;ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/&gt;
                        &lt;/Border&gt;
                        &lt;ControlTemplate.Triggers&gt;
                            &lt;Trigger Property="IsMouseOver" Value="True"&gt;
                                &lt;Setter Property="Background" Value="#FF106EBE"/&gt;
                            &lt;/Trigger&gt;
                            &lt;Trigger Property="IsPressed" Value="True"&gt;
                                &lt;Setter Property="Background" Value="#FF005A9E"/&gt;
                            &lt;/Trigger&gt;
                        &lt;/ControlTemplate.Triggers&gt;
                    &lt;/ControlTemplate&gt;
                &lt;/Setter.Value&gt;
            &lt;/Setter&gt;
        &lt;/Style&gt;

        &lt;Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource ModernButton}"&gt;
            &lt;Setter Property="Background" Value="#FF28A745"/&gt;
            &lt;Style.Triggers&gt;
                &lt;Trigger Property="IsMouseOver" Value="True"&gt;
                    &lt;Setter Property="Background" Value="#FF218838"/&gt;
                &lt;/Trigger&gt;
            &lt;/Style.Triggers&gt;
        &lt;/Style&gt;

        &lt;Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}"&gt;
            &lt;Setter Property="Background" Value="#FFDC3545"/&gt;
            &lt;Style.Triggers&gt;
                &lt;Trigger Property="IsMouseOver" Value="True"&gt;
                    &lt;Setter Property="Background" Value="#FFC82333"/&gt;
                &lt;/Trigger&gt;
            &lt;/Style.Triggers&gt;
        &lt;/Style&gt;

        &lt;Style x:Key="WarningButton" TargetType="Button" BasedOn="{StaticResource ModernButton}"&gt;
            &lt;Setter Property="Background" Value="#FFFFC107"/&gt;
            &lt;Setter Property="Foreground" Value="#FF212529"/&gt;
            &lt;Style.Triggers&gt;
                &lt;Trigger Property="IsMouseOver" Value="True"&gt;
                    &lt;Setter Property="Background" Value="#FFE0A800"/&gt;
                &lt;/Trigger&gt;
            &lt;/Style.Triggers&gt;
        &lt;/Style&gt;

        &lt;!-- Text Styles --&gt;
        &lt;Style x:Key="HeaderStyle" TargetType="TextBlock"&gt;
            &lt;Setter Property="Foreground" Value="White"/&gt;
            &lt;Setter Property="FontSize" Value="18"/&gt;
            &lt;Setter Property="FontWeight" Value="Bold"/&gt;
            &lt;Setter Property="Margin" Value="10,5"/&gt;
        &lt;/Style&gt;

        &lt;Style x:Key="SubHeaderStyle" TargetType="TextBlock"&gt;
            &lt;Setter Property="Foreground" Value="#FFCCCCCC"/&gt;
            &lt;Setter Property="FontSize" Value="14"/&gt;
            &lt;Setter Property="FontWeight" Value="SemiBold"/&gt;
            &lt;Setter Property="Margin" Value="10,5"/&gt;
        &lt;/Style&gt;

        &lt;Style x:Key="DataTextStyle" TargetType="TextBlock"&gt;
            &lt;Setter Property="Foreground" Value="#FFCCCCCC"/&gt;
            &lt;Setter Property="FontSize" Value="12"/&gt;
            &lt;Setter Property="Margin" Value="5,2"/&gt;
        &lt;/Style&gt;

        &lt;!-- Input Styles --&gt;
        &lt;Style x:Key="ModernTextBox" TargetType="TextBox"&gt;
            &lt;Setter Property="Background" Value="#FF2D2D30"/&gt;
            &lt;Setter Property="Foreground" Value="White"/&gt;
            &lt;Setter Property="BorderBrush" Value="#FF404040"/&gt;
            &lt;Setter Property="BorderThickness" Value="1"/&gt;
            &lt;Setter Property="Padding" Value="10,8"/&gt;
            &lt;Setter Property="FontSize" Value="14"/&gt;
            &lt;Setter Property="Height" Value="40"/&gt;
            &lt;Setter Property="Template"&gt;
                &lt;Setter.Value&gt;
                    &lt;ControlTemplate TargetType="TextBox"&gt;
                        &lt;Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"&gt;
                            &lt;ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/&gt;
                        &lt;/Border&gt;
                    &lt;/ControlTemplate&gt;
                &lt;/Setter.Value&gt;
            &lt;/Setter&gt;
        &lt;/Style&gt;

        &lt;Style x:Key="ModernComboBox" TargetType="ComboBox"&gt;
            &lt;Setter Property="Background" Value="#FF2D2D30"/&gt;
            &lt;Setter Property="Foreground" Value="White"/&gt;
            &lt;Setter Property="BorderBrush" Value="#FF404040"/&gt;
            &lt;Setter Property="BorderThickness" Value="1"/&gt;
            &lt;Setter Property="Padding" Value="10,8"/&gt;
            &lt;Setter Property="FontSize" Value="14"/&gt;
            &lt;Setter Property="Height" Value="40"/&gt;
        &lt;/Style&gt;

        &lt;!-- Card Style --&gt;
        &lt;Style x:Key="CardStyle" TargetType="Border"&gt;
            &lt;Setter Property="Background" Value="#FF2D2D30"/&gt;
            &lt;Setter Property="BorderBrush" Value="#FF404040"/&gt;
            &lt;Setter Property="BorderThickness" Value="1"/&gt;
            &lt;Setter Property="CornerRadius" Value="10"/&gt;
            &lt;Setter Property="Padding" Value="20"/&gt;
            &lt;Setter Property="Margin" Value="10"/&gt;
        &lt;/Style&gt;
    &lt;/Window.Resources&gt;

    &lt;Grid&gt;
        &lt;Grid.RowDefinitions&gt;
            &lt;RowDefinition Height="80"/&gt;
            &lt;RowDefinition Height="*"/&gt;
            &lt;RowDefinition Height="60"/&gt;
        &lt;/Grid.RowDefinitions&gt;

        &lt;!-- Header --&gt;
        &lt;Border Grid.Row="0" Background="#FF1E1E1E" BorderBrush="#FF404040" BorderThickness="0,0,0,2"&gt;
            &lt;Grid&gt;
                &lt;Grid.ColumnDefinitions&gt;
                    &lt;ColumnDefinition Width="*"/&gt;
                    &lt;ColumnDefinition Width="Auto"/&gt;
                &lt;/Grid.ColumnDefinitions&gt;
                
                &lt;StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0"&gt;
                    &lt;Ellipse Width="50" Height="50" Fill="#FF0078D4" Margin="0,0,15,0"/&gt;
                    &lt;TextBlock Text="🌐" FontSize="35" VerticalAlignment="Center" Margin="-42,0,20,0" Foreground="#FF00BCD4"/&gt;
                    &lt;StackPanel VerticalAlignment="Center"&gt;
                        &lt;TextBlock Text="NETWORK PROFILE MANAGER" 
                                  Foreground="White" 
                                  FontWeight="Bold" 
                                  FontSize="24"/&gt;
                        &lt;TextBlock Text="Create, Edit, and Manage Drone Network Profiles" 
                                  Foreground="#FF888888" 
                                  FontSize="14"/&gt;
                    &lt;/StackPanel&gt;
                &lt;/StackPanel&gt;

                &lt;Button Grid.Column="1" 
                        Name="CloseButton" 
                        Content="✖ Close" 
                        Style="{StaticResource DangerButton}" 
                        Click="CloseButton_Click"
                        Margin="20,0"/&gt;
            &lt;/Grid&gt;
        &lt;/Border&gt;

        &lt;!-- Main Content --&gt;
        &lt;Grid Grid.Row="1" Margin="20"&gt;
            &lt;Grid.ColumnDefinitions&gt;
                &lt;ColumnDefinition Width="*"/&gt;
                &lt;ColumnDefinition Width="400"/&gt;
            &lt;/Grid.ColumnDefinitions&gt;

            &lt;!-- Left Panel - Network List --&gt;
            &lt;Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,10,0"&gt;
                &lt;Grid&gt;
                    &lt;Grid.RowDefinitions&gt;
                        &lt;RowDefinition Height="Auto"/&gt;
                        &lt;RowDefinition Height="Auto"/&gt;
                        &lt;RowDefinition Height="*"/&gt;
                    &lt;/Grid.RowDefinitions&gt;

                    &lt;!-- Network List Header --&gt;
                    &lt;StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20"&gt;
                        &lt;TextBlock Text="📋 Network Profiles" Style="{StaticResource HeaderStyle}"/&gt;
                        &lt;Button Name="CreateNetworkButton" 
                                Content="➕ Create New" 
                                Style="{StaticResource SuccessButton}"
                                Click="CreateNetworkButton_Click"
                                Margin="20,0,0,0"/&gt;
                    &lt;/StackPanel&gt;

                    &lt;!-- Search and Filter --&gt;
                    &lt;Grid Grid.Row="1" Margin="0,0,0,20"&gt;
                        &lt;Grid.ColumnDefinitions&gt;
                            &lt;ColumnDefinition Width="*"/&gt;
                            &lt;ColumnDefinition Width="200"/&gt;
                        &lt;/Grid.ColumnDefinitions&gt;
                        
                        &lt;TextBox Grid.Column="0" 
                                 Name="SearchTextBox"
                                 Style="{StaticResource ModernTextBox}"
                                 Margin="0,0,10,0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Search networks..."/&gt;
                        
                        &lt;ComboBox Grid.Column="1"
                                  Name="StatusFilterComboBox"
                                  Style="{StaticResource ModernComboBox}"&gt;
                            &lt;ComboBoxItem Content="All Networks" IsSelected="True"/&gt;
                            &lt;ComboBoxItem Content="Active Only"/&gt;
                            &lt;ComboBoxItem Content="Standby Only"/&gt;
                            &lt;ComboBoxItem Content="Offline Only"/&gt;
                        &lt;/ComboBox&gt;
                    &lt;/Grid&gt;

                    &lt;!-- Network List --&gt;
                    &lt;ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"&gt;
                        &lt;StackPanel Name="NetworkListPanel"&gt;
                            &lt;!-- Network profiles will be added programmatically --&gt;
                        &lt;/StackPanel&gt;
                    &lt;/ScrollViewer&gt;
                &lt;/Grid&gt;
            &lt;/Border&gt;

            &lt;!-- Right Panel - Network Details/Editor --&gt;
            &lt;Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="10,0,0,0"&gt;
                &lt;Grid&gt;
                    &lt;Grid.RowDefinitions&gt;
                        &lt;RowDefinition Height="Auto"/&gt;
                        &lt;RowDefinition Height="*"/&gt;
                        &lt;RowDefinition Height="Auto"/&gt;
                    &lt;/Grid.RowDefinitions&gt;

                    &lt;!-- Editor Header --&gt;
                    &lt;TextBlock Grid.Row="0" 
                               Name="EditorHeaderText"
                               Text="⚙️ Network Configuration" 
                               Style="{StaticResource HeaderStyle}"
                               Margin="0,0,0,20"/&gt;

                    &lt;!-- Network Editor --&gt;
                    &lt;ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"&gt;
                        &lt;StackPanel Name="NetworkEditorPanel"&gt;
                            &lt;!-- Basic Information --&gt;
                            &lt;TextBlock Text="Basic Information" Style="{StaticResource SubHeaderStyle}"/&gt;
                            
                            &lt;TextBlock Text="Network Name" Style="{StaticResource DataTextStyle}"/&gt;
                            &lt;TextBox Name="NetworkNameTextBox" 
                                     Style="{StaticResource ModernTextBox}"
                                     Margin="0,0,0,15"/&gt;
                            
                            &lt;TextBlock Text="Description" Style="{StaticResource DataTextStyle}"/&gt;
                            &lt;TextBox Name="NetworkDescriptionTextBox" 
                                     Style="{StaticResource ModernTextBox}"
                                     Margin="0,0,0,15"/&gt;
                            
                            &lt;TextBlock Text="Coverage Region" Style="{StaticResource DataTextStyle}"/&gt;
                            &lt;ComboBox Name="CoverageRegionComboBox" 
                                      Style="{StaticResource ModernComboBox}"
                                      Margin="0,0,0,15"&gt;
                                &lt;ComboBoxItem Content="Urban Zone"/&gt;
                                &lt;ComboBoxItem Content="Industrial Area"/&gt;
                                &lt;ComboBoxItem Content="Residential District"/&gt;
                                &lt;ComboBoxItem Content="Commercial Center"/&gt;
                                &lt;ComboBoxItem Content="Border Perimeter"/&gt;
                                &lt;ComboBoxItem Content="Emergency Route"/&gt;
                            &lt;/ComboBox&gt;
                            
                            &lt;TextBlock Text="Priority Level" Style="{StaticResource DataTextStyle}"/&gt;
                            &lt;ComboBox Name="PriorityLevelComboBox" 
                                      Style="{StaticResource ModernComboBox}"
                                      Margin="0,0,0,15"&gt;
                                &lt;ComboBoxItem Content="High Priority"/&gt;
                                &lt;ComboBoxItem Content="Medium Priority" IsSelected="True"/&gt;
                                &lt;ComboBoxItem Content="Low Priority"/&gt;
                            &lt;/ComboBox&gt;

                            &lt;Separator Background="#FF404040" Height="1" Margin="0,20"/&gt;

                            &lt;!-- Drone Assignment --&gt;
                            &lt;TextBlock Text="Assigned Drones" Style="{StaticResource SubHeaderStyle}"/&gt;
                            
                            &lt;Grid Margin="0,10"&gt;
                                &lt;Grid.ColumnDefinitions&gt;
                                    &lt;ColumnDefinition Width="*"/&gt;
                                    &lt;ColumnDefinition Width="Auto"/&gt;
                                &lt;/Grid.ColumnDefinitions&gt;
                                
                                &lt;ComboBox Grid.Column="0" 
                                          Name="AvailableDronesComboBox"
                                          Style="{StaticResource ModernComboBox}"
                                          Margin="0,0,10,0"/&gt;
                                
                                &lt;Button Grid.Column="1"
                                        Name="AddDroneButton"
                                        Content="➕ Add"
                                        Style="{StaticResource SuccessButton}"
                                        Width="80"
                                        Click="AddDroneButton_Click"/&gt;
                            &lt;/Grid&gt;

                            &lt;!-- Assigned Drones List --&gt;
                            &lt;Border Background="#FF1A1A1A" 
                                    CornerRadius="6" 
                                    Padding="10" 
                                    Margin="0,10,0,15"&gt;
                                &lt;ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto"&gt;
                                    &lt;StackPanel Name="AssignedDronesPanel"&gt;
                                        &lt;!-- Assigned drones will be added programmatically --&gt;
                                    &lt;/StackPanel&gt;
                                &lt;/ScrollViewer&gt;
                            &lt;/Border&gt;

                            &lt;Separator Background="#FF404040" Height="1" Margin="0,20"/&gt;

                            &lt;!-- Network Configuration --&gt;
                            &lt;TextBlock Text="Network Configuration" Style="{StaticResource SubHeaderStyle}"/&gt;
                            
                            &lt;TextBlock Text="Operation Mode" Style="{StaticResource DataTextStyle}"/&gt;
                            &lt;ComboBox Name="OperationModeComboBox" 
                                      Style="{StaticResource ModernComboBox}"
                                      Margin="0,0,0,15"&gt;
                                &lt;ComboBoxItem Content="Surveillance Mode"/&gt;
                                &lt;ComboBoxItem Content="Patrol Mode" IsSelected="True"/&gt;
                                &lt;ComboBoxItem Content="Emergency Response"/&gt;
                                &lt;ComboBoxItem Content="Search &amp; Rescue"/&gt;
                            &lt;/ComboBox&gt;
                            
                            &lt;CheckBox Name="AutoActivateCheckBox"
                                      Content="Auto-activate on detection"
                                      Foreground="White"
                                      FontSize="14"
                                      Margin="0,0,0,15"/&gt;
                            
                            &lt;CheckBox Name="AlertNotificationCheckBox"
                                      Content="Enable alert notifications"
                                      Foreground="White"
                                      FontSize="14"
                                      IsChecked="True"
                                      Margin="0,0,0,15"/&gt;
                        &lt;/StackPanel&gt;
                    &lt;/ScrollViewer&gt;

                    &lt;!-- Action Buttons --&gt;
                    &lt;StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"&gt;
                        &lt;Button Name="SaveNetworkButton" 
                                Content="💾 Save" 
                                Style="{StaticResource SuccessButton}"
                                Click="SaveNetworkButton_Click"/&gt;
                        &lt;Button Name="CancelEditButton" 
                                Content="❌ Cancel" 
                                Style="{StaticResource WarningButton}"
                                Click="CancelEditButton_Click"/&gt;
                        &lt;Button Name="DeleteNetworkButton" 
                                Content="🗑️ Delete" 
                                Style="{StaticResource DangerButton}"
                                Click="DeleteNetworkButton_Click"/&gt;
                    &lt;/StackPanel&gt;
                &lt;/Grid&gt;
            &lt;/Border&gt;
        &lt;/Grid&gt;

        &lt;!-- Footer Status Bar --&gt;
        &lt;Border Grid.Row="2" Background="#FF1E1E1E"&gt;
            &lt;Grid&gt;
                &lt;Grid.ColumnDefinitions&gt;
                    &lt;ColumnDefinition Width="*"/&gt;
                    &lt;ColumnDefinition Width="Auto"/&gt;
                &lt;/Grid.ColumnDefinitions&gt;
                
                &lt;TextBlock Grid.Column="0" 
                          Name="StatusText"
                          Text="Ready - Select a network to edit or create a new one"
                          Foreground="#FF00FF00" 
                          VerticalAlignment="Center" 
                          Margin="15,0"/&gt;
                
                &lt;StackPanel Grid.Column="1" Orientation="Horizontal" Margin="15,0"&gt;
                    &lt;TextBlock Text="Total Networks: " Foreground="White" VerticalAlignment="Center"/&gt;
                    &lt;TextBlock Name="TotalNetworksText" Text="0" Foreground="#FF00FF00" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,15,0"/&gt;
                    &lt;TextBlock Text="Active: " Foreground="White" VerticalAlignment="Center"/&gt;
                    &lt;TextBlock Name="ActiveNetworksText" Text="0" Foreground="#FF00FF00" FontWeight="Bold" VerticalAlignment="Center"/&gt;
                &lt;/StackPanel&gt;
            &lt;/Grid&gt;
        &lt;/Border&gt;
    &lt;/Grid&gt;
&lt;/Window&gt;
