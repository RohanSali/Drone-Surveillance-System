<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Icon Font - Using Segoe MDL2 Assets for modern Windows icons -->
    <FontFamily x:Key="SegoeIcons">Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="FluentIcons">Segoe Fluent Icons</FontFamily>

    <!-- Icon Characters as System.String resources -->
    <System:String x:Key="DroneIcon" xmlns:System="clr-namespace:System;assembly=mscorlib">&#xE7C8;</System:String>
    <System:String x:Key="PlayIcon" xmlns:System="clr-namespace:System;assembly=mscorlib">&#xE768;</System:String>
    <System:String x:Key="StopIcon" xmlns:System="clr-namespace:System;assembly=mscorlib">&#xE71A;</System:String>
    <System:String x:Key="SettingsIcon" xmlns:System="clr-namespace:System;assembly=mscorlib">&#xE713;</System:String>
    <System:String x:Key="NetworkIcon" xmlns:System="clr-namespace:System;assembly=mscorlib">&#xE968;</System:String>
    <System:String x:Key="MapIcon" xmlns:System="clr-namespace:System;assembly=mscorlib">&#xE707;</System:String>

    <!-- Icon Styles -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
        <Setter Property="FontFamily" Value="{StaticResource SegoeIcons}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style x:Key="IconButtonLarge" TargetType="Button" BasedOn="{StaticResource ModernButton}">
        <Setter Property="FontFamily" Value="{StaticResource SegoeIcons}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="Width" Value="60"/>
        <Setter Property="Height" Value="60"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- Status Icon Templates -->
    <DataTemplate x:Key="StatusIconTemplate">
        <Grid>
            <Ellipse Width="24" Height="24" Fill="{Binding StatusColor}"/>
            <TextBlock Text="{Binding StatusIcon}" 
                       FontFamily="{StaticResource SegoeIcons}" 
                       FontSize="12" 
                       Foreground="White" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"/>
        </Grid>
    </DataTemplate>

    <!-- Navigation Icon Style -->
    <Style x:Key="NavIcon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SegoeIcons}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- Small Icon Style -->
    <Style x:Key="SmallIcon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SegoeIcons}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Animated Icon Styles -->
    <Style x:Key="SpinIcon" TargetType="TextBlock" BasedOn="{StaticResource NavIcon}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                           From="0" To="360" Duration="0:0:2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
            </DataTrigger>
        </Style.Triggers>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <RotateTransform/>
            </Setter.Value>
        </Setter>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
    </Style>

</ResourceDictionary>
