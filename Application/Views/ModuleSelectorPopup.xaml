<Window x:Class="DroneSurveillanceSystem.Views.ModuleSelectorPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Module Selector - Drone Surveillance System" Height="500" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#0a0a0a"
        FontFamily="Segoe UI"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#0078d4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        
        <Style x:Key="ModuleButton" TargetType="Button">
            <Setter Property="Background" Value="#2d2d2d"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="MinHeight" Value="80"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="#2d2d2d" Grid.Row="0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="🔧" FontSize="24" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <TextBlock Text="Module Selector" 
                              Foreground="White" 
                              FontWeight="Bold" 
                              FontSize="20" 
                              VerticalAlignment="Center"/>
                    <TextBlock Text="Select modules to configure for your surveillance operation" 
                              Foreground="#ccc" 
                              FontSize="14" 
                              VerticalAlignment="Center"
                              Margin="20,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Module Selection Grid -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- AI Detection Module -->
            <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource ModuleButton}">
                <StackPanel>
                    <TextBlock Text="🤖" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="AI Detection Module" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <TextBlock Text="Advanced AI-powered object and anomaly detection" 
                              FontSize="12" 
                              Foreground="#ccc" 
                              TextWrapping="Wrap" 
                              HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Camera Control Module -->
            <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource ModuleButton}">
                <StackPanel>
                    <TextBlock Text="📷" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Camera Control Module" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <TextBlock Text="High-resolution camera controls and image capture" 
                              FontSize="12" 
                              Foreground="#ccc" 
                              TextWrapping="Wrap" 
                              HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- GPS Navigation Module -->
            <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource ModuleButton}">
                <StackPanel>
                    <TextBlock Text="🗺️" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="GPS Navigation Module" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <TextBlock Text="Precise GPS tracking and autonomous navigation" 
                              FontSize="12" 
                              Foreground="#ccc" 
                              TextWrapping="Wrap" 
                              HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Emergency Response Module -->
            <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource ModuleButton}">
                <StackPanel>
                    <TextBlock Text="🚨" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Emergency Response Module" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <TextBlock Text="Automated emergency detection and response protocols" 
                              FontSize="12" 
                              Foreground="#ccc" 
                              TextWrapping="Wrap" 
                              HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Footer Buttons -->
        <Border Background="#2d2d2d" Grid.Row="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="20,0">
                <Button Name="CancelButton" 
                       Content="Cancel" 
                       Style="{StaticResource DarkButton}" 
                       Click="CancelButton_Click"
                       Background="#666"/>
                <Button Content="Apply Configuration" 
                       Style="{StaticResource DarkButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
