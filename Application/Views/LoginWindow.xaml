<Window x:Class="DroneSurveillanceSystem.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="700" Width="1000"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#1A1A1A"
        WindowState="Maximized">

    <Window.Resources>
        <!-- Color Resources - Grey Futuristic Theme -->
        <Color x:Key="DarkGreyColor">#2D2D30</Color>
        <Color x:Key="MediumGreyColor">#1E1E1E</Color>  
        <Color x:Key="LightGreyColor">#3E3E42</Color>
        <Color x:Key="AccentBlueColor">#007ACC</Color>
        <Color x:Key="NeonBlueColor">#00B4D8</Color>
        <Color x:Key="TextColor">#E1E1E1</Color>
        <Color x:Key="MutedTextColor">#9E9E9E</Color>
        
        <!-- Brush Resources -->
        <SolidColorBrush x:Key="DarkGreyBrush" Color="{StaticResource DarkGreyColor}"/>
        <SolidColorBrush x:Key="MediumGreyBrush" Color="{StaticResource MediumGreyColor}"/>
        <SolidColorBrush x:Key="LightGreyBrush" Color="{StaticResource LightGreyColor}"/>
        <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlueColor}"/>
        <SolidColorBrush x:Key="NeonBlueBrush" Color="{StaticResource NeonBlueColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}"/>
        
        <!-- Text Styles -->
        <Style x:Key="TitleTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        
        <Style x:Key="SubtitleTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="0,10,0,30"/>
        </Style>
        
        <!-- Shared Button Style -->
        <Style x:Key="FuturisticButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="55"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="10" Color="{StaticResource NeonBlueColor}" Opacity="0.6"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Logo Style -->
        <Style x:Key="LogoContainerStyle" TargetType="Border">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="120"/>
            <Setter Property="Background" Value="{StaticResource MediumGreyBrush}"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" Color="{StaticResource NeonBlueColor}" Opacity="0.3" ShadowDepth="0"/>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Feature Indicator Style -->
        <Style x:Key="FeatureIndicatorStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Fill" Value="{StaticResource NeonBlueBrush}"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="5" Color="{StaticResource NeonBlueColor}" Opacity="0.7" ShadowDepth="0"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="1.8*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Left Panel - Branding and Information -->
        <Border Grid.Column="0" Background="{StaticResource MediumGreyBrush}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40">
                <!-- Application Logo -->
                <Grid>
                    <!-- Try to load the actual logo -->
                    <Image Source="pack://Application:,,,/Images/logo.png" 
                           Height="150" Width="150" Margin="0,0,0,0"
                           HorizontalAlignment="Center"
                           Visibility="Visible" x:Name="LogoImage"/>
                    
                    <!-- Fallback logo in case image is not available -->
                    <Border Style="{StaticResource LogoContainerStyle}" Margin="0,0,0,30"
                            Visibility="Collapsed" x:Name="FallbackLogo">
                        <Viewbox Stretch="Uniform" Width="60" Height="60">
                            <Canvas Width="24" Height="24">
                                <!-- Drone icon as fallback -->
                                <Path Data="M12,2 L15,5 L12,8 L9,5 Z M5,9 L8,12 L5,15 L2,12 Z M19,9 L22,12 L19,15 L16,12 Z M12,16 L15,19 L12,22 L9,19 Z" 
                                      Fill="{StaticResource NeonBlueBrush}"/>
                                <Ellipse Canvas.Left="10" Canvas.Top="10" Width="4" Height="4" Fill="{StaticResource TextBrush}"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                </Grid>
                
                <TextBlock Text="VIRA" 
                           Style="{StaticResource TitleTextStyle}"
                           FontSize="36" Margin="0,0,0,10"/>

                <TextBlock Text="VIGILANCE AND RAPID ALERTS" 
                           Style="{StaticResource TitleTextStyle}"
                           FontSize="26" Margin="0,0,0,10"/>
                
                <TextBlock Text="DRONE SURVEILLANCE SYSTEM" 
                           Style="{StaticResource TitleTextStyle}"
                           FontSize="18" Foreground="{StaticResource NeonBlueBrush}" Margin="0,0,0,30"/>
                
                <TextBlock Text="Advanced aerial monitoring and threat detection system for enhanced security operations."
                           Style="{StaticResource SubtitleTextStyle}"
                           TextWrapping="Wrap" MaxWidth="350"/>
                
                <!-- Feature List -->
                <StackPanel Margin="0,30,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <Ellipse Style="{StaticResource FeatureIndicatorStyle}"/>
                        <TextBlock Text="Real-time drone monitoring" Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <Ellipse Style="{StaticResource FeatureIndicatorStyle}"/>
                        <TextBlock Text="Automated threat detection" Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <Ellipse Style="{StaticResource FeatureIndicatorStyle}"/>
                        <TextBlock Text="Instant alert system" Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Style="{StaticResource FeatureIndicatorStyle}"/>
                        <TextBlock Text="Secure access control" Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
        
        
        <!-- Right Panel - Login Options -->
        <Grid Grid.Column="2" Background="{StaticResource DarkGreyBrush}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="380">
                <TextBlock Text="SECURE ACCESS" 
                           Style="{StaticResource TitleTextStyle}"
                           FontSize="24" Margin="0,0,0,5"
                           Foreground="{StaticResource NeonBlueBrush}"/>
                
                <TextBlock Text="Welcome to VIRA System" 
                           Style="{StaticResource TitleTextStyle}"
                           FontSize="32" Margin="0,0,0,10"/>
                
                <TextBlock Text="Sign in to access the surveillance dashboard" 
                           Style="{StaticResource SubtitleTextStyle}"/>
                
                <!-- Login Buttons -->
                <StackPanel Margin="0,30,0,0">
                    <!-- Microsoft -->
                    <Button x:Name="MicrosoftSignInButton"
                            Content="Continue with Microsoft"
                            Style="{StaticResource FuturisticButton}"
                            Click="MicrosoftSignInButton_Click"
                            Height="50">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2F2F2F" Offset="0.0"/>
                                <GradientStop Color="#1A1A1A" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="5" Color="{StaticResource NeonBlueColor}" Opacity="0.4" ShadowDepth="0"/>
                        </Button.Effect>
                    </Button>

                    <!-- Gmail -->
                    <Button x:Name="GmailSignInButton"
                            Content="Continue with Gmail"
                            Style="{StaticResource FuturisticButton}"
                            Click="GmailSignInButton_Click"
                            Height="50">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2F2F2F" Offset="0.0"/>
                                <GradientStop Color="#1A1A1A" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="5" Color="{StaticResource NeonBlueColor}" Opacity="0.4" ShadowDepth="0"/>
                        </Button.Effect>
                    </Button>

                    <!-- Guest -->
                    <Button x:Name="GuestButton"
                            Content="Continue as Guest"
                            Style="{StaticResource FuturisticButton}"
                            Click="GuestButton_Click"
                            Height="50">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2F2F2F" Offset="0.0"/>
                                <GradientStop Color="#1A1A1A" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="5" Color="{StaticResource NeonBlueColor}" Opacity="0.4" ShadowDepth="0"/>
                        </Button.Effect>
                    </Button>
                </StackPanel>
                
                <!-- Security Note -->
                <Border CornerRadius="6" Background="#252526" Margin="0,40,0,30" Padding="15">
                    <StackPanel>
                        <TextBlock Text="🔒 SECURE CONNECTION" 
                               Foreground="{StaticResource NeonBlueBrush}"
                               FontSize="13"
                               FontWeight="Bold"
                               Margin="0,0,0,5"/>
                        <TextBlock Text="All authentication methods use end-to-end encryption and comply with industry security standards."
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>
                    </StackPanel>
                </Border>
                
                <!-- Footer -->
                <TextBlock Text="© 2025 Vigilance and Rapid Alerts (VIRA)" 
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="14"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>