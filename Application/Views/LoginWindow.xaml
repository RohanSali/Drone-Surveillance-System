<Window x:Class="DroneSurveillanceSystem.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Drone Surveillance System - Sign In"
        Height="700" Width="600"
        MinHeight="600" MinWidth="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#1a1a1a"
        WindowState="Maximized">
    
    <Grid Margin="50">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,20,0,40">
            <Border Background="#2d2d2d" CornerRadius="30" Padding="30" Margin="0,0,0,30">
                <Grid>
                    <Ellipse Fill="#1a1a1a" Width="120" Height="120"/>
                    <TextBlock Text="🚁" FontSize="80" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                </Grid>
            </Border>
            <TextBlock Text="Drone Surveillance System" 
                       Foreground="White" 
                       FontWeight="Bold" 
                       FontSize="36" 
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Sign in to continue" 
                       Foreground="#ccc" 
                       FontSize="18" 
                       HorizontalAlignment="Center" 
                       Margin="0,10,0,0"/>
        </StackPanel>

        <!-- Main Content -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,40" MaxWidth="500">
            <TextBlock Text="Welcome to the Drone Surveillance System" 
                       Foreground="White" 
                       FontSize="20" 
                       HorizontalAlignment="Center" 
                       TextWrapping="Wrap" 
                       Margin="0,0,0,40"/>
            
            <Button x:Name="MicrosoftSignInButton" 
                    Content="🔐 Sign in with Microsoft Account" 
                    Style="{StaticResource BlueButton}"
                    Height="60" 
                    FontSize="16"
                    FontWeight="SemiBold"
                    Margin="0,0,0,15"
                    Click="MicrosoftSignInButton_Click"/>
            
            <Button x:Name="GmailSignInButton" 
                    Content="📧 Sign in with Gmail Account" 
                    Style="{StaticResource GmailButton}"
                    Height="60" 
                    FontSize="16"
                    FontWeight="SemiBold"
                    Margin="0,0,0,20"
                    Click="GmailSignInButton_Click"/>
            
            <Button x:Name="GuestButton" 
                    Content="👤 Continue as Guest" 
                    Style="{StaticResource ModernButton}"
                    Height="60" 
                    FontSize="16"
                    FontWeight="SemiBold"
                    Margin="0,0,0,30"
                    Click="GuestButton_Click"/>
            
            <TextBlock Text="Sign in with your Microsoft account to access all features and sync your data across devices." 
                       Foreground="#999" 
                       FontSize="14" 
                       HorizontalAlignment="Center" 
                       TextWrapping="Wrap" 
                       Margin="0,20,0,0"/>
        </StackPanel>

        <!-- Footer -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,30,0,20">
            <TextBlock Text="© 2024 Drone Surveillance System" 
                       Foreground="#666" 
                       FontSize="12" 
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
