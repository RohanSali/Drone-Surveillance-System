<Window x:Class="DroneSurveillanceSystem.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Settings" Height="800" Width="1200"
        WindowStartupLocation="CenterOwner"
        WindowState="Normal"
        ResizeMode="CanResize"
        MinHeight="600" MinWidth="1000"
        Background="#1A1A1A">

    <Window.Resources>
        <!-- Color Resources -->
        <Color x:Key="DarkBackground">#1A1A1A</Color>
        <Color x:Key="MediumBackground">#2D2D2D</Color>
        <Color x:Key="LightBackground">#404040</Color>
        <Color x:Key="AccentBlue">#0078d4</Color>
        <Color x:Key="AccentGreen">#28a745</Color>
        <Color x:Key="AccentPurple">#8B5CF6</Color>
        <Color x:Key="TextPrimary">#FFFFFF</Color>
        <Color x:Key="TextSecondary">#CCCCCC</Color>
        
        <SolidColorBrush x:Key="DarkBackgroundBrush" Color="{StaticResource DarkBackground}"/>
        <SolidColorBrush x:Key="MediumBackgroundBrush" Color="{StaticResource MediumBackground}"/>
        <SolidColorBrush x:Key="LightBackgroundBrush" Color="{StaticResource LightBackground}"/>
        <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlue}"/>
        <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource AccentGreen}"/>
        <SolidColorBrush x:Key="AccentPurpleBrush" Color="{StaticResource AccentPurple}"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>

        <!-- Button Styles -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"
                                            Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#106EBE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#666666"/>
                                <Setter Property="Foreground" Value="#cccccc"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource LightBackgroundBrush}"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#dc3545"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#bd2130"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Text Styles -->
        <Style x:Key="SettingsLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,8,0,5"/>
        </Style>
        
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="SubSectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Input Control Styles -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource MediumBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LightBackgroundBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="MinWidth" Value="180"/>
            <Setter Property="Height" Value="36"/>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource MediumBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LightBackgroundBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="MinWidth" Value="180"/>
            <Setter Property="Height" Value="36"/>
        </Style>

        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource LightBackgroundBrush}"/>
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Card Style -->
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource MediumBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LightBackgroundBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="DeviceCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource MediumBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LightBackgroundBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource MediumBackgroundBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚙️" FontSize="28" VerticalAlignment="Center" Margin="0,0,15,0" Foreground="{StaticResource AccentBlueBrush}"/>
                    <TextBlock Text="Settings" 
                              Foreground="{StaticResource TextPrimaryBrush}" 
                              FontSize="24" 
                              FontWeight="Bold" 
                              VerticalAlignment="Center"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="12" Height="12" Fill="Green" Margin="0,0,8,0"/>
                    <TextBlock Text="Settings Active" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column - Profile Section -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <!-- User Profile -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <TextBlock Text="👤" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource AccentPurpleBrush}"/>
                                <TextBlock Text="User Profile" Style="{StaticResource SectionHeader}"/>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Profile Avatar -->
                                <Border Grid.Column="0" Width="60" Height="60" Background="{StaticResource AccentPurpleBrush}" CornerRadius="30" Margin="0,0,15,0">
                                    <TextBlock Text="RS" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                
                                <!-- Profile Info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Rahul Singh" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Text="rahul.singh@example.com" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" Margin="0,2,0,0"/>
                                    <TextBlock Text="Administrator" Foreground="{StaticResource AccentGreenBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Action Buttons -->
                            <StackPanel Orientation="Horizontal" Margin="0,20,0,0" HorizontalAlignment="Center">
                                <Button Content="🚪 Sign Out" Style="{StaticResource DangerButton}" MinWidth="120"/>
                                <Button Content="🔄 Switch Account" Style="{StaticResource SecondaryButton}" MinWidth="140" Margin="10,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- System Information -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <TextBlock Text="ℹ️" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource AccentBlueBrush}"/>
                                <TextBlock Text="System Information" Style="{StaticResource SectionHeader}"/>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Version:" Style="{StaticResource SettingsLabel}" Margin="0,0,15,0"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="v2.1.0" Style="{StaticResource SettingsLabel}" Foreground="{StaticResource TextSecondaryBrush}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Database:" Style="{StaticResource SettingsLabel}" Margin="0,0,15,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="SQLite 3.35" Style="{StaticResource SettingsLabel}" Foreground="{StaticResource TextSecondaryBrush}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="AI Framework:" Style="{StaticResource SettingsLabel}" Margin="0,0,15,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="TensorFlow 2.8" Style="{StaticResource SettingsLabel}" Foreground="{StaticResource TextSecondaryBrush}"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Last Updated:" Style="{StaticResource SettingsLabel}" Margin="0,0,15,0"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="2024-01-15" Style="{StaticResource SettingsLabel}" Foreground="{StaticResource TextSecondaryBrush}"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Data Path:" Style="{StaticResource SettingsLabel}" Margin="0,0,15,0"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="DataPathLabel" Text="~/AppData/DroneSurveillance" Style="{StaticResource SettingsLabel}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Column - Device Configuration -->
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <!-- Device Configuration Header -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <TextBlock Text="📱" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource AccentBlueBrush}"/>
                                <TextBlock Text="Device Configuration" Style="{StaticResource SectionHeader}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Horizontal Device Layout -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Drone Configuration -->
                        <Border Grid.Column="0" Style="{StaticResource DeviceCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="🚁" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource AccentBlueBrush}"/>
                                    <TextBlock Text="Drone Configuration" Style="{StaticResource SubSectionHeader}"/>
                                </StackPanel>
                                
                                <TextBlock Text="Drone Name:" Style="{StaticResource SettingsLabel}"/>
                                <TextBox x:Name="DroneNameTextBox" Text="DJI Mavic 3" Style="{StaticResource ModernTextBox}"/>
                                
                                <TextBlock Text="Drone ID:" Style="{StaticResource SettingsLabel}"/>
                                <TextBox x:Name="DroneIdTextBox" Text="DRN-001-2024" Style="{StaticResource ModernTextBox}"/>
                                
                                <TextBlock Text="Bluetooth ID:" Style="{StaticResource SettingsLabel}"/>
                                <TextBox x:Name="BluetoothIdTextBox" Text="BT-00:1A:7D:DA:71:13" Style="{StaticResource ModernTextBox}"/>
                                
                                <TextBlock Text="MAC Address:" Style="{StaticResource SettingsLabel}"/>
                                <TextBox x:Name="MacAddressTextBox" Text="00:1A:7D:DA:71:13" Style="{StaticResource ModernTextBox}"/>
                                
                                <TextBlock Text="Alert Handling:" Style="{StaticResource SettingsLabel}"/>
                                <ComboBox x:Name="DroneAlertComboBox" Style="{StaticResource ModernComboBox}" SelectedIndex="0">
                                    <ComboBoxItem Content="Auto-Handle Alerts"/>
                                    <ComboBoxItem Content="Manual Confirmation"/>
                                    <ComboBoxItem Content="Notify Only"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- CCTV Configuration -->
                        <Border Grid.Column="1" Style="{StaticResource DeviceCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="📷" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource AccentBlueBrush}"/>
                                    <TextBlock Text="CCTV Configuration" Style="{StaticResource SubSectionHeader}"/>
                                </StackPanel>
                                
                                <TextBlock Text="CCTV Name:" Style="{StaticResource SettingsLabel}"/>
                                <TextBox x:Name="CctvNameTextBox" Text="Axis P1447" Style="{StaticResource ModernTextBox}"/>
                                
                                <TextBlock Text="CCTV ID:" Style="{StaticResource SettingsLabel}"/>
                                <TextBox x:Name="CctvIdTextBox" Text="CCTV-001-2024" Style="{StaticResource ModernTextBox}"/>
                                
                                <TextBlock Text="Bluetooth ID:" Style="{StaticResource SettingsLabel}"/>
                                <TextBox x:Name="CctvBluetoothIdTextBox" Text="BT-00:1B:7E:DB:72:14" Style="{StaticResource ModernTextBox}"/>
                                
                                <TextBlock Text="MAC Address:" Style="{StaticResource SettingsLabel}"/>
                                <TextBox x:Name="CctvMacAddressTextBox" Text="00:1B:7E:DB:72:14" Style="{StaticResource ModernTextBox}"/>
                                
                                <TextBlock Text="Alert Handling:" Style="{StaticResource SettingsLabel}"/>
                                <ComboBox x:Name="CctvAlertComboBox" Style="{StaticResource ModernComboBox}" SelectedIndex="0">
                                    <ComboBoxItem Content="Auto-Handle Alerts"/>
                                    <ComboBoxItem Content="Manual Confirmation"/>
                                    <ComboBoxItem Content="Notify Only"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button x:Name="ResetButton" Content="🔄 Reset" Style="{StaticResource SecondaryButton}" MinWidth="100"/>
                        <Button x:Name="CancelButton" Content="❌ Cancel" Style="{StaticResource SecondaryButton}" MinWidth="100" Margin="10,0,0,0"/>
                        <Button x:Name="SaveButton" Content="💾 Save" Style="{StaticResource PrimaryButton}" MinWidth="100" Margin="10,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>