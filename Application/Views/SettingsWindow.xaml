<Window x:Class="DroneSurveillanceSystem.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Surveillance System Settings" Height="500" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource DarkBackgroundBrush}">

    <Window.Resources>
        <Style x:Key="DarkButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
        </Style>
        
        <Style x:Key="SettingsLabel" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
        </Style>
        
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0078d4"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,15,0,10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="#2d2d2d" Padding="15" CornerRadius="8" Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚙️" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Surveillance System Settings" 
                          Foreground="White" 
                          FontSize="20" 
                          FontWeight="Bold" 
                          VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1" Margin="0,10,0,0">
            <StackPanel>
                <!-- AI Detection Settings -->
                <Border Background="#2d2d2d" Padding="15" CornerRadius="8" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="AI Detection Configuration" Style="{StaticResource SectionHeader}"/>
                        
                        <CheckBox x:Name="AiDetectionToggle" 
                                 Content="Enable AI Detection" 
                                 Foreground="White" 
                                 IsChecked="True" 
                                 Margin="0,5"/>
                        
                        <CheckBox x:Name="VoiceAlertsToggle" 
                                 Content="Enable Voice Alerts" 
                                 Foreground="White" 
                                 IsChecked="False" 
                                 Margin="0,5"/>
                        
                        <TextBlock Text="Detection Sensitivity:" Style="{StaticResource SettingsLabel}"/>
                        <Slider x:Name="SensitivitySlider" 
                               Minimum="1" 
                               Maximum="10" 
                               Value="5" 
                               Width="200" 
                               HorizontalAlignment="Left"/>
                        <TextBlock x:Name="SensitivityValue" 
                                  Text="Medium (5)" 
                                  Style="{StaticResource SettingsLabel}" 
                                  FontSize="12" 
                                  Foreground="#888"/>
                    </StackPanel>
                </Border>

                <!-- Camera Settings -->
                <Border Background="#2d2d2d" Padding="15" CornerRadius="8" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Camera Configuration" Style="{StaticResource SectionHeader}"/>
                        
                        <TextBlock Text="Default Camera Angle:" Style="{StaticResource SettingsLabel}"/>
                        <ComboBox x:Name="DefaultCameraCombo" 
                                 Width="200" 
                                 HorizontalAlignment="Left" 
                                 Background="#333" 
                                 Foreground="White">
                            <ComboBoxItem Content="Front View"/>
                            <ComboBoxItem Content="Side View"/>
                            <ComboBoxItem Content="Top View"/>
                            <ComboBoxItem Content="360° View" IsSelected="True"/>
                        </ComboBox>
                        
                        <TextBlock Text="Frame Rate (FPS):" Style="{StaticResource SettingsLabel}" Margin="0,10,0,5"/>
                        <ComboBox x:Name="FrameRateCombo" 
                                 Width="200" 
                                 HorizontalAlignment="Left" 
                                 Background="#333" 
                                 Foreground="White">
                            <ComboBoxItem Content="15 FPS"/>
                            <ComboBoxItem Content="24 FPS"/>
                            <ComboBoxItem Content="30 FPS" IsSelected="True"/>
                            <ComboBoxItem Content="60 FPS"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Drone Settings -->
                <Border Background="#2d2d2d" Padding="15" CornerRadius="8" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Drone Configuration" Style="{StaticResource SectionHeader}"/>
                        
                        <TextBlock Text="Active Drone ID:" Style="{StaticResource SettingsLabel}"/>
                        <TextBox x:Name="DroneIdTextBox" 
                                Text="Drone-001" 
                                Width="200" 
                                HorizontalAlignment="Left" 
                                Background="#333" 
                                Foreground="White" 
                                BorderBrush="#555"/>
                        
                        <TextBlock Text="Flight Altitude (meters):" Style="{StaticResource SettingsLabel}" Margin="0,10,0,5"/>
                        <Slider x:Name="AltitudeSlider" 
                               Minimum="10" 
                               Maximum="200" 
                               Value="50" 
                               Width="200" 
                               HorizontalAlignment="Left"/>
                        <TextBlock x:Name="AltitudeValue" 
                                  Text="50 meters" 
                                  Style="{StaticResource SettingsLabel}" 
                                  FontSize="12" 
                                  Foreground="#888"/>
                    </StackPanel>
                </Border>

                <!-- Data Management -->
                <Border Background="#2d2d2d" Padding="15" CornerRadius="8" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Data Management" Style="{StaticResource SectionHeader}"/>
                        
                        <CheckBox x:Name="AutoSaveToggle" 
                                 Content="Auto-save detection logs" 
                                 Foreground="White" 
                                 IsChecked="True" 
                                 Margin="0,5"/>
                        
                        <TextBlock Text="Log Retention (days):" Style="{StaticResource SettingsLabel}" Margin="0,10,0,5"/>
                        <ComboBox x:Name="RetentionCombo" 
                                 Width="200" 
                                 HorizontalAlignment="Left" 
                                 Background="#333" 
                                 Foreground="White">
                            <ComboBoxItem Content="7 days"/>
                            <ComboBoxItem Content="30 days" IsSelected="True"/>
                            <ComboBoxItem Content="90 days"/>
                            <ComboBoxItem Content="1 year"/>
                            <ComboBoxItem Content="Unlimited"/>
                        </ComboBox>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                            <Button x:Name="ExportDataButton" 
                                   Content="Export Data" 
                                   Style="{StaticResource DarkButton}" 
                                   Click="ExportDataButton_Click"/>
                            <Button x:Name="ClearLogsButton" 
                                   Content="Clear Logs" 
                                   Style="{StaticResource DarkButton}" 
                                   Background="#dc3545"
                                   Click="ClearLogsButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- System Information -->
                <Border Background="#2d2d2d" Padding="15" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="System Information" Style="{StaticResource SectionHeader}"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Version:" Style="{StaticResource SettingsLabel}" Margin="0,0,10,0"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="1.0.0" Style="{StaticResource SettingsLabel}" Foreground="#888"/>
                            
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Database:" Style="{StaticResource SettingsLabel}" Margin="0,0,10,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="SQLite 3.0" Style="{StaticResource SettingsLabel}" Foreground="#888"/>
                            
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="AI Framework:" Style="{StaticResource SettingsLabel}" Margin="0,0,10,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Simulation Mode" Style="{StaticResource SettingsLabel}" Foreground="#888"/>
                            
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Data Path:" Style="{StaticResource SettingsLabel}" Margin="0,0,10,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DataPathLabel" Text="~/AppData/DroneSurveillance" Style="{StaticResource SettingsLabel}" Foreground="#888"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Button Panel -->
        <Border Grid.Row="2" Background="#2d2d2d" Padding="15" CornerRadius="8" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ResetButton" 
                       Content="Reset to Defaults" 
                       Style="{StaticResource DarkButton}" 
                       Background="#6c757d"
                       Click="ResetButton_Click"/>
                <Button x:Name="SaveButton" 
                       Content="Save Settings" 
                       Style="{StaticResource DarkButton}" 
                       Click="SaveButton_Click"/>
                <Button x:Name="CancelButton" 
                       Content="Cancel" 
                       Style="{StaticResource DarkButton}" 
                       Background="#6c757d"
                       Click="CancelButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
