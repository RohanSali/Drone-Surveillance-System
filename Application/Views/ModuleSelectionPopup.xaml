<Window x:Class="DroneSurveillanceSystem.Views.ModuleSelectionPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Module Selection" Height="650" Width="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="ToolWindow"
        Background="#0a0a0a"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#0078d4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="DarkCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="5 0"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="#2d2d2d" Grid.Row="0">
            <TextBlock Text="Select Modules to Add to Drone" 
                       Foreground="White" 
                       FontWeight="Bold" 
                       FontSize="18" 
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Center"
                       Margin="10"/>
        </Border>

        <!-- Module List -->
        <ScrollViewer Grid.Row="1" Margin="20">
            <Border Background="#1a1a1a" CornerRadius="8" Padding="20">
                <StackPanel>
                    <TextBlock Text="📦 Available Modules for Installation" 
                              Foreground="White" 
                              FontWeight="Bold" 
                              FontSize="16" 
                              Margin="0,0,0,20"/>
                    
                    <!-- Camera & Vision Modules -->
                    <TextBlock Text="📸 Camera &amp; Vision" Foreground="#0078d4" FontWeight="Bold" FontSize="14" Margin="0,10,0,5"/>
                    <CheckBox Content="📷 HD Camera Module - High-definition video recording" Style="{StaticResource DarkCheckBox}" Margin="20,0,0,5"/>
                    <CheckBox Content="🔥 Thermal Imaging Module - Heat signature detection" Style="{StaticResource DarkCheckBox}" Margin="20,0,0,5"/>
                    <CheckBox Content="🌙 Night Vision Module - Low-light operations" Style="{StaticResource DarkCheckBox}" Margin="20,0,0,5"/>
                    <CheckBox Content="🔍 Zoom Camera Module - Long-range surveillance" Style="{StaticResource DarkCheckBox}" Margin="20,0,0,5"/>
                    
                    <!-- Navigation & Positioning -->
                    <TextBlock Text="🗺️ Navigation &amp; Positioning" Foreground="#28a745" FontWeight="Bold" FontSize="14" Margin="0,15,0,5"/>
                    <CheckBox Content="🛰️ GPS Module - Precise location tracking" Style="{StaticResource DarkCheckBox}" Margin="20,0,0,5"/>
                    <CheckBox Content="🧭 Compass Module - Magnetic navigation" Style="{StaticResource DarkCheckBox}" Margin="20,0,0,5"/>
                    <CheckBox Content="📏 Altimeter Module - Altitude measurement" Style="{StaticResource DarkCheckBox}" Margin="20,0,0,5"/>
                    <CheckBox Content="🚧 Obstacle Avoidance Module - Collision prevention" Style="{StaticResource DarkCheckBox}" Margin="20,0,0,5"/>
                    
                    <!-- Communication & Data -->
                    <TextBlock Text="📡 Communication &amp; Data" Foreground="#dc3545" FontWeight="Bold" FontSize="14" Margin="0,15,0,5"/>
                    <CheckBox Content="📻 Communication Module - Real-time data transmission" Style="{StaticResource DarkCheckBox}" Margin="20,0,0,5"/>
                    <CheckBox Content="📊 Data Storage Module - Extended memory capacity" Style="{StaticResource DarkCheckBox}" Margin="20,0,0,5"/>
                    <CheckBox Content="📶 WiFi Module - Wireless connectivity" Style="{StaticResource DarkCheckBox}" Margin="20,0,0,5"/>
                    <CheckBox Content="📱 Cellular Module - 4G/5G connectivity" Style="{StaticResource DarkCheckBox}" Margin="20,0,0,5"/>
                    
                    <!-- Sensors & Detection -->
                    <TextBlock Text="🔬 Sensors &amp; Detection" Foreground="#ffc107" FontWeight="Bold" FontSize="14" Margin="0,15,0,5"/>
                    <CheckBox Content="🌡️ Weather Sensor - Environmental monitoring" Style="{StaticResource DarkCheckBox}" Margin="20,0,0,5"/>
                    <CheckBox Content="💨 Air Quality Sensor - Pollution detection" Style="{StaticResource DarkCheckBox}" Margin="20,0,0,5"/>
                    <CheckBox Content="🔊 Audio Sensor - Sound detection &amp; recording" Style="{StaticResource DarkCheckBox}" Margin="20,0,0,5"/>
                    <CheckBox Content="⚡ Motion Sensor - Movement detection" Style="{StaticResource DarkCheckBox}" Margin="20,0,0,5"/>
                    
                    <!-- Power & Performance -->
                    <TextBlock Text="🔋 Power &amp; Performance" Foreground="#6f42c1" FontWeight="Bold" FontSize="14" Margin="0,15,0,5"/>
                    <CheckBox Content="🔋 Extended Battery Module - Longer flight time" Style="{StaticResource DarkCheckBox}" Margin="20,0,0,5"/>
                    <CheckBox Content="⚡ Solar Panel Module - Solar charging capability" Style="{StaticResource DarkCheckBox}" Margin="20,0,0,5"/>
                    <CheckBox Content="🚀 Performance Booster - Enhanced flight capabilities" Style="{StaticResource DarkCheckBox}" Margin="20,0,0,5"/>
                    <CheckBox Content="❄️ Cooling System - Temperature regulation" Style="{StaticResource DarkCheckBox}" Margin="20,0,0,5"/>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Footer -->
        <Border Background="#2d2d2d" Grid.Row="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Content="Add Selected Modules" Style="{StaticResource DarkButton}" Click="AddModulesButton_Click" />
                <Button Content="Cancel" Style="{StaticResource DarkButton}" Click="CancelButton_Click" />
            </StackPanel>
        </Border>

    </Grid>
</Window>
