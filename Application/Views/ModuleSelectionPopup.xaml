<Window x:Class="DroneSurveillanceSystem.Views.ModuleSelectionPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Module Selection" Width="500" Height="400" Background="#0a0a0a" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="Select Modules to Add to Drone" 
                   Foreground="#FF5252" FontWeight="Bold" FontSize="20" 
                   HorizontalAlignment="Center" Margin="0,16,0,12" Grid.Row="0"/>

        <!-- Main Card -->
        <Border Grid.Row="1" Background="#1a1a1a" CornerRadius="12" Padding="20" Margin="10">
            <StackPanel>
                <TextBlock Text="Available Modules for Installation" FontWeight="Bold" FontSize="16" Foreground="White" Margin="0,0,0,20"/>
                <CheckBox Content="Casuality inference Module" x:Name="CasualityModuleCheckBox" Margin="0,0,0,10" Foreground="White" FontWeight="Bold" FontSize="15"/>
                <CheckBox Content="Anamoly inference Module" x:Name="AnamolyModuleCheckBox" Margin="0,0,0,10" Foreground="White" FontWeight="Bold" FontSize="15"/>
                <CheckBox Content="Crowd Detection Module" x:Name="CrowdDetectionModuleCheckBox" Margin="0,0,0,10" Foreground="White" FontWeight="Bold" FontSize="15"/>
                <CheckBox Content="Lost Finding Module" x:Name="LostFindingModuleCheckBox" Margin="0,0,0,10" Foreground="White" FontWeight="Bold" FontSize="15"/>
            </StackPanel>
        </Border>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,10,0,10">
            <Button Content="Back" Click="BackButton_Click" Width="80" Margin="0,0,10,0" Background="#FF5252" Foreground="White" FontWeight="Bold"/>
            <Button Content="Add Selected Modules" x:Name="AddModulesButton" Width="170" Margin="0,0,10,0" Background="#FF5252" Foreground="White" FontWeight="Bold"/>
            <Button Content="Cancel" x:Name="CancelButton" Width="80" Background="#444" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
