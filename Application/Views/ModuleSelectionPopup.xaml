<Window x:Class="DroneSurveillanceSystem.Views.ModuleSelectionPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Module Selection" Width="720" Height="520" Background="#1A1A1A" WindowStartupLocation="CenterScreen" WindowStyle="None">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.Resources>
            <Style x:Key="ModernButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#FF5252"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Padding" Value="16,10"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="8"
                                    BorderBrush="#FF5252"
                                    BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF7F7F"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#E63E3E"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <!-- Header with Back on top-right -->
        <Grid Grid.Row="0" Margin="10,10,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Select Modules to Add to Drone" 
                       Foreground="#FF5252" FontWeight="Bold" FontSize="24" 
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Close" Click="BackButton_Click" 
                    Style="{StaticResource ModernButtonStyle}"
                    Margin="10,0,0,0"/>
        </Grid>

        <!-- Main Card -->
        <Border Grid.Row="1" Background="#1a1a1a" CornerRadius="12" Padding="24" Margin="12">
            <StackPanel>
                <TextBlock Text="Available Modules for Installation" FontWeight="Bold" FontSize="18" Foreground="White" Margin="0,0,0,20"/>
                <CheckBox Content="Casuality inference Module" x:Name="CasualityModuleCheckBox" Margin="0,0,0,12" Foreground="White" FontWeight="Bold" FontSize="16"/>
                <CheckBox Content="Anamoly inference Module" x:Name="AnamolyModuleCheckBox" Margin="0,0,0,12" Foreground="White" FontWeight="Bold" FontSize="16"/>
                <CheckBox Content="Crowd Detection Module" x:Name="CrowdDetectionModuleCheckBox" Margin="0,0,0,12" Foreground="White" FontWeight="Bold" FontSize="16"/>

            </StackPanel>
        </Border>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,12,12">
            <Button Content="Add Selected Modules" x:Name="AddModulesButton" Width="220" Style="{StaticResource ModernButtonStyle}" Click="AddModulesButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
