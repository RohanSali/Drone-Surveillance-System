<Window x:Class="DroneSurveillanceSystem.Views.NetworkDetailsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Network Details" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#0a0a0a"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,10"/>
        </Style>

        <Style x:Key="SubHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>

        <Style x:Key="DroneCard" TargetType="Border">
            <Setter Property="Background" Value="#2d2d2d"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#444"/>
        </Style>

        <Style x:Key="AlertCard" TargetType="Border">
            <Setter Property="Background" Value="#4a1a1a"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#ff4444"/>
        </Style>

        <Style x:Key="StatusIndicator" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2d2d2d" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🌐" FontSize="30" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock x:Name="NetworkNameText" 
                                  Text="Network Details" 
                                  Foreground="White" 
                                  FontWeight="Bold" 
                                  FontSize="24"/>
                        <TextBlock x:Name="NetworkDescriptionText" 
                                  Text="Network Description" 
                                  Foreground="#cccccc" 
                                  FontSize="14"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Status: " Foreground="#cccccc" FontSize="14"/>
                        <Ellipse x:Name="NetworkStatusIndicator" Style="{StaticResource StatusIndicator}" Fill="#4CAF50"/>
                        <TextBlock x:Name="NetworkStatusText" Text="Active" Foreground="#4CAF50" FontSize="14" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="2" 
                        Name="CloseButton" 
                        Content="✕ Close" 
                        Background="#dc3545" 
                        Foreground="White" 
                        BorderThickness="0" 
                        Padding="15,8" 
                        FontSize="14"
                        Click="CloseButton_Click"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Connected Drones -->
            <Border Grid.Column="0" Background="#1a1a1a" CornerRadius="12" Padding="20" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Drones Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="🚁" FontSize="20" Margin="0,0,10,0"/>
                        <TextBlock Text="Connected Drones" Style="{StaticResource HeaderText}"/>
                        <TextBlock x:Name="DroneCountText" Text="(4 Active)" Foreground="#4CAF50" FontSize="14" Margin="10,15,0,0"/>
                    </StackPanel>

                    <!-- Drones List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="DronesPanel">
                            <!-- Drone cards will be populated here -->
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Right Panel - Alerts and Network Info -->
            <Grid Grid.Column="1" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Network Summary -->
                <Border Grid.Row="0" Background="#1a1a1a" CornerRadius="12" Padding="20" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="📊" FontSize="20" Margin="0,0,10,0"/>
                            <TextBlock Text="Network Summary" Style="{StaticResource HeaderText}"/>
                        </StackPanel>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="5">
                                <TextBlock Text="Active Drones" Foreground="#cccccc" FontSize="10"/>
                                <TextBlock x:Name="ActiveDronesText" Text="4" Foreground="#4CAF50" FontSize="18" FontWeight="Bold"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="5">
                                <TextBlock Text="Total Alerts" Foreground="#cccccc" FontSize="10"/>
                                <TextBlock x:Name="TotalAlertsText" Text="2" Foreground="#FF9800" FontSize="18" FontWeight="Bold"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="5">
                                <TextBlock Text="Coverage Area" Foreground="#cccccc" FontSize="10"/>
                                <TextBlock x:Name="CoverageAreaText" Text="15.2 km²" Foreground="White" FontSize="18" FontWeight="Bold"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="5">
                                <TextBlock Text="Avg Battery" Foreground="#cccccc" FontSize="10"/>
                                <TextBlock x:Name="AvgBatteryText" Text="78%" Foreground="White" FontSize="18" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Active Alerts -->
                <Border Grid.Row="1" Background="#1a1a1a" CornerRadius="12" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Alerts Header -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="⚠️" FontSize="20" Margin="0,0,10,0"/>
                            <TextBlock Text="Active Alerts" Style="{StaticResource HeaderText}"/>
                        </StackPanel>

                        <!-- Alerts List -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="AlertsPanel">
                                <!-- Alert cards will be populated here -->
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#2d2d2d" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="📡" FontSize="16" Margin="0,0,8,0"/>
                    <TextBlock x:Name="FooterStatusText" 
                              Text="Network monitoring active - Real-time updates enabled" 
                              Foreground="#4CAF50" 
                              FontSize="12" 
                              VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Last Updated: " Foreground="#cccccc" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LastUpdatedText" 
                              Text="00:00:00" 
                              Foreground="White" 
                              FontSize="12" 
                              FontFamily="Consolas"
                              VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
