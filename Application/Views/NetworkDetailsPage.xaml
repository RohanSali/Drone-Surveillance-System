<UserControl x:Class="DroneSurveillanceSystem.Views.NetworkDetailsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Background="#0a0a0a"
        FontFamily="Segoe UI">

    <UserControl.Resources>
        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,10"/>
        </Style>

        <Style x:Key="SubHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>

        <Style x:Key="AlertCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#2a2a2a" />
            <Setter Property="BorderBrush" Value="#444" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="DataTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#b0b0b0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="4,2" />
        </Style>

        <Style x:Key="HiddenSmoothScrollViewer" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2d2d2d" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🌐" FontSize="30" Margin="0,0,10,0" x:Name="NetworkIcon" Foreground="#4CAF50"/>
                    <StackPanel>
                        <TextBlock x:Name="NetworkNameText" 
                                  Text="Network Details" 
                                  Foreground="White" 
                                  FontWeight="Bold" 
                                  FontSize="24"/>
                        <TextBlock x:Name="NetworkDescriptionText" 
                                  Text="Network Description" 
                                  Foreground="#cccccc" 
                                  FontSize="14"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Status: " Foreground="#cccccc" FontSize="14"/>
                        <Ellipse x:Name="NetworkStatusIndicator" Width="10" Height="10" Fill="#4CAF50" Margin="0,0,8,0"/>
                        <TextBlock x:Name="NetworkStatusText" Text="Active" Foreground="#4CAF50" FontSize="14" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="2" 
                        Name="CloseButton" 
                        Content="✕ Close" 
                        Background="#dc3545" 
                        Foreground="White" 
                        BorderThickness="0" 
                        Padding="15,8" 
                        FontSize="14"
                        Click="CloseButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
                                    CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" 
                                                VerticalAlignment="Center"
                                                Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#c82333"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#bd2130"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="35*"/>
                <RowDefinition Height="65*"/>
            </Grid.RowDefinitions>

            <!-- Left Panel - Devices (Drones and CCTVs) -->
            <Border Grid.Column="0" Grid.RowSpan="2" Background="#2a2a2a" CornerRadius="6" Padding="15" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock x:Name="DevicesTitle" Text="🚁📷 Network Devices" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF00BCD4" Offset="0"/>
                                <GradientStop Color="#FF2196F3" Offset="1"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                    
                    <!-- Dynamic Devices List -->
                    <ScrollViewer Style="{StaticResource HiddenSmoothScrollViewer}">
                        <ItemsControl ItemsSource="{Binding FilteredDevices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#333" CornerRadius="4" Padding="10" Margin="0,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding StatusColor}" Margin="0,0,10,0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock Text="{Binding Details}" Style="{StaticResource DataTextStyle}"/>
                                                <TextBlock Text="{Binding AdditionalInfo}" Style="{StaticResource DataTextStyle}"/>
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource DataTextStyle}"/>
                                                <TextBlock Text="{Binding BatteryText}" Style="{StaticResource DataTextStyle}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{Binding StatusColor}" FontSize="11" FontWeight="Bold"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- Network Summary Block - Moved to top right -->
            <Border Grid.Column="1" Grid.Row="0" Background="#2a2a2a" CornerRadius="6" Padding="15" Margin="10,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Summary Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="📊" FontSize="20" Margin="0,0,10,0" Foreground="#FF9800"/>
                        <TextBlock Text="Network Summary" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                    
                    <!-- Summary Metrics Grid -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Left Column -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <!-- Active Drones -->
                            <Border Background="#333" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Active Drones" Foreground="#cccccc" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding ActiveDronesCount}" Foreground="#4CAF50" FontSize="20" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Active CCTVs -->
                            <Border Background="#333" CornerRadius="6" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Active CCTVs" Foreground="#cccccc" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding ActiveCctvsCount}" Foreground="#4CAF50" FontSize="20" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        
                        <!-- Right Column -->
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <!-- Total Alerts -->
                            <Border Background="#333" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Total Alerts" Foreground="#cccccc" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding TotalAlertsCount}" Foreground="#FF9800" FontSize="20" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Total CCTVs -->
                            <Border Background="#333" CornerRadius="6" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Total CCTVs" Foreground="#cccccc" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding TotalCctvsCount}" Foreground="#FF9800" FontSize="20" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Right Panel - Alerts (Now larger with 7:3 ratio) -->
            <Border Grid.Column="1" Grid.Row="1" Background="#2a2a2a" CornerRadius="6" Padding="15" Margin="10,10,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="🚨 Active Alerts" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FFF44336" Offset="0"/>
                                <GradientStop Color="#FFE91E63" Offset="1"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                    
                    <ScrollViewer Grid.Row="1" Style="{StaticResource HiddenSmoothScrollViewer}">
                        <ItemsControl ItemsSource="{Binding FilteredAlerts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource AlertCardStyle}" Background="#3a2a2a" MouseLeftButtonDown="Alert_Click" Tag="{Binding Timestamp}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="🚨" FontSize="14" Margin="0,0,8,0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Alert}" Foreground="#E8A598" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock Text="{Binding DroneId}" Style="{StaticResource DataTextStyle}"/>
                                                <TextBlock Text="{Binding Timestamp}" Style="{StaticResource DataTextStyle}" FontSize="10"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Score, StringFormat=F2}" Foreground="#888" FontSize="10"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#1e1e1e" Padding="15,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Content="✅ Acknowledge All Alerts" 
                        Background="#28A745" 
                        Foreground="White" 
                        BorderThickness="0" 
                        Padding="20,12" 
                        FontSize="14"
                        FontWeight="Bold"
                        MinWidth="200"
                        Height="45"
                        Click="AcknowledgeAlerts_Click"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#218838"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#1E7E34"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>