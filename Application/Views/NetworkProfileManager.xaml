<Window x:Class="DroneSurveillanceSystem.Views.NetworkProfileManager"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network Profile Manager" Height="900" Width="1400"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#FF0A0A0A"
        FontFamily="Segoe UI">
    
    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#FF0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"
                                            Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF106EBE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#FF28A745"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF218838"/>
                    <Setter Property="ScaleTransform.ScaleX" Value="1.05"/>
                    <Setter Property="ScaleTransform.ScaleY" Value="1.05"/>
                </Trigger>
            </Style.Triggers>
            <Style.Resources>
                <Storyboard x:Key="PulseAnimation">
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                    From="1.0" To="0.7" Duration="0:0:1"
                                    AutoReverse="True" RepeatBehavior="Forever"/>
                </Storyboard>
            </Style.Resources>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#FFDC3545"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFC82333"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WarningButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#FFFFC107"/>
            <Setter Property="Foreground" Value="#FF212529"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFE0A800"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Text Styles -->
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="10,5"/>
        </Style>

        <Style x:Key="SubHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFCCCCCC"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="10,5"/>
        </Style>

        <Style x:Key="DataTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFCCCCCC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="5,2"/>
        </Style>

        <!-- Input Styles -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#FF2A2A2A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#FF808080"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="SelectionBrush" Value="#FF0078D4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontSize="{TemplateBinding FontSize}"
                                          FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#FF0078D4"/>
                                <Setter Property="BorderThickness" Value="3"/>
                                <Setter Property="Background" Value="#FF1A1A1A"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#FF909090"/>
                                <Setter Property="Background" Value="#FF1F1F1F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#FF404045"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#FF606060"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" 
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Foreground="{TemplateBinding Foreground}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow" Grid.Column="1" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="#FF808080"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="BorderBrush" Value="#FF0078D4"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="12,3,30,3" VerticalAlignment="Center" HorizontalAlignment="Left"
                                              TextElement.Foreground="White"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="200">
                                    <Border x:Name="DropDownBorder" Background="#FF404045" BorderThickness="2" BorderBrush="#FF606060" CornerRadius="6">
                                        <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter Property="Background" Value="#FF0078D4"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#FF005A9E"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FF2D2D30"/>
            <Setter Property="BorderBrush" Value="#FF404040"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="10"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FF1E1E1E" BorderBrush="#FF404040" BorderThickness="0,0,0,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <Ellipse Width="50" Height="50" Fill="#FFFFFF" Margin="0,0,15,0"/>
                    <TextBlock Text="🌐" FontSize="35" VerticalAlignment="Center" Margin="-64,0,20,0" Foreground="#4CAF50"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="NETWORK PROFILE MANAGER" 
                                  Foreground="White" 
                                  FontWeight="Bold" 
                                  FontSize="24"/>
                        <TextBlock Text="Create, Edit, and Manage Network Profiles" 
                                  Foreground="#FF888888" 
                                  FontSize="14"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" 
                        Name="CloseButton" 
                        Content="✖ Close" 
                        Style="{StaticResource DangerButton}" 
                        Click="CloseButton_Click"
                        Margin="20,0"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="450"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Network List -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Network List Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="📋 Network Profiles" Style="{StaticResource HeaderStyle}" Foreground="#FFD700"/>
                        <Button Name="CreateNetworkButton" 
                                Content="➕ Create New Network" 
                                Style="{StaticResource SuccessButton}"
                                Click="CreateNetworkButton_Click"
                                Margin="20,0,0,0"
                                FontWeight="Bold"
                                FontSize="15">
                            <Button.Triggers>
                                <EventTrigger RoutedEvent="Button.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                            From="1.0" To="0.8" Duration="0:0:1.5"
                                                            AutoReverse="True" RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Button.Triggers>
                        </Button>
                    </StackPanel>

                    <!-- Network List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Name="NetworkListPanel">
                            <!-- Network profiles will be added programmatically -->
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Right Panel - Network Details/Editor -->
            <Border Grid.Column="1" Name="NetworkEditorBorder" Style="{StaticResource CardStyle}" Margin="10,0,0,0" Visibility="Collapsed" Opacity="0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="NetworkEditorTransform" X="50"/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Editor Header -->
                    <TextBlock Grid.Row="0" 
                               Name="EditorHeaderText"
                               Text="⚙️ Network Configuration" 
                               Style="{StaticResource HeaderStyle}"
                               Margin="0,0,0,20"/>

                    <!-- Network Editor -->
                    <ScrollViewer Grid.Row="1" Style="{StaticResource HiddenSmoothScrollViewer}">
                        <StackPanel Name="NetworkEditorPanel">
                            <!-- Basic Information -->
                            <TextBlock Text="Basic Information" Style="{StaticResource SubHeaderStyle}"/>
                            
                            <TextBlock Text="Network Name" Style="{StaticResource DataTextStyle}"/>
                            <TextBox Name="NetworkNameTextBox" 
                                     Style="{StaticResource ModernTextBox}"
                                     Height="60"
                                     FontSize="16"
                                     Margin="0,0,0,15"/>
                            
                            <TextBlock Text="Description" Style="{StaticResource DataTextStyle}"/>
                            <TextBox Name="NetworkDescriptionTextBox" 
                                     Style="{StaticResource ModernTextBox}"
                                     Height="80"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,15"/>
                            
                            <TextBlock Text="Coverage Region" Style="{StaticResource DataTextStyle}"/>
                            <ComboBox Name="CoverageRegionComboBox" 
                                      Style="{StaticResource ModernComboBox}"
                                      Margin="0,0,0,15">
                                <ComboBoxItem Content="Urban Zone"/>
                                <ComboBoxItem Content="Industrial Area"/>
                                <ComboBoxItem Content="Residential District"/>
                                <ComboBoxItem Content="Commercial Center"/>
                                <ComboBoxItem Content="Border Perimeter"/>
                                <ComboBoxItem Content="Emergency Route"/>
                            </ComboBox>
                            
                            <TextBlock Text="Priority Level" Style="{StaticResource DataTextStyle}"/>
                            <ComboBox Name="PriorityLevelComboBox" 
                                      Style="{StaticResource ModernComboBox}"
                                      Margin="0,0,0,15">
                                <ComboBoxItem Content="High Priority"/>
                                <ComboBoxItem Content="Medium Priority" IsSelected="True"/>
                                <ComboBoxItem Content="Low Priority"/>
                            </ComboBox>

                            <Separator Background="#FF404040" Height="1" Margin="0,20"/>

                            <!-- Device Assignment -->
                            <TextBlock Text="Assigned Drones" Style="{StaticResource SubHeaderStyle}"/>
                            
                            <Grid Margin="0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                
                                <ComboBox Grid.Column="0" 
                                          Name="AvailableDronesComboBox"
                                          Style="{StaticResource ModernComboBox}"
                                          Margin="0,0,10,0"/>
                                
                                <Button Grid.Column="1"
                                        Name="AddDroneButton"
                                        Content="➕ Add"
                                        Style="{StaticResource SuccessButton}"
                                        Width="110"
                                        Height="42"
                                        Margin="0"
                                        Click="AddDroneButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <!-- Assigned Drones List -->
                            <Border Background="#FF1A1A1A" 
                                    CornerRadius="6" 
                                    Padding="10" 
                                    Margin="0,10,0,15">
                                <ScrollViewer MaxHeight="200" 
                                            Style="{StaticResource HiddenSmoothScrollViewer}"
                                            Margin="0,0,0,0"
                                            Padding="0,0,5,0">
                                    <StackPanel Name="AssignedDronesPanel" Margin="0,0,5,0">
                                        <!-- Assigned drones will be added programmatically -->
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- CCTV Assignment -->
                            <TextBlock Text="Assigned CCTVs" Style="{StaticResource SubHeaderStyle}"/>
                            <Grid Margin="0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0"
                                          Name="AvailableCctvsComboBox"
                                          Style="{StaticResource ModernComboBox}"
                                          Margin="0,0,10,0"/>

                                <Button Grid.Column="1"
                                        Name="AddCctvButton"
                                        Content="➕ Add"
                                        Style="{StaticResource SuccessButton}"
                                        Width="110"
                                        Height="42"
                                        Margin="0"
                                        Click="AddCctvButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <!-- Assigned CCTVs List -->
                            <Border Background="#FF1A1A1A"
                                    CornerRadius="6"
                                    Padding="10"
                                    Margin="0,10,0,15">
                                <ScrollViewer MaxHeight="200"
                                              Style="{StaticResource HiddenSmoothScrollViewer}"
                                              Margin="0,0,0,0"
                                              Padding="0,0,5,0">
                                    <StackPanel Name="AssignedCctvsPanel" Margin="0,0,5,0">
                                        <!-- Assigned CCTVs will be added programmatically -->
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <Separator Background="#FF404040" Height="1" Margin="0,20"/>

                            <!-- Network Configuration -->
                            <TextBlock Text="Network Configuration" Style="{StaticResource SubHeaderStyle}"/>
                            
                            <TextBlock Text="Operation Mode" Style="{StaticResource DataTextStyle}"/>
                            <ComboBox Name="OperationModeComboBox" 
                                      Style="{StaticResource ModernComboBox}"
                                      Margin="0,0,0,15">
                                <ComboBoxItem Content="Surveillance Mode"/>
                                <ComboBoxItem Content="Patrol Mode" IsSelected="True"/>
                                <ComboBoxItem Content="Emergency Response"/>
                                <ComboBoxItem Content="Search &amp; Rescue"/>
                            </ComboBox>
                            
                            <CheckBox Name="AutoActivateCheckBox"
                                      Content="Auto-activate on detection"
                                      Foreground="White"
                                      FontSize="14"
                                      Margin="0,0,0,15"/>
                            
                            <CheckBox Name="AlertNotificationCheckBox"
                                      Content="Enable alert notifications"
                                      Foreground="White"
                                      FontSize="14"
                                      IsChecked="True"
                                      Margin="0,0,0,15"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Name="SaveNetworkButton" 
                                Content="💾 Save" 
                                Style="{StaticResource SuccessButton}"
                                Click="SaveNetworkButton_Click"
                                MinWidth="100"/>
                        <Button Name="CancelEditButton" 
                                Content="❌ Cancel" 
                                Style="{StaticResource WarningButton}"
                                Click="CancelEditButton_Click"
                                MinWidth="100"/>
                        <Button Name="DeleteNetworkButton" 
                                Content="🗑️ Delete" 
                                Style="{StaticResource DangerButton}"
                                Click="DeleteNetworkButton_Click"
                                MinWidth="100"
                                ToolTip="Delete the selected network"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer Status Bar -->
        <Border Grid.Row="2" Background="#FF1E1E1E">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" 
                          Name="StatusText"
                          Text="Ready - Select a network to edit or create a new one"
                          Foreground="#FF00FF00" 
                          VerticalAlignment="Center" 
                          Margin="15,0"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="15,0">
                    <TextBlock Text="Total Networks: " Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Name="TotalNetworksText" Text="0" Foreground="#FF00FF00" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <TextBlock Text="Active: " Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Name="ActiveNetworksText" Text="0" Foreground="#FF00FF00" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
