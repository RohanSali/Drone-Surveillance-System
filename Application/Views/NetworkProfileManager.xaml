<UserControl x:Class="DroneSurveillanceSystem.Views.NetworkProfileManager"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#FF0F0F0F"
        FontFamily="Segoe UI">
    
    <UserControl.Resources>
        <!-- Color Resources -->
        <Color x:Key="DarkBackground">#FF0F0F0F</Color>
        <Color x:Key="MediumBackground">#FF1E1E1E</Color>
        <Color x:Key="LightBackground">#FF2D2D2D</Color>
        <Color x:Key="NeonBlueColor">#00B4D8</Color>
        <Color x:Key="AccentGreen">#10B981</Color>
        <Color x:Key="AccentRed">#FFDC3545</Color>
        <Color x:Key="AccentYellow">#FFFFC107</Color>
        <Color x:Key="AccentPurple">#FF8B5CF6</Color>
        <Color x:Key="TextPrimary">#FFFFFFFF</Color>
        <Color x:Key="TextSecondary">#FFCCCCCC</Color>
        <Color x:Key="TextTertiary">#FF888888</Color>
        
        <SolidColorBrush x:Key="DarkBackgroundBrush" Color="{StaticResource DarkBackground}"/>
        <SolidColorBrush x:Key="MediumBackgroundBrush" Color="{StaticResource MediumBackground}"/>
        <SolidColorBrush x:Key="LightBackgroundBrush" Color="{StaticResource LightBackground}"/>
        <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource NeonBlueColor}"/>
        <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource AccentGreen}"/>
        <SolidColorBrush x:Key="AccentRedBrush" Color="{StaticResource AccentRed}"/>
        <SolidColorBrush x:Key="AccentYellowBrush" Color="{StaticResource AccentYellow}"/>
        <SolidColorBrush x:Key="AccentPurpleBrush" Color="{StaticResource AccentPurple}"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
        <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiary}"/>

        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"
                                            Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF106EBE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource LightBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" 
                                        Grid.Column="2" 
                                        Focusable="false"
                                        IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                        ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                                <Path x:Name="Arrow" Grid.Column="1" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" 
                                            Content="{TemplateBinding SelectionBoxItem}"
                                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                            ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                            Margin="12,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" 
                                    HorizontalAlignment="Left" VerticalAlignment="Center" 
                                    Margin="12,0,0,0" Focusable="True" Background="Transparent" 
                                    Visibility="Hidden" IsReadOnly="{TemplateBinding IsReadOnly}"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="True" 
                                    MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" 
                                            Background="{StaticResource LightBackgroundBrush}" 
                                            BorderThickness="1" 
                                            BorderBrush="#FF555555"
                                            CornerRadius="4">
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#FF808080"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource AccentGreenBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF218838"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource AccentRedBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFC82333"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WarningButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource AccentYellowBrush}"/>
            <Setter Property="Foreground" Value="#FF212529"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFE0A800"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Text Styles -->
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="SubHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="DataTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- Input Styles -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource LightBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBlueBrush}"/>
        </Style>

        <Style x:Key="ModernComboBoxAlt" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource LightBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="40"/>
        </Style>

        <!-- Card Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource MediumBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="#FF404040"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" Opacity="0.2" BlurRadius="10" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Network Item Style -->
        <Style x:Key="NetworkItemStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource LightBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="#FF404040"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Device Item Style -->
        <Style x:Key="DeviceItemStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource LightBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="#FF404040"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource MediumBackgroundBrush}" BorderBrush="#FF404040" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <Border Width="50" Height="50" Background="{StaticResource AccentBlueBrush}" CornerRadius="25" Margin="0,0,15,0">
                        <TextBlock Text="🌐" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="NETWORK PROFILE MANAGER" 
                                  Foreground="{StaticResource TextPrimaryBrush}" 
                                  FontWeight="Bold" 
                                  FontSize="20"/>
                        <TextBlock Text="Create, manage and deploy surveillance networks" 
                                  Foreground="{StaticResource TextTertiaryBrush}" 
                                  FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" 
                        Name="CloseButton" 
                        Content="✖ Close" 
                        Style="{StaticResource DangerButton}" 
                        Click="CloseButton_Click"
                        Margin="20,0"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="500"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Network List -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Network List Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="📋 Network Profiles" Style="{StaticResource SectionHeader}"/>
                        <Button Name="CreateNetworkButton" 
                                Content="➕ Create New Network" 
                                Style="{StaticResource SuccessButton}"
                                Click="CreateNetworkButton_Click"
                                Margin="20,0,0,0"
                                FontWeight="Bold"/>
                    </StackPanel>

                    <!-- Network List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Name="NetworkListPanel">
                            <!-- Sample Network Item -->
                            <Border Style="{StaticResource NetworkItemStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Urban Surveillance Network" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" FontSize="16"/>
                                        <TextBlock Text="Primary city surveillance coverage" Foreground="{StaticResource TextTertiaryBrush}" FontSize="12" Margin="0,5,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <TextBlock Text="🚁 3 Drones" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,10,0"/>
                                            <TextBlock Text="📷 5 CCTVs" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#FF28A745" CornerRadius="4" Padding="5,2" Margin="0,0,10,0">
                                            <TextBlock Text="ACTIVE" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                        <Button Content="⚙️ Edit" Style="{StaticResource ModernButton}" Width="80" Height="30" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Right Panel - Network Editor -->
            <Border Grid.Column="1" 
                    Name="NetworkEditorBorder" 
                    Style="{StaticResource CardStyle}" 
                    Margin="10,0,0,0"
                    Visibility="Collapsed"
                    Background="{StaticResource MediumBackgroundBrush}"
                    Opacity="0">

                <Border.RenderTransform>
                    <TranslateTransform x:Name="NetworkEditorTransform" X="50"/>
                </Border.RenderTransform>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Editor Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Name="EditorHeaderText" Text="Create New Network" Style="{StaticResource HeaderStyle}"/>
                    </StackPanel>

                    <!-- Network Editor -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Basic Information -->
                            <TextBlock Text="Basic Information" Style="{StaticResource SubHeaderStyle}"/>
                            
                            <TextBlock Text="Network Name" Style="{StaticResource DataTextStyle}"/>
                            <TextBox Name="NetworkNameTextBox" 
                                     Style="{StaticResource ModernTextBox}"
                                     Margin="0,0,0,15"/>
                            
                            <TextBlock Text="Description" Style="{StaticResource DataTextStyle}"/>
                            <TextBox Name="NetworkDescriptionTextBox" 
                                     Style="{StaticResource ModernTextBox}"
                                     Height="60"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled" 
                                     MaxLength="500" 
                                     Margin="0,0,0,15"/>
                            
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Coverage Region" Style="{StaticResource DataTextStyle}"/>
                                    <ComboBox Name="CoverageRegionComboBox" 
                                              Style="{StaticResource ModernComboBox}">
                                        <ComboBoxItem Content="Urban Zone"/>
                                        <ComboBoxItem Content="Industrial Area"/>
                                        <ComboBoxItem Content="Residential District"/>
                                        <ComboBoxItem Content="Commercial Center"/>
                                        <ComboBoxItem Content="Border Perimeter"/>
                                        <ComboBoxItem Content="Emergency Route"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="Priority Level" Style="{StaticResource DataTextStyle}"/>
                                    <ComboBox Name="PriorityLevelComboBox" 
                                              Style="{StaticResource ModernComboBox}">
                                        <ComboBoxItem Content="High Priority"/>
                                        <ComboBoxItem Content="Medium Priority" IsSelected="True"/>
                                        <ComboBoxItem Content="Low Priority"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <Separator Background="#FF404040" Margin="0,0,0,20"/>

                            <!-- Device Assignment -->
                            <TextBlock Text="Device Assignment" Style="{StaticResource SubHeaderStyle}"/>
                            
                            <!-- Drones Section -->
                            <TextBlock Text="Assigned Drones" Style="{StaticResource DataTextStyle}" Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <ComboBox Grid.Column="0" 
                                          Name="AvailableDronesComboBox"
                                          Style="{StaticResource ModernComboBox}"
                                          Margin="0,0,10,0"/>
                                
                                <Button Grid.Column="1"
                                        Name="AddDroneButton"
                                        Content="➕ Add"
                                        Style="{StaticResource SuccessButton}"
                                        Click="AddDroneButton_Click"/>
                            </Grid>

                            <!-- Assigned Drones List -->
                            <Border Background="{StaticResource LightBackgroundBrush}" 
                                    CornerRadius="8" 
                                    Padding="10" 
                                    Margin="0,0,0,15">
                                <StackPanel Name="AssignedDronesPanel">
                                    <TextBlock Text="No drones assigned" Foreground="{StaticResource TextTertiaryBrush}" FontStyle="Italic" HorizontalAlignment="Center" Margin="10"/>
                                </StackPanel>
                            </Border>

                            <!-- CCTVs Section -->
                            <TextBlock Text="Assigned CCTVs" Style="{StaticResource DataTextStyle}" Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0"
                                          Name="AvailableCctvsComboBox"
                                          Style="{StaticResource ModernComboBox}"
                                          Margin="0,0,10,0"/>

                                <Button Grid.Column="1"
                                        Name="AddCctvButton"
                                        Content="➕ Add"
                                        Style="{StaticResource SuccessButton}"
                                        Click="AddCctvButton_Click"/>
                            </Grid>

                            <!-- Assigned CCTVs List -->
                            <Border Background="{StaticResource LightBackgroundBrush}"
                                    CornerRadius="8"
                                    Padding="10"
                                    Margin="0,0,0,20">
                                <StackPanel Name="AssignedCctvsPanel">
                                    <TextBlock Text="No CCTVs assigned" Foreground="{StaticResource TextTertiaryBrush}" FontStyle="Italic" HorizontalAlignment="Center" Margin="10"/>
                                </StackPanel>
                            </Border>

                            <Separator Background="#FF404040" Margin="0,0,0,20"/>

                            <!-- Network Configuration -->
                            <TextBlock Text="Network Configuration" Style="{StaticResource SubHeaderStyle}"/>
                            
                            <TextBlock Text="Operation Mode" Style="{StaticResource DataTextStyle}"/>
                            <ComboBox Name="OperationModeComboBox" 
                                      Style="{StaticResource ModernComboBox}"
                                      Margin="0,0,0,15">
                                <ComboBoxItem Content="Surveillance Mode"/>
                                <ComboBoxItem Content="Patrol Mode" IsSelected="True"/>
                                <ComboBoxItem Content="Emergency Response"/>
                                <ComboBoxItem Content="Search &amp; Rescue"/>
                            </ComboBox>
                            
                            <StackPanel Orientation="Vertical" Margin="0,0,0,15">
                                <CheckBox Name="AutoActivateCheckBox"
                                          Content="Auto-activate on detection"
                                          Foreground="{StaticResource TextSecondaryBrush}"
                                          FontSize="14"/>
                                <CheckBox Name="AlertNotificationCheckBox"
                                          Content="Enable alert notifications"
                                          Foreground="{StaticResource TextSecondaryBrush}"
                                          FontSize="14"
                                          IsChecked="True"
                                          Margin="0,10,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Name="SaveNetworkButton" 
                                Content="💾 Save" 
                                Style="{StaticResource SuccessButton}"
                                Click="SaveNetworkButton_Click"
                                MinWidth="100"/>
                        <Button Name="CancelEditButton" 
                                Content="❌ Cancel" 
                                Style="{StaticResource WarningButton}"
                                Click="CancelEditButton_Click"
                                MinWidth="100"
                                Margin="10,0,0,0"/>
                        <Button Name="DeleteNetworkButton" 
                                Content="🗑️ Delete" 
                                Style="{StaticResource DangerButton}"
                                Click="DeleteNetworkButton_Click"
                                MinWidth="100"
                                Margin="10,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer Status Bar -->
        <Border Grid.Row="2" Background="{StaticResource MediumBackgroundBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" 
                          Name="StatusText"
                          Text="Ready - Select a network to edit or create a new one"
                          Foreground="{StaticResource AccentGreenBrush}" 
                          VerticalAlignment="Center" 
                          Margin="15,0"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="15,0">
                    <TextBlock Text="Total Networks: " Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Name="TotalNetworksText" Text="0" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <TextBlock Text="Active: " Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Name="ActiveNetworksText" Text="0" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>