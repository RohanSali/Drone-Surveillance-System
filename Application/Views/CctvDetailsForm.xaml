<Window x:Class="DroneSurveillanceSystem.Views.CctvDetailsForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        ResizeMode="CanResize"
        WindowStyle="None"
        Background="#1A1A1A"
        Height="700" Width="900">

    <Window.Resources>
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#2d2d2d"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                        Margin="{TemplateBinding Padding}"
                                        VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#0078d4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#ccc"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#0078d4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="25,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#106ebe"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#005a9e"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#6c757d"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="25,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5a6268"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#545b62"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#2d2d2d"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Name="MainBorder" 
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Name="ContentSite"
                                                  Grid.Column="0"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"/>
                                <Path Name="Arrow"
                                      Grid.Column="1"
                                      Fill="White"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M 0 0 L 4 4 L 8 0 Z"/>
                                <ToggleButton Name="ToggleButton" 
                                            Grid.ColumnSpan="2"
                                            Focusable="false"
                                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                            ClickMode="Press"
                                            Background="Transparent"
                                            BorderThickness="0"/>
                            </Grid>
                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" 
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Name="DropDownBorder"
                                            Background="#2d2d2d"
                                            BorderThickness="1"
                                            BorderBrush="#555"
                                            CornerRadius="6"
                                            Effect="{x:Null}">
                                        <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#0078d4"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#0078d4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Name="ItemBorder" 
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#0078d4"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#106ebe"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2d2d2d" CornerRadius="8" Padding="20" Margin="0,0,0,30">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="📷" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="CCTV Details Form" 
                               Foreground="White" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Enter camera configuration details" 
                               Foreground="#ccc" 
                               FontSize="14" 
                               HorizontalAlignment="Center" 
                               Margin="0,5,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="CloseButton" 
                        Content="Close" 
                        Background="#FF5252" 
                        Foreground="White" 
                        FontWeight="Bold"
                        Padding="12,8"
                        Click="CloseButton_Click"
                        Style="{StaticResource PrimaryButton}"/>
            </Grid>
        </Border>

        <!-- Form Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                <!-- Camera IP -->
                <TextBlock Text="Camera IP Address *" Style="{StaticResource ModernLabel}"/>
                <TextBox x:Name="CameraIpTextBox" 
                         Style="{StaticResource ModernTextBox}"
                         Text="192.168.1.100"
                         Margin="0,0,0,20"/>

                <!-- Location -->
                <TextBlock Text="Location *" Style="{StaticResource ModernLabel}"/>
                <TextBox x:Name="LocationTextBox" 
                         Style="{StaticResource ModernTextBox}"
                         Text="Main Entrance"
                         Margin="0,0,0,20"/>

                <!-- Model -->
                <TextBlock Text="Camera Model *" Style="{StaticResource ModernLabel}"/>
                <TextBox x:Name="ModelTextBox" 
                         Style="{StaticResource ModernTextBox}"
                         Text="HD-2000 Pro"
                         Margin="0,0,0,20"/>

                <!-- Timestamp Format -->
                <TextBlock Text="Timestamp Format *" Style="{StaticResource ModernLabel}"/>
                <ComboBox x:Name="TimestampComboBox" 
                          Style="{StaticResource ModernComboBox}"
                          Margin="0,0,0,20">
                    <ComboBoxItem Content="YYYY-MM-DD HH:MM:SS" IsSelected="True"/>
                    <ComboBoxItem Content="DD/MM/YYYY HH:MM:SS"/>
                    <ComboBoxItem Content="MM-DD-YYYY HH:MM:SS"/>
                    <ComboBoxItem Content="ISO 8601 Format"/>
                </ComboBox>

                <!-- Frames Per Second -->
                <TextBlock Text="Frames Per Second *" Style="{StaticResource ModernLabel}"/>
                <ComboBox x:Name="FpsComboBox" 
                          Style="{StaticResource ModernComboBox}"
                          Margin="0,0,0,20">
                    <ComboBoxItem Content="15 FPS"/>
                    <ComboBoxItem Content="24 FPS"/>
                    <ComboBoxItem Content="30 FPS" IsSelected="True"/>
                    <ComboBoxItem Content="60 FPS"/>
                    <ComboBoxItem Content="120 FPS"/>
                </ComboBox>

                <!-- Resolution -->
                <TextBlock Text="Resolution *" Style="{StaticResource ModernLabel}"/>
                <ComboBox x:Name="ResolutionComboBox" 
                          Style="{StaticResource ModernComboBox}"
                          Margin="0,0,0,20">
                    <ComboBoxItem Content="720p HD"/>
                    <ComboBoxItem Content="1080p Full HD" IsSelected="True"/>
                    <ComboBoxItem Content="1440p QHD"/>
                    <ComboBoxItem Content="2160p 4K"/>
                </ComboBox>

                <!-- Additional Settings -->
                <Border Background="#2d2d2d" CornerRadius="8" Padding="20" Margin="0,10,0,20">
                    <StackPanel>
                        <TextBlock Text="Additional Settings" 
                                   Foreground="White" 
                                   FontSize="16" 
                                   FontWeight="SemiBold" 
                                   Margin="0,0,0,15"/>
                        
                        <CheckBox x:Name="NightVisionCheckBox" 
                                  Content="Enable Night Vision" 
                                  Foreground="#ccc" 
                                  FontSize="14"
                                  IsChecked="True"
                                  Margin="0,0,0,10"/>
                        
                        <CheckBox x:Name="MotionDetectionCheckBox" 
                                  Content="Enable Motion Detection" 
                                  Foreground="#ccc" 
                                  FontSize="14"
                                  IsChecked="True"
                                  Margin="0,0,0,10"/>
                        
                        <CheckBox x:Name="AudioRecordingCheckBox" 
                                  Content="Enable Audio Recording" 
                                  Foreground="#ccc" 
                                  FontSize="14"
                                  IsChecked="False"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Background="#2d2d2d" CornerRadius="8" Padding="20" Margin="0,20,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="SaveButton" 
                        Content="💾 Save Configuration" 
                        Style="{StaticResource PrimaryButton}" 
                        Click="SaveButton_Click" 
                        Margin="0,0,15,0"
                        Width="160"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
