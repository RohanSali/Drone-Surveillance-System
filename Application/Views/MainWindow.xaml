<Window x:Class="DroneSurveillanceSystem.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DroneSurveillanceSystem.Views"
        mc:Ignorable="d"
        Title="Drone AI Surveillance System - Advanced Monitoring" 
        WindowStartupLocation="CenterScreen"
        Background="#1A1A1A"
        FontFamily="Segoe UI"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        MinWidth="1200"
        MinHeight="800"
        SizeChanged="Window_SizeChanged">

    <Window.Resources>
        <local:ActiveStatusDotConverter x:Key="ActiveStatusDotConverter"/>
        <local:BoolStatusDotConverter x:Key="BoolStatusDotConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Modern Grey Color Palette -->
        <Color x:Key="DarkGrey">#1A1A1A</Color>
        <Color x:Key="MediumGrey">#2D2D2D</Color>
        <Color x:Key="LightGrey">#404040</Color>
        <Color x:Key="LighterGrey">#555555</Color>
        <Color x:Key="AccentBlue">#00B4D8</Color>
        <Color x:Key="SuccessGreen">#4ACF50</Color>
        <Color x:Key="WarningOrange">#F59E0B</Color>
        <Color x:Key="ErrorRed">#dc3545</Color>
        <Color x:Key="PurpleAccent">#8B5CF6</Color>
        <Color x:Key="TextPrimary">#FFFFFF</Color>
        <Color x:Key="TextSecondary">#CCCCCC</Color>
        <Color x:Key="TextTertiary">#999999</Color>

        <SolidColorBrush x:Key="DarkGreyBrush" Color="{StaticResource DarkGrey}"/>
        <SolidColorBrush x:Key="MediumGreyBrush" Color="{StaticResource MediumGrey}"/>
        <SolidColorBrush x:Key="LightGreyBrush" Color="{StaticResource LightGrey}"/>
        <SolidColorBrush x:Key="LighterGreyBrush" Color="{StaticResource LighterGrey}"/>
        <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlue}"/>
        <SolidColorBrush x:Key="SuccessGreenBrush" Color="{StaticResource SuccessGreen}"/>
        <SolidColorBrush x:Key="WarningOrangeBrush" Color="{StaticResource WarningOrange}"/>
        <SolidColorBrush x:Key="ErrorRedBrush" Color="{StaticResource ErrorRed}"/>
        <SolidColorBrush x:Key="PurpleAccentBrush" Color="{StaticResource PurpleAccent}"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
        <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiary}"/>

        <!-- Responsive Font Size Converter -->
        <local:ResponsiveFontSizeConverter x:Key="ResponsiveFontSizeConverter"/>
        
        <!-- Responsive Margin Converter -->
        <local:ResponsiveMarginConverter x:Key="ResponsiveMarginConverter"/>
        
        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource LightGreyBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.ResponsiveFontSize, Converter={StaticResource ResponsiveFontSizeConverter}, ConverterParameter=14}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"
                                            Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4D4D4D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#595959"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#333333"/>
                                <Setter Property="Foreground" Value="#777777"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Window Control Button Styles -->
        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="1,0,0,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MinimizeWindowButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#333333"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#555555"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MaximizeWindowButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#333333"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#555555"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseWindowButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#F1707A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Primary Button Style -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource LighterGreyBrush}"/>
            <!-- Changed to #555555 -->
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4D4D4D"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#595959"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Danger Button Style -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource ErrorRedBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DC2626"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#B91C1C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Success Button Style -->
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource SuccessGreenBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#059669"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#047857"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Status Text Styles -->
        <Style x:Key="StatusTextBlock" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>

        <Style x:Key="AlertTextBlock" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ErrorRedBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <!-- Card Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource MediumGreyBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" Opacity="0.1" ShadowDepth="2" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hidden Smooth ScrollViewer Style -->
        <Style x:Key="HiddenSmoothScrollViewer" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Hidden"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Hidden"/>
            <Setter Property="CanContentScroll" Value="True"/>
            <Setter Property="PanningMode" Value="VerticalOnly"/>
            <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
        </Style>

        <!-- ToggleButton Style for User Profile -->
        <Style x:Key="UserProfileToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="20"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.HeaderHeight}" />
            <RowDefinition Height="*" />
            <RowDefinition Height="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.FooterHeight}" />
        </Grid.RowDefinitions>

        <!-- Add this to your MainWindow.xaml where you want the settings to appear -->
        <Border x:Name="SettingsOverlay" 
                Grid.Row="0" Grid.RowSpan="3"
                Background="{StaticResource DarkGreyBrush}"
                Visibility="Collapsed"
                Panel.ZIndex="10">
            <Grid x:Name="SettingsContentHost">
                <!-- SettingsPage will be added here programmatically -->
            </Grid>
        </Border>

        <!-- Header -->
        <Border Background="{StaticResource MediumGreyBrush}" Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <!-- Add this for window controls -->
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <Border Background="{StaticResource DarkGreyBrush }" 
                    Width="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.LogoSize}" 
                    Height="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.LogoSize}" 
                    Margin="0,0,12,0"
                    CornerRadius="50">
                        <Border Background="{StaticResource DarkGreyBrush }" 
                    Width="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.LogoInnerSize}"
                    Height="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.LogoInnerSize}"
                    CornerRadius="12"
                    Margin="2">
                            <Image Source="pack://application:,,,/Images/logo.png"
                    Stretch="Uniform"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"/>
                        </Border>
                    </Border>

                    <TextBlock Text="Vigilance and Rapid Alerts" 
                            Foreground="{StaticResource TextPrimaryBrush}" 
                            FontWeight="Bold" 
                            FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.TitleFontSize}" 
                            VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right Side - Navigation and User Profile -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <!-- Your existing buttons here -->
                    <Button Name="LostFindingButton" 
                            Style="{StaticResource SecondaryButton}" 
                            Click="LostFindingButton_Click"
                            Height="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.ButtonHeight}" 
                            MinWidth="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.ButtonMinWidth}" 
                            Margin="5,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.IconFontSize}" Foreground="white" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Lost Finding" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Name="AdvancedControlButton" 
                            Style="{StaticResource SecondaryButton}" 
                            Click="AdvancedControlButton_Click"
                            Height="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.ButtonHeight}" 
                            MinWidth="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.ButtonMinWidth}" 
                            Margin="5,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🚀" FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.IconFontSize}" Foreground="white" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Device Controls" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>


                    <!-- User Profile Dropdown -->
                    <StackPanel x:Name="UserProfilePanel" Orientation="Horizontal" Margin="10,0,0,0">
                        <!-- User Profile Icon -->
                        <ToggleButton x:Name="UserProfileToggle" 
                                    Style="{StaticResource UserProfileToggleStyle}"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    Padding="5"
                                    Cursor="Hand">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" CornerRadius="20">
                                        <Grid>
                                            <Ellipse x:Name="profileCircle" 
                                                    Width="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.ProfileIconSize}" 
                                                    Height="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.ProfileIconSize}" 
                                                    Fill="{StaticResource AccentBlueBrush}">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect BlurRadius="10" Opacity="0.3" ShadowDepth="2"/>
                                                </Ellipse.Effect>
                                            </Ellipse>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="profileCircle" Property="Fill" Value="#00B4D8"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="profileCircle" Property="Fill" Value="#00B4D8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>

                            <TextBlock Text="{Binding UserProfile.UserInitials}" 
                                    Foreground="White" 
                                    FontWeight="Bold" 
                                    FontSize="16"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"/>
                        </ToggleButton>

                        <!-- Dropdown Menu -->
                        <Popup x:Name="UserProfilePopup" 
                            Placement="Bottom" 
                            PlacementTarget="{Binding ElementName=UserProfileToggle}"
                            StaysOpen="False"
                            IsOpen="{Binding IsChecked, ElementName=UserProfileToggle}"
                            AllowsTransparency="True"
                            PopupAnimation="Slide"
                            VerticalOffset="5">
                            <Border Width="300" 
                                    Background="{StaticResource MediumGreyBrush}" 
                                    CornerRadius="8"
                                    BorderBrush="{StaticResource LightGreyBrush}"
                                    BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" Opacity="0.3" ShadowDepth="5"/>
                                </Border.Effect>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- User Info Section -->
                                    <Border Grid.Row="0" Background="{StaticResource LightGreyBrush}" CornerRadius="8,8,0,0" Padding="15">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0" VerticalAlignment="Center" Width="40" Height="40">
                                                <Ellipse Fill="{StaticResource AccentBlueBrush}">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="5" Opacity="0.2" ShadowDepth="2"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>

                                                <TextBlock Text="{Binding UserProfile.UserInitials}" 
                                                        Foreground="White" 
                                                        FontWeight="Bold" 
                                                        FontSize="16"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center"/>
                                            </Grid>


                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding UserProfile.UserName}" 
                                                        Foreground="{StaticResource TextPrimaryBrush}" 
                                                        FontWeight="Bold"
                                                        FontSize="14"/>
                                                <TextBlock Text="{Binding UserProfile.DisplayInfo}" 
                                                        Foreground="{StaticResource TextSecondaryBrush}"
                                                        FontSize="12"
                                                        Margin="0,2,0,0"
                                                        Visibility="{Binding UserProfile.ShowContactInfo, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <TextBlock Text="{Binding UserProfile.LoginProvider, StringFormat='Signed in with {0}'}" 
                                                        Foreground="{StaticResource AccentBlueBrush}"
                                                        FontSize="11"
                                                        Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Divider -->
                                    <Rectangle Grid.Row="1" Height="1" Fill="{StaticResource LightGreyBrush}" Margin="10,0"/>

                                    <!-- Settings Option -->
                                    <Button Grid.Row="2"
                                        Name="SettingsButton" 
                                        Style="{StaticResource ModernButton}" 
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalContentAlignment="Left"
                                        Click="SettingsButton_Click"
                                        Padding="15">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚙️" Margin="0,0,10,0" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="Settings" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Logout Option -->
                                    <Button Grid.Row="3"
                                        Name="LogoutButton" 
                                        Style="{StaticResource ModernButton}" 
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalContentAlignment="Left"
                                        Click="LogoutButton_Click"
                                        Padding="15">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🚪" Margin="0,0,10,0" FontSize="16" Foreground="{StaticResource ErrorRedBrush}"/>
                                            <TextBlock Text="Sign out" FontSize="16" Foreground="{StaticResource ErrorRedBrush}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </Popup>
                    </StackPanel>
                </StackPanel>

                <!-- Window Control Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button x:Name="MinimizeButton" 
                            Style="{StaticResource WindowControlButton}" 
                            Click="MinimizeButton_Click"
                            ToolTip="Minimize">
                        <TextBlock Text="─" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>

                    <Button x:Name="MaximizeButton" 
                            Style="{StaticResource WindowControlButton}" 
                            Click="MaximizeButton_Click"
                            ToolTip="Maximize/Restore">
                        <TextBlock x:Name="MaximizeIcon" Text="□" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>

                    <Button x:Name="CloseButton" 
                            Style="{StaticResource CloseWindowButton}" 
                            Click="CloseButton_Click"
                            ToolTip="Close">
                        <TextBlock Text="✕" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Dashboard Content -->
        <Grid Grid.Row="1" Background="{StaticResource DarkGreyBrush}" Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*" MinWidth="800" />
                <ColumnDefinition Width="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.SidebarWidth}" MinWidth="200" MaxWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Main Dashboard Sections -->
            <Grid Grid.Column="0" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1.5*" />
                </Grid.RowDefinitions>

                <!-- Top Row -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="45*"/>
                        <RowDefinition Height="59*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Connect Drone Section -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0" CornerRadius="0" Grid.RowSpan="2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Connect Devices" 
                                      Foreground="{StaticResource TextPrimaryBrush}" 
                                      FontWeight="Bold" 
                                      FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.CardTitleFontSize}" 
                                      HorizontalAlignment="Center" 
                                      Margin="0,0,0,15"/>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <Border Width="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.CardIconSize}" 
                                        Height="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.CardIconSize}" 
                                        Background="{StaticResource MediumGreyBrush}" 
                                        CornerRadius="50"
                                        HorizontalAlignment="Center" 
                                        Margin="0,0,0,10">
                                    <Border Background="{StaticResource MediumGreyBrush}" 
                                            Width="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.CardIconInnerSize}"
                                            Height="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.CardIconInnerSize}"
                                            CornerRadius="30"
                                            Margin="2">
                                        <Image Source="pack://application:,,,/Images/connect drone.png"
                                                Stretch="Uniform"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"/>
                                    </Border>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="ConnectDroneButton" 
                                       Content="Connect Devices" 
                                       Style="{StaticResource SecondaryButton}" 
                                       Click="ConnectDroneButton_Click" 
                                       Margin="0,0,5,0"/>
                                <Button x:Name="AddNetworkButton" 
                                       Content="Add Network" 
                                       Style="{StaticResource SecondaryButton}" 
                                       Click="AddNetworkButton_Click"
                                       Margin="5,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Monitor Drone Section -->
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0" CornerRadius="0" Grid.RowSpan="2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Monitor Devices" 
                                      Foreground="{StaticResource TextPrimaryBrush}" 
                                      FontWeight="Bold" 
                                      FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.CardTitleFontSize}" 
                                      HorizontalAlignment="Center" 
                                      Margin="0,0,0,15"/>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <Border Width="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.CardIconSize}" 
                                        Height="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.CardIconSize}" 
                                        Background="{StaticResource MediumGreyBrush}" 
                                        HorizontalAlignment="Center"
                                        CornerRadius="50"
                                        Margin="0,0,0,10">
                                    <Border Background="{StaticResource MediumGreyBrush}" 
                                            Width="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.CardIconInnerSize}"
                                            Height="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.CardIconInnerSize}"
                                            CornerRadius="28"
                                            Margin="2">
                                        <Image Source="pack://application:,,,/Images/Monitor Drone.png"
                                                Stretch="Uniform"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"/>
                                    </Border>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="NetworkButton" 
                                       Content="Network" 
                                       Style="{StaticResource SecondaryButton}" 
                                       Click="NetworkButton_Click" 
                                       Margin="0,0,5,0"/>
                                <Button Name="MonitoringButton" 
                                       Content="All Devices" 
                                       Style="{StaticResource SecondaryButton}" 
                                       Click="MonitoringButton_Click" 
                                       Margin="5,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Bottom Row - Simulation -->
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <!-- Single Large Simulation Container -->
                    <Border Style="{StaticResource CardStyle}" CornerRadius="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Simulation Content -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 3D Environment Section with Integrated Drone Tracking -->
                                <Border Grid.Column="0" Background="{StaticResource MediumGreyBrush}" CornerRadius="8" Margin="0,0,8,0" Padding="15">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <!-- Live Drone Tracking Title -->
                                        <TextBlock Grid.Row="0" Text="Live Drone Tracking" 
                                                  Foreground="{StaticResource TextPrimaryBrush}" 
                                                  FontWeight="Bold" 
                                                  FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.CardTitleFontSize}" 
                                                  HorizontalAlignment="Center" 
                                                  Margin="0,0,0,15"/>

                                        <!-- Embedded Drone Tracking Control -->
                                        <local:DroneTrackingControl Grid.Row="1" x:Name="EmbeddedTrackingControl" />
                                    </Grid>
                                </Border>

                                <!-- Drone Tracking Section -->
                                <Border Grid.Column="1" Background="{StaticResource MediumGreyBrush}" CornerRadius="8" Margin="0,0,0,0" Padding="24">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="Drone Tracking" 
                                                  Foreground="{StaticResource TextPrimaryBrush}" 
                                                  FontWeight="Bold" 
                                                  FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.CardTitleFontSize}" 
                                                  HorizontalAlignment="Center" 
                                                  Margin="0,0,0,10"/>

                                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <!-- Improved circular icon design -->
                                            <Border Background="{StaticResource MediumGreyBrush}" 
                                                    Width="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.CardIconSize}" 
                                                    Height="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.CardIconSize}" 
                                                    CornerRadius="50" 
                                                    HorizontalAlignment="Center" 
                                                    Margin="0,0,0,15">
                                                <Border Background="{StaticResource MediumGreyBrush}" 
                                                        Width="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.CardIconInnerSize}"
                                                        Height="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.CardIconInnerSize}"
                                                        CornerRadius="30"
                                                        Margin="2">
                                                    <Image Source="pack://application:,,,/Images/Track Drone.png"
                                                            Stretch="Uniform"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Center"/>
                                                </Border>
                                            </Border>

                                            <TextBlock Text="Real-time Location" 
                                                      Foreground="{StaticResource TextSecondaryBrush}" 
                                                      FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.SmallTextFontSize}" 
                                                      HorizontalAlignment="Center" 
                                                      TextAlignment="Center"
                                                      Margin="0,0,0,6"/>
                                            <TextBlock Text="Monitoring Active" 
                                                      Foreground="#4ACF50" 
                                                      FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.SmallTextFontSize}" 
                                                      FontWeight="Bold" 
                                                      HorizontalAlignment="Center"
                                                      TextAlignment="Center"/>
                                        </StackPanel>

                                        <Button Grid.Row="2" Name="DroneTrackingButton" 
                                               Content="🗺️ Open Map View" 
                                               Style="{StaticResource SecondaryButton}" 
                                               Click="DroneTrackingButton_Click"
                                               HorizontalAlignment="Center"
                                               Margin="0,12,0,0"
                                               MinWidth="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.ButtonMinWidth}"
                                               Height="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.ButtonHeight}"
                                               FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.SmallTextFontSize}"
                                               FontWeight="SemiBold"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Right Panel - Active Drones Network -->
            <Border Grid.Column="1" Background="{StaticResource MediumGreyBrush}" 
                    Padding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.SidebarPadding}" 
                    Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Live Drone Tracking Status -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="Live Tracking Status" Foreground="{StaticResource TextSecondaryBrush}" 
                                FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.SidebarTitleFontSize}" 
                                FontWeight="Bold" Margin="0,0,0,10"/>

                        <!-- Dynamic Active Drones Status -->
                        <Border Background="{StaticResource LightGreyBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,8"
                                MouseLeftButtonUp="ActiveDronesCard_Click" Cursor="Hand">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,5">
                                    <TextBlock Text="🚁" FontSize="16" Margin="0,0,5,0" Foreground="{StaticResource SuccessGreenBrush}"/>
                                    <TextBlock Text="Active Drones" Foreground="#4ACF50" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                                <!-- Active Drones count with colored parts -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding NetworkActiveDronesCount}" Foreground="{StaticResource SuccessGreenBrush}" FontSize="20" FontWeight="Bold"/>
                                    <TextBlock Text="/" Foreground="{StaticResource TextPrimaryBrush}" FontSize="20" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding TotalDronesCount}" Foreground="{StaticResource ErrorRedBrush}" FontSize="20" FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Dynamic Active CCTVs Status -->
                        <Border Background="{StaticResource LightGreyBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,8"
                                MouseLeftButtonUp="ActiveCctvsCard_Click" Cursor="Hand">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,5">
                                    <TextBlock Text="📷" FontSize="16" Margin="0,0,5,0" Foreground="{StaticResource WarningOrangeBrush}"/>
                                    <TextBlock Text="Active CCTVs" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding NetworkActiveCctvsCount}" Foreground="{StaticResource SuccessGreenBrush}" FontSize="20" FontWeight="Bold"/>
                                    <TextBlock Text="/" Foreground="{StaticResource TextPrimaryBrush}" FontSize="20" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding TotalCctvsCount}" Foreground="{StaticResource ErrorRedBrush}" FontSize="20" FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Active Alerts Status -->
                        <Border Background="#4a1a1a" CornerRadius="8" Padding="12" Margin="0,0,0,8"
                                MouseLeftButtonUp="ActiveAlertsCard_Click" Cursor="Hand">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,5">
                                    <TextBlock Text="🚨" FontSize="16" Margin="0,0,5,0" Foreground="{StaticResource ErrorRedBrush}"/>
                                    <TextBlock Text="Active Alerts" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ActiveAlertsCount}" 
                                        Foreground="{StaticResource ErrorRedBrush}" 
                                        FontSize="20" 
                                        FontWeight="Bold" 
                                        HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Networks Section - Fixed to take remaining space and connect to bottom -->
                    <Border Grid.Row="1" Background="{StaticResource LightGreyBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0" Text="NETWORKS" 
                                    Foreground="{StaticResource TextSecondaryBrush}" 
                                    FontSize="12" FontWeight="Bold" 
                                    Margin="0,0,0,8"/>
                            
                            <ScrollViewer Grid.Row="1" 
                                        VerticalScrollBarVisibility="Auto" 
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalAlignment="Stretch">
                                <ItemsControl ItemsSource="{Binding Networks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Expander Background="{StaticResource MediumGreyBrush}" 
                                                    BorderBrush="#555555" 
                                                    BorderThickness="1"
                                                    Margin="0,4"
                                                    Foreground="{StaticResource TextPrimaryBrush}"
                                                    FontSize="11"
                                                    FontWeight="Bold"
                                                    IsExpanded="True">
                                                <Expander.HeaderTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <!-- Network Icon -->
                                                            <TextBlock Text="🌐" FontSize="14" Foreground="{StaticResource SuccessGreenBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                            <!-- Network Name -->
                                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </Expander.HeaderTemplate>
                                                
                                                <!-- Devices under this network -->
                                                <StackPanel Margin="8,0,0,0">
                                                    <!-- Drones List -->
                                                    <ItemsControl ItemsSource="{Binding Drones}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{StaticResource DarkGreyBrush}" CornerRadius="6" Padding="8" Margin="0,2">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <!-- Drone Icon -->
                                                                        <TextBlock Grid.Column="0" Text="🚁" FontSize="12" Foreground="{StaticResource SuccessGreenBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                        <!-- Drone Info -->
                                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="10" FontWeight="Bold"/>
                                                                            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextTertiaryBrush}" FontSize="8"/>
                                                                        </StackPanel>
                                                                        <!-- Status Indicator -->
                                                                        <Ellipse Grid.Column="2" Width="6" Height="6" Fill="{Binding StatusText, Converter={StaticResource ActiveStatusDotConverter}}" VerticalAlignment="Center"/>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- CCTVs List -->
                                                    <ItemsControl ItemsSource="{Binding Cctvs}" Margin="0,6,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{StaticResource DarkGreyBrush}" CornerRadius="6" Padding="8" Margin="0,2">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <!-- CCTV Icon -->
                                                                        <TextBlock Grid.Column="0" Text="📷" FontSize="12" Foreground="{StaticResource WarningOrangeBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                        <!-- CCTV Info -->
                                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="10" FontWeight="Bold"/>
                                                                            <TextBlock Text="CCTV" Foreground="{StaticResource TextTertiaryBrush}" FontSize="8"/>
                                                                        </StackPanel>
                                                                        <!-- Status Dot -->
                                                                        <Ellipse Grid.Column="2" Width="6" Height="6" Fill="{Binding IsOnline, Converter={StaticResource BoolStatusDotConverter}}" VerticalAlignment="Center"/>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- System Status at Bottom -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,10">
                        <TextBlock Text="System Status:" Foreground="{StaticResource TextTertiaryBrush}" FontSize="12" Margin="0,0,8,0"/>
                        <TextBlock Text="System Ready" Foreground="{StaticResource SuccessGreenBrush}" FontSize="12" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer Status Bar -->
        <Border Grid.Row="2" Background="{StaticResource MediumGreyBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusBarText" 
                          Text="{Binding SystemStatusMessage}" 
                          Foreground="{StaticResource SuccessGreenBrush}" 
                          VerticalAlignment="Center" 
                          Margin="15,0"
                          FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.FooterFontSize}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="15,0">
                    <TextBlock Text="AI Detection:" 
                              Foreground="{StaticResource TextSecondaryBrush}" 
                              VerticalAlignment="Center" 
                              Margin="0,0,5,0"
                              FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.FooterFontSize}"/>
                    <Ellipse Width="8" Height="8" Fill="{Binding AiStatusColor}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <TextBlock x:Name="TimeDisplay" 
                              Text="{Binding CurrentTime}" 
                              Foreground="{StaticResource TextSecondaryBrush}" 
                              VerticalAlignment="Center" 
                              FontFamily="Consolas"
                              FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.FooterFontSize}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Fullscreen overlay host for in-window navigation. When visible, covers header, content and footer. -->
        <ContentControl x:Name="OverlayContentHost"
                        Grid.Row="0"
                        Grid.RowSpan="3"
                        Visibility="Collapsed"/>
    </Grid>
</Window>