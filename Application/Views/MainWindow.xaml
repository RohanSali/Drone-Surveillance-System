<Window x:Class="DroneSurveillanceSystem.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Drone AI Surveillance System - Advanced Monitoring" Height="900" Width="1400"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource DarkBackgroundBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#0078d4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        
        <Style x:Key="StatusTextBlock" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>
        
        <Style x:Key="AlertTextBlock" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#ff4444"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
        
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        
        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#0078d4"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#005a9e"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="#2d2d2d" Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <Ellipse Width="35" Height="35" Fill="#2563EB" Margin="0,0,12,0"/>
                    <TextBlock Text="🚁" FontSize="24" VerticalAlignment="Center" Margin="-28,0,15,0"/>
                    <TextBlock Text="Drone Surveillance System" 
                              Foreground="White" 
                              FontWeight="Bold" 
                              FontSize="24" 
                              VerticalAlignment="Center"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <Button Name="AdvancedControlButton" Content="🚀 Advanced Control" 
                            Style="{StaticResource ModernButton}" 
                            Click="AdvancedControlButton_Click"
                            Height="40" 
                            MinWidth="150" 
                            Margin="5,0"/>
                    <Button Name="SettingsButton" Content="⚙️ Settings" 
                            Style="{StaticResource ModernButton}" 
                            Click="SettingsButton_Click"
                            Height="40" 
                            MinWidth="100" 
                            Margin="5,0"/>
                    <Button Name="LogoutButton" Content="🚪 Logout" 
                            Style="{StaticResource DangerButton}" 
                            Click="LogoutButton_Click"
                            Height="40" 
                            MinWidth="90" 
                            Margin="5,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Dashboard Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Main Dashboard Sections -->
            <Grid Grid.Column="0" Margin="20,20,15,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                
                <!-- Top Row -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    
                    <!-- Connect Drone Section -->
                    <Border Grid.Column="0" Background="#2d2d2d" CornerRadius="12" Margin="0,0,8,0" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0" Text="Connect Drone" 
                                      Foreground="White" 
                                      FontWeight="Bold" 
                                      FontSize="18" 
                                      HorizontalAlignment="Center" 
                                      Margin="0,0,0,15"/>
                            
                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <Ellipse Width="60" Height="60" Fill="#4CAF50" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="🚁" FontSize="32" HorizontalAlignment="Center" Margin="0,-48,0,15" Foreground="White"/>
                            </StackPanel>
                            
                            <Button Grid.Row="2" x:Name="ConnectDroneButton" 
                                   Content="Connect Drone" 
                                   Style="{StaticResource DarkButton}" 
                                   Click="ConnectDroneButton_Click" 
                                   FontSize="14" 
                                   Padding="15,8"/>
                        </Grid>
                    </Border>
                    
                    <!-- Monitor Drone Section -->
                    <Border Grid.Column="1" Background="#2d2d2d" CornerRadius="12" Margin="8,0,0,0" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0" Text="Monitor Drone" 
                                      Foreground="White" 
                                      FontWeight="Bold" 
                                      FontSize="18" 
                                      HorizontalAlignment="Center" 
                                      Margin="0,0,0,15"/>
                            
                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <Ellipse Width="60" Height="60" Fill="#2563EB" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="📈" FontSize="32" HorizontalAlignment="Center" Margin="0,-48,0,15" Foreground="White"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="NetworkButton" 
                                       Content="Network" 
                                       Style="{StaticResource DarkButton}" 
                                       Click="NetworkButton_Click" 
                                       FontSize="14" 
                                       Padding="15,8" 
                                       Margin="0,0,5,0"/>
                                <Button Name="MonitoringButton" 
                                       Content="All Drones" 
                                       Style="{StaticResource DarkButton}" 
                                       Click="MonitoringButton_Click" 
                                       FontSize="14" 
                                       Padding="15,8" 
                                       Margin="5,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
                
                <!-- Bottom Row - Simulation -->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <!-- Simulation Title -->
                    <TextBlock Grid.Row="0" Text="Simulation" 
                              Foreground="White" 
                              FontWeight="Bold" 
                              FontSize="20" 
                              HorizontalAlignment="Center" 
                              Margin="0,0,0,20"/>
                    
                    <!-- Simulation Content -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        
                        <!-- 3D Environment Section -->
                        <Border Grid.Column="0" Background="#2d2d2d" CornerRadius="12" Margin="0,0,8,0" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" Text="3D Environment" 
                                          Foreground="White" 
                                          FontWeight="Bold" 
                                          FontSize="18" 
                                          HorizontalAlignment="Center" 
                                          Margin="0,0,0,15"/>
                                
                                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                    <Ellipse Width="60" Height="60" Fill="#FF6B35" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <TextBlock Text="🌐" FontSize="32" HorizontalAlignment="Center" Margin="0,-48,0,15" Foreground="White"/>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                            <TextBlock Text="Scene Mode:" Foreground="#ccc" FontSize="10"/>
                                            <TextBlock Text="Urban Zone" Foreground="#00ff00" FontSize="11" FontWeight="Bold"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                            <TextBlock Text="Objects:" Foreground="#ccc" FontSize="10"/>
                                            <TextBlock Text="25 Items" Foreground="#00ff00" FontSize="11" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                        
                        <!-- Drone Tracking Section -->
                        <Border Grid.Column="1" Background="#2d2d2d" CornerRadius="12" Margin="8,0,0,0" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" Text="Drone Tracking" 
                                          Foreground="White" 
                                          FontWeight="Bold" 
                                          FontSize="18" 
                                          HorizontalAlignment="Center" 
                                          Margin="0,0,0,15"/>
                                
                                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                    <Ellipse Width="60" Height="60" Fill="#9C27B0" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <TextBlock Text="📡" FontSize="32" HorizontalAlignment="Center" Margin="0,-48,0,15" Foreground="White"/>
                                </StackPanel>
                                
                                <Button Grid.Row="2" Name="DroneTrackingButton" 
                                       Content="🗺️ Open Tracking" 
                                       Style="{StaticResource DarkButton}" 
                                       Click="DroneTrackingButton_Click" 
                                       FontSize="14" 
                                       Padding="15,8"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Right Panel - Active Drones Network (Attached to Navbar) -->
            <Border Grid.Column="1" Background="#2d2d2d" Padding="20" Margin="0,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Active Drones" 
                              Foreground="White" 
                              FontWeight="Bold" 
                              FontSize="18" 
                              HorizontalAlignment="Center" 
                              Margin="0,0,0,5"/>
                    
                    <TextBlock Grid.Row="1" Text="Network" 
                              Foreground="White" 
                              FontWeight="Bold" 
                              FontSize="18" 
                              HorizontalAlignment="Center" 
                              Margin="0,0,0,20"/>
                    
                    <!-- Live Drone Tracking Status -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,15">
                        <TextBlock Text="Live Tracking Status" Foreground="#ccc" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                        
                        <!-- Dynamic Active Drones Status -->
                        <Border Background="#333" CornerRadius="6" Padding="10" Margin="0,5">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,5">
                                    <TextBlock Text="🚁" FontSize="16" Margin="0,0,5,0"/>
                                    <TextBlock Text="Active Drones" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ActiveDronesCount}" 
                                          Foreground="#4CAF50" 
                                          FontSize="20" 
                                          FontWeight="Bold" 
                                          HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Casualties Status -->
                        <Border Background="#4a1a1a" CornerRadius="6" Padding="10" Margin="0,5">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,5">
                                    <TextBlock Text="⚠️" FontSize="16" Margin="0,0,5,0"/>
                                    <TextBlock Text="Casualties" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBlock Text="{Binding TotalCasualtiesCount}" 
                                          Foreground="#ff4444" 
                                          FontSize="20" 
                                          FontWeight="Bold" 
                                          HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Anomalies Status -->
                        <Border Background="#4a3a1a" CornerRadius="6" Padding="10" Margin="0,5">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,5">
                                    <TextBlock Text="🔍" FontSize="16" Margin="0,0,5,0"/>
                                    <TextBlock Text="Anomalies" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBlock Text="{Binding TotalAnomaliesCount}" 
                                          Foreground="#ffaa00" 
                                          FontSize="20" 
                                          FontWeight="Bold" 
                                          HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        
                        <Separator Background="#444" Height="1" Margin="0,15,0,10"/>
                        
                        <!-- System Status Summary -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="System Status:" Foreground="#ccc" FontSize="12" Margin="0,0,8,0"/>
                            <Ellipse Width="8" Height="8" Fill="{Binding SystemStatusColor}" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding SystemStatusText}" Foreground="{Binding SystemStatusColor}" FontSize="12" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer Status Bar -->
        <Border Grid.Row="2" Background="#2d2d2d">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <TextBlock x:Name="StatusBarText" 
                          Text="{Binding SystemStatusMessage}" 
                          Foreground="#00ff00" 
                          VerticalAlignment="Center" 
                          Margin="15,0"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="15,0">
                    <TextBlock Text="AI Detection:" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <Ellipse Width="8" Height="8" Fill="{Binding AiStatusColor}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <TextBlock x:Name="TimeDisplay" 
                              Text="{Binding CurrentTime}" 
                              Foreground="White" 
                              VerticalAlignment="Center" 
                              FontFamily="Consolas"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

</Window>
