<Window x:Class="DroneSurveillanceSystem.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DroneSurveillanceSystem.Views"
        mc:Ignorable="d"
        Title="Drone AI Surveillance System - Advanced Monitoring" Height="900" Width="1400"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#1a1a1a"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#0078d4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"
                                            Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#106EBE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#666666"/>
                                <Setter Property="Foreground" Value="#cccccc"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="StatusTextBlock" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>
        
        <Style x:Key="AlertTextBlock" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#ff4444"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
        
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        
        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#0078d4"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#005a9e"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="#2d2d2d" Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <Ellipse Width="35" Height="35" Fill="#2563EB" Margin="0,0,12,0"/>
                    <TextBlock Text="🚁" FontSize="24" VerticalAlignment="Center" Margin="-28,0,15,0" Foreground="White"/>
                    <TextBlock Text="Drone Surveillance System" 
                              Foreground="White" 
                              FontWeight="Bold" 
                              FontSize="24" 
                              VerticalAlignment="Center"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <Button Name="AdvancedControlButton" Content="🚀 Advanced Control" 
                            Style="{StaticResource ModernButton}" 
                            Click="AdvancedControlButton_Click"
                            Height="40" 
                            MinWidth="150" 
                            Margin="5,0"/>
                    <Button Name="SettingsButton" Content="⚙️ Settings" 
                            Style="{StaticResource ModernButton}" 
                            Click="SettingsButton_Click"
                            Height="40" 
                            MinWidth="100" 
                            Margin="5,0"/>
                    <Button Name="LogoutButton" Content="🚪 Logout" 
                            Style="{StaticResource DangerButton}" 
                            Click="LogoutButton_Click"
                            Height="40" 
                            MinWidth="90" 
                            Margin="5,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Dashboard Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

            <!-- Left Panel - Main Dashboard Sections -->
            <Grid Grid.Column="0" Margin="20,20,15,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1.5*" />
                </Grid.RowDefinitions>
                
                <!-- Top Row -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    
                    <!-- Connect Drone Section -->
                    <Border Grid.Column="0" Background="#2d2d2d" CornerRadius="12" Margin="0,0,8,0" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0" Text="Connect Devices" 
                                      Foreground="White" 
                                      FontWeight="Bold" 
                                      FontSize="18" 
                                      HorizontalAlignment="Center" 
                                      Margin="0,0,0,15"/>
                            
                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <Ellipse Width="60" Height="60" Fill="#4CAF50" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="🚁" FontSize="32" HorizontalAlignment="Center" Margin="0,-48,0,15" Foreground="White"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="2" Orientation="Vertical">
                                <Button x:Name="ConnectDroneButton" 
                                       Content="Connect Devices" 
                                       Style="{StaticResource DarkButton}" 
                                       Click="ConnectDroneButton_Click" 
                                       Margin="0,0,0,8"/>
                                <Button x:Name="AddNetworkButton" 
                                       Content="Add Network" 
                                       Style="{StaticResource DarkButton}" 
                                       Click="AddNetworkButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <!-- Monitor Drone Section -->
                    <Border Grid.Column="1" Background="#2d2d2d" CornerRadius="12" Margin="8,0,0,0" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0" Text="Monitor Drone" 
                                      Foreground="White" 
                                      FontWeight="Bold" 
                                      FontSize="18" 
                                      HorizontalAlignment="Center" 
                                      Margin="0,0,0,15"/>
                            
                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <Ellipse Width="60" Height="60" Fill="#2563EB" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="📈" FontSize="32" HorizontalAlignment="Center" Margin="0,-48,0,15" Foreground="White"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="NetworkButton" 
                                       Content="Network" 
                                       Style="{StaticResource DarkButton}" 
                                       Click="NetworkButton_Click" 
                                       Margin="0,0,5,0"/>
                                <Button Name="MonitoringButton" 
                                       Content="All Drones" 
                                       Style="{StaticResource DarkButton}" 
                                       Click="MonitoringButton_Click" 
                                       Margin="5,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
                
                <!-- Bottom Row - Simulation -->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <!-- Single Large Simulation Container -->
                    <Border Background="#2d2d2d" CornerRadius="12" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            
                            <!-- Simulation Content -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                
                                <!-- 3D Environment Section with Integrated Drone Tracking -->
                                <Border Grid.Column="0" Background="#1e1e1e" CornerRadius="8" Margin="0,0,8,0" Padding="15">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        
                                        <!-- Live Drone Tracking Title -->
                                        <TextBlock Grid.Row="0" Text="Live Drone Tracking" 
                                                  Foreground="White" 
                                                  FontWeight="Bold" 
                                                  FontSize="18" 
                                                  HorizontalAlignment="Center" 
                                                  Margin="0,0,0,15"/>
                                        
                                        <!-- Embedded Drone Tracking Control -->
                                        <local:DroneTrackingControl Grid.Row="1" x:Name="EmbeddedTrackingControl" />
                                    </Grid>
                                </Border>
                                
                                <!-- Drone Tracking Section -->
                                <Border Grid.Column="1" Background="#1e1e1e" CornerRadius="8" Margin="0,0,0,0" Padding="24">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        
                                        <TextBlock Grid.Row="0" Text="Drone Tracking" 
                                                  Foreground="White" 
                                                  FontWeight="Bold" 
                                                  FontSize="18" 
                                                  HorizontalAlignment="Center" 
                                                  Margin="0,0,0,10"/>
                                        
                                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <!-- Improved circular icon design -->
                                            <Border Background="#9C27B0" 
                                                    Width="80" Height="80" 
                                                    CornerRadius="40" 
                                                    HorizontalAlignment="Center" 
                                                    Margin="0,0,0,15">
                                                <TextBlock Text="📡" 
                                                          FontSize="36" 
                                                          HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center" 
                                                          Foreground="White"/>
                                            </Border>
                                            
                                            <TextBlock Text="Real-time Location" 
                                                      Foreground="#cccccc" 
                                                      FontSize="12" 
                                                      HorizontalAlignment="Center" 
                                                      TextAlignment="Center"
                                                      Margin="0,0,0,6"/>
                                            <TextBlock Text="Monitoring Active" 
                                                      Foreground="#9C27B0" 
                                                      FontSize="11" 
                                                      FontWeight="Bold" 
                                                      HorizontalAlignment="Center"
                                                      TextAlignment="Center"/>
                                        </StackPanel>
                                        
                                        <Button Grid.Row="2" Name="DroneTrackingButton" 
                                               Content="🗺️ Open Map View" 
                                               Style="{StaticResource DarkButton}" 
                                               Click="DroneTrackingButton_Click"
                                               HorizontalAlignment="Center"
                                               Margin="0,12,0,0"
                                               MinWidth="160"
                                               Height="40"
                                               FontSize="13"
                                               FontWeight="SemiBold"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Right Panel - Active Drones Network (Attached to Navbar) -->
            <Border Grid.Column="1" Background="#2d2d2d" Padding="20" Margin="0,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    

                    
                    <!-- Live Drone Tracking Status -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="Live Tracking Status" Foreground="#ccc" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                        
                        <!-- Dynamic Active Drones Status -->
                        <Border Background="#333" CornerRadius="6" Padding="10" Margin="0,5"
                                MouseLeftButtonUp="ActiveDronesCard_Click" Cursor="Hand">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,5">
                                    <TextBlock Text="🚁" FontSize="16" Margin="0,0,5,0" Foreground="#4CAF50"/>
                                    <TextBlock Text="Active Drones" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                                <!-- Active Drones count with colored parts -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                  <TextBlock Text="{Binding NetworkActiveDronesCount}" Foreground="#4CAF50" FontSize="20" FontWeight="Bold"/>
                                  <TextBlock Text="/" Foreground="White" FontSize="20" FontWeight="Bold"/>
                                  <TextBlock Text="{Binding TotalDronesCount}" Foreground="#FF4444" FontSize="20" FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                         <!-- Dynamic Active CCTVs Status -->
                         <Border Background="#333" CornerRadius="6" Padding="10" Margin="0,5">
                             <StackPanel>
                                 <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,5">
                                     <TextBlock Text="📷" FontSize="16" Margin="0,0,5,0" Foreground="#FF9800"/>
                                     <TextBlock Text="Active CCTVs" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                 </StackPanel>
                                 <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                     <TextBlock Text="{Binding NetworkActiveCctvsCount}" Foreground="#4CAF50" FontSize="20" FontWeight="Bold"/>
                                     <TextBlock Text="/" Foreground="White" FontSize="20" FontWeight="Bold"/>
                                     <TextBlock Text="{Binding TotalCctvsCount}" Foreground="#FF4444" FontSize="20" FontWeight="Bold"/>
                                 </StackPanel>
                             </StackPanel>
                         </Border>
                        
                        <!-- Active Alerts Status -->
                        <Border Background="#4a1a1a" CornerRadius="6" Padding="10" Margin="0,5"
                                MouseLeftButtonUp="ActiveAlertsCard_Click" Cursor="Hand">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,5">
                                    <TextBlock Text="⚠️" FontSize="16" Margin="0,0,5,0" Foreground="#ff4444"/>
                                    <TextBlock Text="Active Alerts" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ActiveAlertsCount}" 
                                          Foreground="#ff4444" 
                                          FontSize="20" 
                                          FontWeight="Bold" 
                                          HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Networks Section -->
                        <Border Background="#333" CornerRadius="6" Padding="10" Margin="0,15,0,5">
                            <ScrollViewer Style="{StaticResource HiddenSmoothScrollViewer}" MaxHeight="600">
                            <StackPanel>
                                    <TextBlock Text="NETWORKS" Foreground="#ccc" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding Networks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Expander Background="#2a2a2a" 
                                                          BorderBrush="#444" 
                                                          BorderThickness="1"
                                                          Margin="0,2"
                                                          Foreground="White"
                                                          FontSize="11"
                                                          FontWeight="Bold"
                                                          IsExpanded="True">
                                                    <Expander.HeaderTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <!-- Network Icon -->
                                                                <TextBlock Text="🌐" FontSize="14" Foreground="#4CAF50" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                <!-- Network Name -->
                                                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </Expander.HeaderTemplate>
                                                    <!-- Devices under this network -->
                                                    <StackPanel Margin="8,0,0,0">
                                                        <!-- Drones List -->
                                                        <ItemsControl ItemsSource="{Binding Drones}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="#1a1a1a" CornerRadius="3" Padding="6" Margin="0,1">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <!-- Drone Icon -->
                                                                            <TextBlock Grid.Column="0" Text="🚁" FontSize="12" Foreground="#4CAF50" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                            <!-- Drone Info -->
                                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                                                <TextBlock Text="{Binding StatusText}" Foreground="#ccc" FontSize="8"/>
                                                                            </StackPanel>
                                                                            <!-- Status Indicator -->
                                                                            <Ellipse Grid.Column="2" Width="4" Height="4" Fill="#4CAF50" VerticalAlignment="Center"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <!-- CCTVs List -->
                                                        <ItemsControl ItemsSource="{Binding Cctvs}" Margin="0,6,0,0">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="#1a1a1a" CornerRadius="3" Padding="6" Margin="0,1">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <!-- CCTV Icon -->
                                                                            <TextBlock Grid.Column="0" Text="📷" FontSize="12" Foreground="#FF9800" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                            <!-- CCTV Info -->
                                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                                                <TextBlock Text="CCTV" Foreground="#ccc" FontSize="8"/>
                                                                            </StackPanel>
                                                                            <!-- Status Dot -->
                                                                            <Ellipse Grid.Column="2" Width="4" Height="4" Fill="#4CAF50" VerticalAlignment="Center"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Expander>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                    
                    <!-- System Status at Bottom -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10">
                            <TextBlock Text="System Status:" Foreground="#ccc" FontSize="12" Margin="0,0,8,0"/>
                        <TextBlock Text="System Ready" Foreground="#4CAF50" FontSize="12" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer Status Bar -->
        <Border Grid.Row="2" Background="#2d2d2d">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <TextBlock x:Name="StatusBarText" 
                          Text="{Binding SystemStatusMessage}" 
                          Foreground="#00ff00" 
                          VerticalAlignment="Center" 
                          Margin="15,0"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="15,0">
                    <TextBlock Text="AI Detection:" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <Ellipse Width="8" Height="8" Fill="{Binding AiStatusColor}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <TextBlock x:Name="TimeDisplay" 
                              Text="{Binding CurrentTime}" 
                              Foreground="White" 
                              VerticalAlignment="Center" 
                              FontFamily="Consolas"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

</Window>
