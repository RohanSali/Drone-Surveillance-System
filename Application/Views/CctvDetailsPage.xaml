<Window x:Class="DroneSurveillanceSystem.Views.CctvDetailsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CCTV Details - USB Device"
        Height="800" Width="1100"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource DarkBackgroundBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Match DroneDetailsPage visual system -->
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#0078d4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="Margin" Value="15"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="MinHeight" Value="50"/>
        </Style>

        <Style x:Key="OptionButton" TargetType="Button">
            <Setter Property="Background" Value="#28a745"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="25,15"/>
            <Setter Property="Margin" Value="15"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="MinHeight" Value="50"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#218838"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1e7e34"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Red back button with fixed size -->
        <Style x:Key="RedBackButton" TargetType="Button">
            <Setter Property="Background" Value="#FFDC3545"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="40,20"/>
            <Setter Property="Margin" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="220"/>
            <Setter Property="MinHeight" Value="70"/>
            <Setter Property="Width" Value="220"/>
            <Setter Property="Height" Value="70"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFC82333"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FFBD2130"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="110" />
            <RowDefinition Height="*" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="#2d2d2d" Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <Ellipse Width="35" Height="35" Fill="#FF9800" Margin="0,0,12,0"/>
                    <TextBlock Text="📷" FontSize="24" VerticalAlignment="Center" Margin="-28,0,15,0" Foreground="White"/>
                    <StackPanel>
                        <TextBlock x:Name="CctvNameHeader" Text="CCTV Details"
                                   Foreground="White" FontWeight="Bold" FontSize="24"/>
                        <TextBlock x:Name="HeaderId" Text="" Foreground="#cccccc" FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" Name="BackButton" Content="← Back"
                        Style="{StaticResource RedBackButton}"
                        Click="CloseButton_Click"
                        Margin="20,0"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="50">
            <ScrollViewer Style="{StaticResource HiddenSmoothScrollViewer}">
                <Border Background="#2d2d2d" CornerRadius="12" Padding="40" MinHeight="600">
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Big Icon -->
                        <Border Background="#1a1a1a" CornerRadius="15" Padding="25" Margin="0,0,0,30">
                            <Grid>
                                <Ellipse Fill="#2d2d2d" Width="140" Height="140"/>
                                <TextBlock Text="📷" FontSize="120" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                           Foreground="#FF9800"/>
                            </Grid>
                        </Border>

                        <!-- Name -->
                        <TextBlock x:Name="CctvNameDisplay" Text="CCTV_Name" 
                                   Foreground="White" FontWeight="Bold" FontSize="32" 
                                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

                        <!-- Connection Status -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                            <Ellipse Width="16" Height="16" Fill="#4CAF50" Margin="0,0,10,0"/>
                            <TextBlock x:Name="StatusText" Text="USB Connected - Ready" 
                                      Foreground="#4CAF50" FontSize="14"/>
                        </StackPanel>

                        <!-- USB Port Info -->
                        <TextBlock x:Name="UsbPortInfo" Text="USB Port: COM?" 
                                   Foreground="#ccc" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                        <!-- Additional Info -->
                        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,40">
                            <TextBlock x:Name="FirmwareInfo" Text="Firmware: -" Foreground="#ccc" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock x:Name="ResolutionInfo" Text="Current: -" Foreground="#FF9800" FontSize="16" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                            <Button x:Name="ConnectButton" Content="🔗 Connect" Style="{StaticResource DarkButton}" Click="ConnectButton_Click"/>
                            <Button x:Name="FetchButton" Content="📥 Fetch" Style="{StaticResource OptionButton}" Click="FetchButton_Click" IsEnabled="False"/>
                        </StackPanel>

                        <!-- Optional connection options panel (kept for parity) -->
                        <Border x:Name="ConnectionOptionsPanel" Background="#1a1a1a" CornerRadius="8" Padding="25" Margin="0,40,0,20" BorderThickness="2" BorderBrush="#28a745" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="Choose Action:" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,25,0"/>
                                <Button Content="📥 Fetch" Style="{StaticResource OptionButton}" Click="FetchButton_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#2d2d2d">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="💡 Use Connect to enable fetching CCTV details" Foreground="#ccc" FontSize="12"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>


