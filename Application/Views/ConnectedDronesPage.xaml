<Window x:Class="DroneSurveillanceSystem.Views.ConnectedDronesPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DroneSurveillanceSystem.Services"
        mc:Ignorable="d"
        Title="USB Connected Drones - Module Installation" Height="900" Width="1400"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource DarkBackgroundBrush}"
        FontFamily="Segoe UI"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <local:DroneColorConverter x:Key="DroneColorConverter"/>
        
        <Style x:Key="DarkButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
        </Style>
        
        <Style x:Key="RedBackButton" TargetType="Button">
            <Setter Property="Background" Value="#FFDC3545"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="40,20"/>
            <Setter Property="Margin" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="220"/>
            <Setter Property="MinHeight" Value="70"/>
            <Setter Property="Width" Value="220"/>
            <Setter Property="Height" Value="70"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFC82333"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FFBD2130"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="DroneListBoxItem" TargetType="ListBoxItem" BasedOn="{StaticResource ModernListBoxItem}">
        </Style>
    </Window.Resources>

    <Grid>
            <Grid.RowDefinitions>
            <RowDefinition Height="110" />
            <RowDefinition Height="*" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="#2d2d2d" Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="🔌" FontSize="24" VerticalAlignment="Center" Margin="0,0,15,0" Foreground="#FF00BCD4"/>
                    <TextBlock Text="USB Connected Devices" 
                              Foreground="White" 
                              FontWeight="Bold" 
                              FontSize="24" 
                              VerticalAlignment="Center"/>
                </StackPanel>
                
                <Button Grid.Column="1" Name="BackButton" Content="← Back to Main" 
                       Style="{StaticResource RedBackButton}" 
                       Click="BackButton_Click" 
                       Margin="20,0"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            
            <!-- Info Section -->
            <Border Grid.Row="0" Background="#2d2d2d" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="📋 Available USB Connected Devices" 
                              FontWeight="Bold" 
                              FontSize="16" 
                              Margin="0,0,0,10">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF4CAF50" Offset="0"/>
                                <GradientStop Color="#FF8BC34A" Offset="1"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock Text="Select a drone or CCTV to manage via USB connection" 
                              Foreground="#ccc" 
                              FontSize="12"/>

                    <!-- Quick Actions -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="AddDummyDroneButton"
                                Content="➕ Add Dummy Drone"
                                Style="{StaticResource DarkButton}"
                                Click="AddDummyDroneButton_Click"
                                MinWidth="170"
                                Height="36"
                                Margin="0,0,10,0"/>
                        <Button x:Name="AddDummyCctvButton"
                                Content="➕ Add Dummy CCTV"
                                Style="{StaticResource DarkButton}"
                                Click="AddDummyCctvButton_Click"
                                MinWidth="170"
                                Height="36"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <!-- Devices Lists -->
            <Border Grid.Row="1" Background="#1a1a1a" CornerRadius="8" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Connected Drones:" 
                              Foreground="White" 
                              FontWeight="Bold" 
                              FontSize="14" 
                              Margin="0,0,0,15"/>

                    <ListBox Grid.Row="1" x:Name="DronesList" 
                            Background="Transparent" 
                            BorderThickness="0"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Hidden"
                            SelectionChanged="DronesList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource DroneListBoxItem}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <Border Grid.Column="0" Background="#1a1a1a" CornerRadius="8" Padding="8" Margin="0,0,15,0">
                                        <TextBlock Text="🚁" FontSize="24" Foreground="{Binding Name, Converter={StaticResource DroneColorConverter}}"/>
                                    </Border>
                                    
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" 
                                                  Foreground="White" 
                                                  FontWeight="Bold" 
                                                  FontSize="14"/>
                                        <TextBlock Text="{Binding Status}" 
                                                  Foreground="#4CAF50" 
                                                  FontSize="12"/>
                                        <TextBlock Text="{Binding UsbPort}" 
                                                  Foreground="#ccc" 
                                                  FontSize="10"/>
                                        <TextBlock Text="{Binding DroneType}" 
                                                  Foreground="#FF9800" 
                                                  FontSize="10"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Ellipse Width="12" Height="12" Fill="#4CAF50" Margin="0,0,5,0"/>
                                        <TextBlock Text="USB Connected" 
                                                  Foreground="#4CAF50" 
                                                  FontSize="10" 
                                                  VerticalAlignment="Center"/>
                                        <Button Content="✖"
                                                Background="#DC3545"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Width="18" Height="18"
                                                Padding="0"
                                                Margin="8,0,0,0"
                                                Click="DeleteDrone_Click"
                                                Tag="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        

                    </ListBox>

                    <TextBlock Grid.Row="2" Text="Connected CCTVs:" 
                              Foreground="White" 
                              FontWeight="Bold" 
                              FontSize="14" 
                              Margin="0,15,0,15"/>

                    <ListBox Grid.Row="3" x:Name="CctvList"
                            Background="Transparent"
                            BorderThickness="0"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Hidden"
                            SelectionChanged="CctvList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource DroneListBoxItem}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#1a1a1a" CornerRadius="8" Padding="8" Margin="0,0,15,0">
                                        <TextBlock Text="📷" FontSize="24" Foreground="#FF9800"/>
                                    </Border>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}"
                                                  Foreground="White"
                                                  FontWeight="Bold"
                                                  FontSize="14"/>
                                        <TextBlock Text="CCTV"
                                                  Foreground="#4CAF50"
                                                  FontSize="12"/>
                                        <TextBlock Text="{Binding DeviceId}"
                                                  Foreground="#ccc"
                                                  FontSize="10"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Ellipse Width="12" Height="12" Fill="#4CAF50" Margin="0,0,5,0"/>
                                        <TextBlock Text="USB Connected"
                                                  Foreground="#4CAF50"
                                                  FontSize="10"
                                                  VerticalAlignment="Center"/>
                                        <Button Content="✖"
                                                Background="#DC3545"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Width="18" Height="18"
                                                Padding="0"
                                                Margin="8,0,0,0"
                                                Click="DeleteCctv_Click"
                                                Tag="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#2d2d2d">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="💡 Click on a device to manage modules and details" 
                          FontSize="12">
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFFF9800" Offset="0"/>
                            <GradientStop Color="#FFFF5722" Offset="1"/>
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
