<Window x:Class="DroneSurveillanceSystem.Views.ConnectedDronesPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="USB Connected Drones - Module Installation" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource DarkBackgroundBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="DarkButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
        </Style>
        
        <Style x:Key="DroneListBoxItem" TargetType="ListBoxItem" BasedOn="{StaticResource ModernListBoxItem}">
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="#2d2d2d" Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="🔌" FontSize="24" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <TextBlock Text="USB Connected Drones" 
                              Foreground="White" 
                              FontWeight="Bold" 
                              FontSize="24" 
                              VerticalAlignment="Center"/>
                </StackPanel>
                
                <Button Grid.Column="1" Name="BackButton" Content="← Back" 
                       Style="{StaticResource DarkButton}" 
                       Click="BackButton_Click" 
                       Margin="20,0"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            
            <!-- Info Section -->
            <Border Grid.Row="0" Background="#2d2d2d" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="📋 Available USB Connected Drones" 
                              Foreground="White" 
                              FontWeight="Bold" 
                              FontSize="16" 
                              Margin="0,0,0,10"/>
                    <TextBlock Text="Select a drone to install new modules via USB connection" 
                              Foreground="#ccc" 
                              FontSize="12"/>
                </StackPanel>
            </Border>
            
            <!-- Drones List -->
            <Border Grid.Row="1" Background="#1a1a1a" CornerRadius="8" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Connected Drones:" 
                              Foreground="White" 
                              FontWeight="Bold" 
                              FontSize="14" 
                              Margin="0,0,0,15"/>
                    
                    <ListBox Grid.Row="1" x:Name="DronesList" 
                            Background="Transparent" 
                            BorderThickness="0"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            SelectionChanged="DronesList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource DroneListBoxItem}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBlock Grid.Column="0" Text="🚁" FontSize="20" Margin="0,0,15,0"/>
                                    
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" 
                                                  Foreground="White" 
                                                  FontWeight="Bold" 
                                                  FontSize="14"/>
                                        <TextBlock Text="{Binding Status}" 
                                                  Foreground="#4CAF50" 
                                                  FontSize="12"/>
                                        <TextBlock Text="{Binding UsbPort}" 
                                                  Foreground="#ccc" 
                                                  FontSize="10"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Ellipse Width="12" Height="12" Fill="#4CAF50" Margin="0,0,5,0"/>
                                        <TextBlock Text="USB Connected" 
                                                  Foreground="#4CAF50" 
                                                  FontSize="10" 
                                                  VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        
                        <!-- Sample Data Items -->
                        <ListBoxItem>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0" Text="🚁" FontSize="20" Margin="0,0,15,0"/>
                                
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Drone_Alpha_1" 
                                              Foreground="White" 
                                              FontWeight="Bold" 
                                              FontSize="14"/>
                                    <TextBlock Text="Ready for Module Installation" 
                                              Foreground="#4CAF50" 
                                              FontSize="12"/>
                                    <TextBlock Text="USB Port: COM3" 
                                              Foreground="#ccc" 
                                              FontSize="10"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Ellipse Width="12" Height="12" Fill="#4CAF50" Margin="0,0,5,0"/>
                                    <TextBlock Text="USB Connected" 
                                              Foreground="#4CAF50" 
                                              FontSize="10" 
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </ListBoxItem>
                        
                        <ListBoxItem>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0" Text="🚁" FontSize="20" Margin="0,0,15,0"/>
                                
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Drone_Beta_2" 
                                              Foreground="White" 
                                              FontWeight="Bold" 
                                              FontSize="14"/>
                                    <TextBlock Text="Ready for Module Installation" 
                                              Foreground="#4CAF50" 
                                              FontSize="12"/>
                                    <TextBlock Text="USB Port: COM5" 
                                              Foreground="#ccc" 
                                              FontSize="10"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Ellipse Width="12" Height="12" Fill="#4CAF50" Margin="0,0,5,0"/>
                                    <TextBlock Text="USB Connected" 
                                              Foreground="#4CAF50" 
                                              FontSize="10" 
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </ListBoxItem>
                        
                        <ListBoxItem>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0" Text="🚁" FontSize="20" Margin="0,0,15,0"/>
                                
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Drone_Gamma_3" 
                                              Foreground="White" 
                                              FontWeight="Bold" 
                                              FontSize="14"/>
                                    <TextBlock Text="Ready for Module Installation" 
                                              Foreground="#4CAF50" 
                                              FontSize="12"/>
                                    <TextBlock Text="USB Port: COM7" 
                                              Foreground="#ccc" 
                                              FontSize="10"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Ellipse Width="12" Height="12" Fill="#4CAF50" Margin="0,0,5,0"/>
                                    <TextBlock Text="USB Connected" 
                                              Foreground="#4CAF50" 
                                              FontSize="10" 
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </ListBoxItem>
                        
                        <ListBoxItem>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0" Text="🚁" FontSize="20" Margin="0,0,15,0"/>
                                
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Drone_Theta_4" 
                                              Foreground="White" 
                                              FontWeight="Bold" 
                                              FontSize="14"/>
                                    <TextBlock Text="Ready for Module Installation" 
                                              Foreground="#4CAF50" 
                                              FontSize="12"/>
                                    <TextBlock Text="USB Port: COM9" 
                                              Foreground="#ccc" 
                                              FontSize="10"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Ellipse Width="12" Height="12" Fill="#4CAF50" Margin="0,0,5,0"/>
                                    <TextBlock Text="USB Connected" 
                                              Foreground="#4CAF50" 
                                              FontSize="10" 
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </ListBoxItem>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#2d2d2d">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="💡 Click on a drone to access module installation options" 
                          Foreground="#ccc" 
                          FontSize="12"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
