<Window x:Class="DroneSurveillanceSystem.Views.ControlPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Advanced Drone Control Panel"
        WindowState="Maximized"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource DarkBackgroundBrush}">
    
    <Window.Resources>
        <!-- Global style to remove focus visual styles -->
        <Style TargetType="Control">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
        
        <!-- Global style for ScrollBar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#FF2D2D30"/>
            <Setter Property="BorderBrush" Value="#FF404040"/>
            <Setter Property="Foreground" Value="#FF606060"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" 
                               IsDirectionReversed="true">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" 
                                              Opacity="0" 
                                              Focusable="false"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Background="#FF505050" 
                                       BorderBrush="#FF606060" 
                                       BorderThickness="1"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" 
                                              Opacity="0" 
                                              Focusable="false"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF404040"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF505050"/>
                    <Setter Property="BorderBrush" Value="#FF606060"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF1E1E1E"/>
                    <Setter Property="BorderBrush" Value="#FF606060"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="Background" Value="#FF2D2D30"/>
                    <Setter Property="BorderBrush" Value="#FF404040"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkProgressBar" TargetType="ProgressBar">
            <Setter Property="Background" Value="#FF1E1E1E"/>
            <Setter Property="BorderBrush" Value="#FF404040"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="Green"/>
        </Style>

        <Style x:Key="DarkListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style x:Key="DarkListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FF505050"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF404040"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="Background" Value="#FF505050"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="#FF1E1E1E"/>
        </Style>

        <Style x:Key="DarkDataGridColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FF2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF404040"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="DarkDataGridCell" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF404040"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FF505050"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="Background" Value="#FF505050"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="#FF1E1E1E"/>
            <Setter Property="BorderBrush" Value="#FF404040"/>
        </Style>

        <Style x:Key="DarkTabItem" TargetType="TabItem">
            <Setter Property="Background" Value="#FF2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF404040"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FF404040"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#FF505050"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF505050"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="Background" Value="#FF404040"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#FF505050"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusIndicatorStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Margin" Value="5,0"/>
        </Style>

        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="10,5"/>
        </Style>

        <Style x:Key="DataLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFCCCCCC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="5,2"/>
        </Style>

        <Style x:Key="DataValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="5,2"/>
        </Style>

        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#FF2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF404040"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" 
                                          Grid.Column="2" 
                                          Focusable="false" 
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" 
                                                      HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center" 
                                                      Data="M0,0 L4,4 L8,0 Z" 
                                                      Fill="White"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" 
                                              IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              Margin="{TemplateBinding Padding}" 
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Left"/>
                            <TextBox x:Name="PART_EditableTextBox" 
                                     Style="{x:Null}" 
                                     Template="{DynamicResource ComboBoxTextBox}" 
                                     HorizontalAlignment="Left" 
                                     VerticalAlignment="Center" 
                                     Margin="{TemplateBinding Padding}" 
                                     Focusable="True" 
                                     Background="Transparent" 
                                     Foreground="White"
                                     Visibility="Hidden" 
                                     IsReadOnly="{TemplateBinding IsReadOnly}"/>
                            <Popup x:Name="Popup" 
                                   Placement="Bottom" 
                                   IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   AllowsTransparency="True" 
                                   Focusable="False" 
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown" 
                                      SnapsToDevicePixels="True" 
                                      MinWidth="{TemplateBinding ActualWidth}" 
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" 
                                            Background="#FF2D2D30" 
                                            BorderThickness="1" 
                                            BorderBrush="#FF404040"/>
                                    <ScrollViewer Margin="4,6,4,6" 
                                                  SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" 
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF505050"/>
                    <Setter Property="BorderBrush" Value="#FF606060"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="Background" Value="#FF2D2D30"/>
                    <Setter Property="BorderBrush" Value="#FF404040"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#FF2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#FF505050"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FF404040"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="Background" Value="#FF505050"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#FF404040"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Border" 
                                    Grid.Column="0" 
                                    Width="16" 
                                    Height="16" 
                                    Background="#FF2D2D30" 
                                    BorderBrush="#FF404040" 
                                    BorderThickness="1" 
                                    Margin="0,0,5,0">
                                <Path x:Name="CheckMark" 
                                      Data="M1,5 L4,8 L8,2" 
                                      Stroke="White" 
                                      StrokeThickness="2" 
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" 
                                              Content="{TemplateBinding Content}" 
                                              Margin="5,0,0,0" 
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Border" Property="Background" Value="#FF505050"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FF404040"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#FF606060"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkSeparator" TargetType="Separator">
            <Setter Property="Background" Value="#FF404040"/>
            <Setter Property="Margin" Value="0,15"/>
            <Setter Property="Height" Value="1"/>
        </Style>

        <Style x:Key="DarkScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <Style x:Key="DarkScrollBar" TargetType="ScrollBar">
            <Setter Property="Background" Value="#FF2D2D30"/>
            <Setter Property="BorderBrush" Value="#FF404040"/>
            <Setter Property="Foreground" Value="#FF606060"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" 
                               IsDirectionReversed="true">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" 
                                              Opacity="0" 
                                              Focusable="false"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Background="#FF505050" 
                                       BorderBrush="#FF606060" 
                                       BorderThickness="1"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" 
                                              Opacity="0" 
                                              Focusable="false"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Top Navbar - Full Width -->
        <Border Grid.Row="0" Background="#1e293b" BorderBrush="#475569" BorderThickness="0,0,0,2" Padding="0,0,0,0" HorizontalAlignment="Stretch">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🚁" FontSize="32" Margin="20,0,15,0" Foreground="#3b82f6"/>
                    <TextBlock Text="Advanced Drone Control Panel" Style="{StaticResource HeaderTextStyle}" FontSize="24" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="System Status:" Style="{StaticResource DataLabelStyle}" FontSize="14"/>
                    <Ellipse Name="SystemStatusIndicator" Fill="Green" Style="{StaticResource StatusIndicatorStyle}"/>
                    <TextBlock Name="SystemStatusText" Text="Online" Style="{StaticResource DataValueStyle}" FontSize="14"/>
                </StackPanel>
                <Button Grid.Column="2" Content="Close" 
                        Background="#dc3545" 
                        Foreground="White" 
                        BorderThickness="0" 
                        Padding="20,10" 
                        FontSize="15"
                        FontWeight="Bold"
                        Margin="15"
                        Width="120"
                        Height="45"
                        Click="CloseButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#c82333"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#bd2130"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
        <!-- Main Content -->
        <Border Grid.Row="1" Background="#1e293b" CornerRadius="16" Padding="24" Margin="24,24,24,24">
            <TabControl Background="Transparent" BorderBrush="Transparent" Style="{StaticResource DarkTabControl}">
                <!-- Flight Control Tab -->
                <TabItem Header="Flight Control" Foreground="White" Style="{StaticResource DarkTabItem}">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="320"/>
                        </Grid.ColumnDefinitions>
                        <!-- Flight Controls -->
                        <Border Grid.Column="0" Background="#1e232b" BorderBrush="#475569" BorderThickness="1" CornerRadius="10" Margin="0,0,16,0" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Flight Controls" Style="{StaticResource HeaderTextStyle}" FontSize="16"/>
                                <Grid Margin="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Name="TakeOffButton" Content="Take Off" Style="{StaticResource ModernButtonStyle}" Background="#28a745" Foreground="White" Click="TakeOffButton_Click"/>
                                    <Button Grid.Column="1" Name="LandButton" Content="Land" Style="{StaticResource ModernButtonStyle}" Click="LandButton_Click"/>
                                </Grid>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Name="MoveUpButton" Content="↑ Up" Style="{StaticResource ModernButtonStyle}" Click="MoveUpButton_Click"/>
                                    <Button Grid.Column="1" Name="MoveDownButton" Content="↓ Down" Style="{StaticResource ModernButtonStyle}" Click="MoveDownButton_Click"/>
                                </Grid>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Name="StartPatrolButton" Content="Start Patrol" Style="{StaticResource ModernButtonStyle}" Click="StartPatrolButton_Click"/>
                                    <Button Grid.Column="1" Name="StopPatrolButton" Content="Stop Patrol" Style="{StaticResource ModernButtonStyle}" Click="StopPatrolButton_Click"/>
                                </Grid>
                                <Button Name="ReturnHomeButton" Content="Return to Base" Style="{StaticResource ModernButtonStyle}" Click="ReturnHomeButton_Click"/>
                                <Button Name="EmergencyStopButton" Content="EMERGENCY STOP" Background="#dc3545" Foreground="White" Style="{StaticResource ModernButtonStyle}" Click="EmergencyStopButton_Click"/>
                                <Separator Style="{StaticResource DarkSeparator}"/>
                                <TextBlock Text="Flight Mode" Style="{StaticResource HeaderTextStyle}" FontSize="14"/>
                                <ComboBox Name="FlightModeComboBox" Style="{StaticResource DarkComboBox}">
                                    <ComboBoxItem Content="Manual" Style="{StaticResource DarkComboBoxItem}"/>
                                    <ComboBoxItem Content="Autonomous" Style="{StaticResource DarkComboBoxItem}"/>
                                    <ComboBoxItem Content="Patrol Route" Style="{StaticResource DarkComboBoxItem}"/>
                                    <ComboBoxItem Content="Return to Base" Style="{StaticResource DarkComboBoxItem}"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>
                        <!-- Live Data Display -->
                        <Border Grid.Column="1" Background="#23272F" BorderBrush="#475569" BorderThickness="1" CornerRadius="10" Margin="0,0,0,0" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Live Flight Data" Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,10" FontSize="16"/>
                                <ScrollViewer Grid.Row="1" Style="{StaticResource DarkScrollViewer}">
                                    <StackPanel>
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Altitude:" Style="{StaticResource DataLabelStyle}"/>
                                            <TextBlock Grid.Column="1" Name="AltitudeText" Text="0.0 m" Style="{StaticResource DataValueStyle}"/>
                                        </Grid>

                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Speed:" Style="{StaticResource DataLabelStyle}"/>
                                            <TextBlock Grid.Column="1" Name="SpeedText" Text="0.0 m/s" Style="{StaticResource DataValueStyle}"/>
                                        </Grid>

                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="GPS:" Style="{StaticResource DataLabelStyle}"/>
                                            <TextBlock Grid.Column="1" Name="GPSText" Text="0.000000, 0.000000" Style="{StaticResource DataValueStyle}"/>
                                        </Grid>

                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Battery:" Style="{StaticResource DataLabelStyle}"/>
                                            <ProgressBar Name="BatteryProgressBar" Grid.Column="1" Height="20" Maximum="100" Value="85" Style="{StaticResource DarkProgressBar}"/>
                                        </Grid>

                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Battery %:" Style="{StaticResource DataLabelStyle}"/>
                                            <TextBlock Grid.Column="1" Name="BatteryPercentText" Text="85.0%" Style="{StaticResource DataValueStyle}"/>
                                        </Grid>

                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Flight Mode:" Style="{StaticResource DataLabelStyle}"/>
                                            <TextBlock Grid.Column="1" Name="CurrentFlightModeText" Text="Manual" Style="{StaticResource DataValueStyle}"/>
                                        </Grid>

                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Current Zone:" Style="{StaticResource DataLabelStyle}"/>
                                            <TextBlock Grid.Column="1" Name="CurrentZoneText" Text="Zone-A" Style="{StaticResource DataValueStyle}"/>
                                        </Grid>

                                        <Grid Margin="0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Recording:" Style="{StaticResource DataLabelStyle}"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Ellipse Name="RecordingIndicator" Fill="Gray" Style="{StaticResource StatusIndicatorStyle}"/>
                                                <TextBlock Name="RecordingStatusText" Text="Stopped" Style="{StaticResource DataValueStyle}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                        <!-- Connection & Recording -->
                        <Border Grid.Column="2" Background="#1e232b" BorderBrush="#475569" BorderThickness="1" CornerRadius="10" Margin="16,0,0,0" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Connection &amp; Recording" Style="{StaticResource HeaderTextStyle}" FontSize="16"/>
                                <Grid Margin="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Status:" Style="{StaticResource DataLabelStyle}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Ellipse Name="DroneConnectionIndicator" Fill="Red" Style="{StaticResource StatusIndicatorStyle}"/>
                                        <TextBlock Name="DroneConnectionText" Text="Disconnected" Style="{StaticResource DataValueStyle}"/>
                                    </StackPanel>
                                </Grid>
                                <Button Name="ConnectDroneButton" Content="Connect Drone" Style="{StaticResource ModernButtonStyle}" Click="ConnectDroneButton_Click"/>
                                <Button Name="StartRecordingButton" Content="Start Recording" Style="{StaticResource ModernButtonStyle}" Click="StartRecordingButton_Click"/>
                                <Button Name="CalibrateGPSButton" Content="Calibrate GPS" Style="{StaticResource ModernButtonStyle}" Click="CalibrateGPSButton_Click"/>
                                <Separator Style="{StaticResource DarkSeparator}"/>
                                <Grid Margin="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Status:" Style="{StaticResource DataLabelStyle}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Ellipse Name="NetworkStatusIndicator" Fill="Green" Style="{StaticResource StatusIndicatorStyle}"/>
                                        <TextBlock Name="NetworkStatusText" Text="Connected" Style="{StaticResource DataValueStyle}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Signal:" Style="{StaticResource DataLabelStyle}"/>
                                    <ProgressBar Name="SignalStrengthBar" Grid.Column="1" Height="15" Maximum="100" Value="85" Style="{StaticResource DarkProgressBar}" Margin="5,0"/>
                                </Grid>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Strength:" Style="{StaticResource DataLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Name="SignalStrengthText" Text="85%" Style="{StaticResource DataValueStyle}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Data Processing Tab -->
                <TabItem Header="Data Processing" Foreground="White" Style="{StaticResource DarkTabItem}">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Processing Controls -->
                        <Border Grid.Column="0" Background="#FF2D2D30" BorderBrush="#FF404040" BorderThickness="1" CornerRadius="5">
                            <StackPanel Margin="15">
                                <TextBlock Text="Processing Controls" Style="{StaticResource HeaderTextStyle}"/>
                                
                                <Button Name="StartProcessingButton" Content="Start Processing" Style="{StaticResource ModernButtonStyle}" Click="StartProcessingButton_Click"/>
                                <Button Name="StopProcessingButton" Content="Stop Processing" Style="{StaticResource ModernButtonStyle}" Click="StopProcessingButton_Click"/>
                                <Button Name="ClearQueueButton" Content="Clear Queue" Style="{StaticResource ModernButtonStyle}" Click="ClearQueueButton_Click"/>

                                <Separator Style="{StaticResource DarkSeparator}"/>

                                <TextBlock Text="Statistics" Style="{StaticResource HeaderTextStyle}"/>
                                
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Processed:" Style="{StaticResource DataLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Name="PacketsProcessedText" Text="0" Style="{StaticResource DataValueStyle}"/>
                                </Grid>

                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Queue Size:" Style="{StaticResource DataLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Name="QueueSizeText" Text="0" Style="{StaticResource DataValueStyle}"/>
                                </Grid>

                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Avg Time:" Style="{StaticResource DataLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Name="AvgProcessingTimeText" Text="0.0 ms" Style="{StaticResource DataValueStyle}"/>
                                </Grid>

                                <Separator Style="{StaticResource DarkSeparator}"/>

                                <TextBlock Text="Simulate Data" Style="{StaticResource HeaderTextStyle}"/>
                                
                                <CheckBox Name="TelemetryCheckBox" Content="Telemetry" Style="{StaticResource DarkCheckBox}" IsChecked="True" Margin="0,5"/>
                                <CheckBox Name="SensorCheckBox" Content="Sensor Data" Style="{StaticResource DarkCheckBox}" IsChecked="True" Margin="0,2"/>
                                <CheckBox Name="ImageCheckBox" Content="Image Data" Style="{StaticResource DarkCheckBox}" IsChecked="False" Margin="0,2"/>
                                <CheckBox Name="GPSCheckBox" Content="GPS Data" Style="{StaticResource DarkCheckBox}" IsChecked="True" Margin="0,2"/>
                                <CheckBox Name="BatteryCheckBox" Content="Battery Data" Style="{StaticResource DarkCheckBox}" IsChecked="True" Margin="0,2"/>

                                <Button Name="SimulateDataButton" Content="Simulate Data Packets" Style="{StaticResource ModernButtonStyle}" Click="SimulateDataButton_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Processing Events -->
                        <Border Grid.Column="1" Background="#FF2D2D30" BorderBrush="#FF404040" BorderThickness="1" CornerRadius="5" Margin="10,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Processing Events" Style="{StaticResource HeaderTextStyle}" Margin="15"/>
                                
                                <ListBox Grid.Row="1" Name="ProcessingEventsListBox" Style="{StaticResource DarkListBox}" 
                                         Margin="15" FontFamily="Consolas" FontSize="11"/>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- AI Models Tab -->
                <TabItem Header="AI Models" Foreground="White" Style="{StaticResource DarkTabItem}">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>

                        <!-- Model Controls -->
                        <Border Grid.Column="0" Background="#FF2D2D30" BorderBrush="#FF404040" BorderThickness="1" CornerRadius="5">
                            <StackPanel Margin="15">
                                <TextBlock Text="Model Management" Style="{StaticResource HeaderTextStyle}"/>
                                
                                <Button Name="InstallModelButton" Content="Install Model" Style="{StaticResource ModernButtonStyle}" Click="InstallModelButton_Click"/>
                                <Button Name="ActivateModelButton" Content="Activate Model" Style="{StaticResource ModernButtonStyle}" Click="ActivateModelButton_Click"/>
                                <Button Name="DeactivateModelButton" Content="Deactivate Model" Style="{StaticResource ModernButtonStyle}" Click="DeactivateModelButton_Click"/>
                                <Button Name="UninstallModelButton" Content="Uninstall Model" Style="{StaticResource ModernButtonStyle}" Click="UninstallModelButton_Click"/>

                                <Separator Style="{StaticResource DarkSeparator}"/>

                                <Button Name="ProcessTestImageButton" Content="Process Test Image" Style="{StaticResource ModernButtonStyle}" Click="ProcessTestImageButton_Click"/>
                                <Button Name="RefreshModelsButton" Content="Refresh List" Style="{StaticResource ModernButtonStyle}" Click="RefreshModelsButton_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- AI Models List -->
                        <Border Grid.Column="1" Background="#FF2D2D30" BorderBrush="#FF404040" BorderThickness="1" CornerRadius="5" Margin="10,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Available AI Models" Style="{StaticResource HeaderTextStyle}" Margin="15"/>
                                
                                <DataGrid Grid.Row="1" Name="AIModelsDataGrid" Style="{StaticResource DarkDataGrid}" 
                                          Margin="15">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DarkDataGridColumnHeader}"/>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource DarkDataGridCell}"/>
                                    </DataGrid.CellStyle>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- Active Models -->
                        <Border Grid.Column="2" Background="#FF2D2D30" BorderBrush="#FF404040" BorderThickness="1" CornerRadius="5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Active Models" Style="{StaticResource HeaderTextStyle}" Margin="15"/>
                                
                                <ListBox Grid.Row="1" Name="ActiveModelsListBox" Style="{StaticResource DarkListBox}" 
                                         Margin="15" FontSize="11"/>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</Window>
