<Window x:Class="DroneSurveillanceSystem.Views.ControlPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Advanced Drone Control Panel" Height="900" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource DarkBackgroundBrush}">
    
    <Window.Resources>
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF404040"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="StatusIndicatorStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Margin" Value="5,0"/>
        </Style>

        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="10,5"/>
        </Style>

        <Style x:Key="DataLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFCCCCCC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="5,2"/>
        </Style>

        <Style x:Key="DataValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="5,2"/>
        </Style>

        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#FF2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF404040"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>

        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#FF2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#FF3E3E42"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FF007ACC"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FF2D2D30" BorderBrush="#FF404040" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🚁" FontSize="24" Margin="15,0,10,0"/>
                    <TextBlock Text="Advanced Drone Control Panel" Style="{StaticResource HeaderTextStyle}" FontSize="20"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="System Status:" Style="{StaticResource DataLabelStyle}"/>
                    <Ellipse Name="SystemStatusIndicator" Fill="Green" Style="{StaticResource StatusIndicatorStyle}"/>
                    <TextBlock Name="SystemStatusText" Text="Online" Style="{StaticResource DataValueStyle}"/>
                </StackPanel>

                <Button Grid.Column="2" Content="Close" Style="{StaticResource ModernButtonStyle}" 
                        Click="CloseButton_Click" Margin="10"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <TabControl Grid.Row="1" Background="#FF1E1E1E" BorderBrush="#FF404040">
            
            <!-- Flight Control Tab -->
            <TabItem Header="Flight Control" Foreground="White">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <!-- Flight Controls -->
                    <Border Grid.Column="0" Background="#FF2D2D30" BorderBrush="#FF404040" BorderThickness="1" CornerRadius="5">
                        <StackPanel Margin="15">
                            <TextBlock Text="Flight Controls" Style="{StaticResource HeaderTextStyle}"/>
                            
                            <Grid Margin="0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Name="TakeOffButton" Content="Take Off" Style="{StaticResource ModernButtonStyle}" Click="TakeOffButton_Click"/>
                                <Button Grid.Column="1" Name="LandButton" Content="Land" Style="{StaticResource ModernButtonStyle}" Click="LandButton_Click"/>
                            </Grid>

                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Name="MoveUpButton" Content="↑ Up" Style="{StaticResource ModernButtonStyle}" Click="MoveUpButton_Click"/>
                                <Button Grid.Column="1" Name="MoveDownButton" Content="↓ Down" Style="{StaticResource ModernButtonStyle}" Click="MoveDownButton_Click"/>
                            </Grid>

                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Name="StartPatrolButton" Content="Start Patrol" Style="{StaticResource ModernButtonStyle}" Click="StartPatrolButton_Click"/>
                                <Button Grid.Column="1" Name="StopPatrolButton" Content="Stop Patrol" Style="{StaticResource ModernButtonStyle}" Click="StopPatrolButton_Click"/>
                            </Grid>

                            <Button Name="ReturnHomeButton" Content="Return to Base" Style="{StaticResource ModernButtonStyle}" Click="ReturnHomeButton_Click"/>
                            <Button Name="EmergencyStopButton" Content="EMERGENCY STOP" Background="DarkRed" Style="{StaticResource ModernButtonStyle}" Click="EmergencyStopButton_Click"/>

                            <Separator Margin="0,15" Background="#FF404040"/>

                            <TextBlock Text="Flight Mode" Style="{StaticResource HeaderTextStyle}" FontSize="14"/>
                            <ComboBox Name="FlightModeComboBox" Style="{StaticResource DarkComboBox}">
                                <ComboBoxItem Content="Manual" Style="{StaticResource DarkComboBoxItem}"/>
                                <ComboBoxItem Content="Autonomous" Style="{StaticResource DarkComboBoxItem}"/>
                                <ComboBoxItem Content="Patrol Route" Style="{StaticResource DarkComboBoxItem}"/>
                                <ComboBoxItem Content="Return to Base" Style="{StaticResource DarkComboBoxItem}"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- Live Data Display -->
                    <Border Grid.Column="1" Background="#FF2D2D30" BorderBrush="#FF404040" BorderThickness="1" CornerRadius="5" Margin="10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Live Flight Data" Style="{StaticResource HeaderTextStyle}" Margin="15"/>
                            
                            <ScrollViewer Grid.Row="1" Margin="15">
                                <StackPanel>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Altitude:" Style="{StaticResource DataLabelStyle}"/>
                                        <TextBlock Grid.Column="1" Name="AltitudeText" Text="0.0 m" Style="{StaticResource DataValueStyle}"/>
                                    </Grid>

                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Speed:" Style="{StaticResource DataLabelStyle}"/>
                                        <TextBlock Grid.Column="1" Name="SpeedText" Text="0.0 m/s" Style="{StaticResource DataValueStyle}"/>
                                    </Grid>

                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="GPS:" Style="{StaticResource DataLabelStyle}"/>
                                        <TextBlock Grid.Column="1" Name="GPSText" Text="0.000000, 0.000000" Style="{StaticResource DataValueStyle}"/>
                                    </Grid>

                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Battery:" Style="{StaticResource DataLabelStyle}"/>
                                        <ProgressBar Name="BatteryProgressBar" Grid.Column="1" Height="20" Maximum="100" Value="85" Foreground="Green"/>
                                    </Grid>

                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Battery %:" Style="{StaticResource DataLabelStyle}"/>
                                        <TextBlock Grid.Column="1" Name="BatteryPercentText" Text="85.0%" Style="{StaticResource DataValueStyle}"/>
                                    </Grid>

                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Flight Mode:" Style="{StaticResource DataLabelStyle}"/>
                                        <TextBlock Grid.Column="1" Name="CurrentFlightModeText" Text="Manual" Style="{StaticResource DataValueStyle}"/>
                                    </Grid>

                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Current Zone:" Style="{StaticResource DataLabelStyle}"/>
                                        <TextBlock Grid.Column="1" Name="CurrentZoneText" Text="Zone-A" Style="{StaticResource DataValueStyle}"/>
                                    </Grid>

                                    <Grid Margin="0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Recording:" Style="{StaticResource DataLabelStyle}"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Ellipse Name="RecordingIndicator" Fill="Gray" Style="{StaticResource StatusIndicatorStyle}"/>
                                            <TextBlock Name="RecordingStatusText" Text="Stopped" Style="{StaticResource DataValueStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Connection & Recording -->
                    <Border Grid.Column="2" Background="#FF2D2D30" BorderBrush="#FF404040" BorderThickness="1" CornerRadius="5">
                        <StackPanel Margin="15">
                            <TextBlock Text="Connection" Style="{StaticResource HeaderTextStyle}"/>
                            
                            <Grid Margin="0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Status:" Style="{StaticResource DataLabelStyle}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Ellipse Name="DroneConnectionIndicator" Fill="Red" Style="{StaticResource StatusIndicatorStyle}"/>
                                    <TextBlock Name="DroneConnectionText" Text="Disconnected" Style="{StaticResource DataValueStyle}"/>
                                </StackPanel>
                            </Grid>

                            <Button Name="ConnectDroneButton" Content="Connect Drone" Style="{StaticResource ModernButtonStyle}" Click="ConnectDroneButton_Click"/>
                            <Button Name="StartRecordingButton" Content="Start Recording" Style="{StaticResource ModernButtonStyle}" Click="StartRecordingButton_Click"/>
                            <Button Name="CalibrateGPSButton" Content="Calibrate GPS" Style="{StaticResource ModernButtonStyle}" Click="CalibrateGPSButton_Click"/>

                            <Separator Margin="0,15" Background="#FF404040"/>

                            <TextBlock Text="Network" Style="{StaticResource HeaderTextStyle}"/>
                            
                            <Grid Margin="0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Status:" Style="{StaticResource DataLabelStyle}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Ellipse Name="NetworkStatusIndicator" Fill="Green" Style="{StaticResource StatusIndicatorStyle}"/>
                                    <TextBlock Name="NetworkStatusText" Text="Connected" Style="{StaticResource DataValueStyle}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Signal:" Style="{StaticResource DataLabelStyle}"/>
                                <ProgressBar Name="SignalStrengthBar" Grid.Column="1" Height="15" Maximum="100" Value="85" Foreground="Green" Margin="5,0"/>
                            </Grid>

                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Strength:" Style="{StaticResource DataLabelStyle}"/>
                                <TextBlock Grid.Column="1" Name="SignalStrengthText" Text="85%" Style="{StaticResource DataValueStyle}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Data Processing Tab -->
            <TabItem Header="Data Processing" Foreground="White">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Processing Controls -->
                    <Border Grid.Column="0" Background="#FF2D2D30" BorderBrush="#FF404040" BorderThickness="1" CornerRadius="5">
                        <StackPanel Margin="15">
                            <TextBlock Text="Processing Controls" Style="{StaticResource HeaderTextStyle}"/>
                            
                            <Button Name="StartProcessingButton" Content="Start Processing" Style="{StaticResource ModernButtonStyle}" Click="StartProcessingButton_Click"/>
                            <Button Name="StopProcessingButton" Content="Stop Processing" Style="{StaticResource ModernButtonStyle}" Click="StopProcessingButton_Click"/>
                            <Button Name="ClearQueueButton" Content="Clear Queue" Style="{StaticResource ModernButtonStyle}" Click="ClearQueueButton_Click"/>

                            <Separator Margin="0,15" Background="#FF404040"/>

                            <TextBlock Text="Statistics" Style="{StaticResource HeaderTextStyle}"/>
                            
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Processed:" Style="{StaticResource DataLabelStyle}"/>
                                <TextBlock Grid.Column="1" Name="PacketsProcessedText" Text="0" Style="{StaticResource DataValueStyle}"/>
                            </Grid>

                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Queue Size:" Style="{StaticResource DataLabelStyle}"/>
                                <TextBlock Grid.Column="1" Name="QueueSizeText" Text="0" Style="{StaticResource DataValueStyle}"/>
                            </Grid>

                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Avg Time:" Style="{StaticResource DataLabelStyle}"/>
                                <TextBlock Grid.Column="1" Name="AvgProcessingTimeText" Text="0.0 ms" Style="{StaticResource DataValueStyle}"/>
                            </Grid>

                            <Separator Margin="0,15" Background="#FF404040"/>

                            <TextBlock Text="Simulate Data" Style="{StaticResource HeaderTextStyle}"/>
                            
                            <CheckBox Name="TelemetryCheckBox" Content="Telemetry" Foreground="White" IsChecked="True" Margin="0,5"/>
                            <CheckBox Name="SensorCheckBox" Content="Sensor Data" Foreground="White" IsChecked="True" Margin="0,2"/>
                            <CheckBox Name="ImageCheckBox" Content="Image Data" Foreground="White" IsChecked="False" Margin="0,2"/>
                            <CheckBox Name="GPSCheckBox" Content="GPS Data" Foreground="White" IsChecked="True" Margin="0,2"/>
                            <CheckBox Name="BatteryCheckBox" Content="Battery Data" Foreground="White" IsChecked="True" Margin="0,2"/>

                            <Button Name="SimulateDataButton" Content="Simulate Data Packets" Style="{StaticResource ModernButtonStyle}" Click="SimulateDataButton_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Processing Events -->
                    <Border Grid.Column="1" Background="#FF2D2D30" BorderBrush="#FF404040" BorderThickness="1" CornerRadius="5" Margin="10,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Processing Events" Style="{StaticResource HeaderTextStyle}" Margin="15"/>
                            
                            <ListBox Grid.Row="1" Name="ProcessingEventsListBox" Background="Transparent" Foreground="White" 
                                     BorderThickness="0" Margin="15" FontFamily="Consolas" FontSize="11"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- AI Models Tab -->
            <TabItem Header="AI Models" Foreground="White">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>

                    <!-- Model Controls -->
                    <Border Grid.Column="0" Background="#FF2D2D30" BorderBrush="#FF404040" BorderThickness="1" CornerRadius="5">
                        <StackPanel Margin="15">
                            <TextBlock Text="Model Management" Style="{StaticResource HeaderTextStyle}"/>
                            
                            <Button Name="InstallModelButton" Content="Install Model" Style="{StaticResource ModernButtonStyle}" Click="InstallModelButton_Click"/>
                            <Button Name="ActivateModelButton" Content="Activate Model" Style="{StaticResource ModernButtonStyle}" Click="ActivateModelButton_Click"/>
                            <Button Name="DeactivateModelButton" Content="Deactivate Model" Style="{StaticResource ModernButtonStyle}" Click="DeactivateModelButton_Click"/>
                            <Button Name="UninstallModelButton" Content="Uninstall Model" Style="{StaticResource ModernButtonStyle}" Click="UninstallModelButton_Click"/>

                            <Separator Margin="0,15" Background="#FF404040"/>

                            <Button Name="ProcessTestImageButton" Content="Process Test Image" Style="{StaticResource ModernButtonStyle}" Click="ProcessTestImageButton_Click"/>
                            <Button Name="RefreshModelsButton" Content="Refresh List" Style="{StaticResource ModernButtonStyle}" Click="RefreshModelsButton_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- AI Models List -->
                    <Border Grid.Column="1" Background="#FF2D2D30" BorderBrush="#FF404040" BorderThickness="1" CornerRadius="5" Margin="10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Available AI Models" Style="{StaticResource HeaderTextStyle}" Margin="15"/>
                            
                            <DataGrid Grid.Row="1" Name="AIModelsDataGrid" Background="Transparent" Foreground="White" 
                                      BorderThickness="0" Margin="15" GridLinesVisibility="Horizontal" 
                                      HeadersVisibility="Column" CanUserAddRows="False" IsReadOnly="True"/>
                        </Grid>
                    </Border>

                    <!-- Active Models -->
                    <Border Grid.Column="2" Background="#FF2D2D30" BorderBrush="#FF404040" BorderThickness="1" CornerRadius="5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Active Models" Style="{StaticResource HeaderTextStyle}" Margin="15"/>
                            
                            <ListBox Grid.Row="1" Name="ActiveModelsListBox" Background="Transparent" Foreground="White" 
                                     BorderThickness="0" Margin="15" FontSize="11"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
