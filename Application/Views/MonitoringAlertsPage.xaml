<Window x:Class="DroneSurveillanceSystem.Views.MonitoringAlertsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Monitoring and Alerts Page" Height="900" Width="1400"
        WindowStartupLocation="CenterScreen" Background="#1a1a1a">
    <Window.Resources>
        <!-- Comfortable UI Styles -->
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#404040" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#666" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#505050"/>
                                <Setter Property="BorderBrush" Value="#888"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#353535"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AlertCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#2a2a2a" />
            <Setter Property="BorderBrush" Value="#444" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#e0e0e0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="8,4" />
        </Style>

        <Style x:Key="DataTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#b0b0b0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="4,2" />
        </Style>
        
        <Style x:Key="DroneInfoStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#d0d0d0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="8,4" />
            <Setter Property="Background" Value="#333" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Grid setup for UI -->
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Header Section -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#1e1e1e">
            <TextBlock Text="Drone Network Monitoring" Style="{StaticResource HeaderStyle}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Border>

        <!-- All Drones Display -->
        <Border Grid.Row="1" Grid.Column="0" Background="#2a2a2a" CornerRadius="6" Padding="15" Margin="10">
                <StackPanel>
                    <TextBlock Text="🚁 Active Drones" Style="{StaticResource HeaderStyle}" Margin="0,0,0,15"/>
                    
                    <!-- Drone 1 -->
                    <Border Background="#333" CornerRadius="4" Padding="10" Margin="0,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="8" Height="8" Fill="#88C999" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Drone-001" Foreground="White" FontWeight="Bold" FontSize="13"/>
                                <TextBlock Text="Position: 37.7749, -122.4194" Style="{StaticResource DataTextStyle}"/>
                                <TextBlock Text="Altitude: 50m | Battery: 85%" Style="{StaticResource DataTextStyle}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="ACTIVE" Foreground="#88C999" FontSize="11" FontWeight="Bold"/>
                        </Grid>
                    </Border>
                    
                    <!-- Drone 2 -->
                    <Border Background="#333" CornerRadius="4" Padding="10" Margin="0,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="8" Height="8" Fill="#D4B898" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Drone-002" Foreground="White" FontWeight="Bold" FontSize="13"/>
                                <TextBlock Text="Position: 37.7751, -122.4196" Style="{StaticResource DataTextStyle}"/>
                                <TextBlock Text="Altitude: 45m | Battery: 32%" Style="{StaticResource DataTextStyle}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="CHARGING" Foreground="#D4B898" FontSize="11" FontWeight="Bold"/>
                        </Grid>
                    </Border>
                    
                    <!-- Drone 3 -->
                    <Border Background="#333" CornerRadius="4" Padding="10" Margin="0,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="8" Height="8" Fill="#88C999" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Drone-003" Foreground="White" FontWeight="Bold" FontSize="13"/>
                                <TextBlock Text="Position: 37.7747, -122.4192" Style="{StaticResource DataTextStyle}"/>
                                <TextBlock Text="Altitude: 55m | Battery: 78%" Style="{StaticResource DataTextStyle}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="PATROL" Foreground="#88C999" FontSize="11" FontWeight="Bold"/>
                        </Grid>
                    </Border>
                </StackPanel>
        </Border>

        <!-- Alerts Section -->
        <Border Grid.Row="1" Grid.Column="1" Background="#2a2a2a" CornerRadius="6" Padding="15" Margin="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="🚨 Active Alerts" Style="{StaticResource HeaderStyle}" Margin="0,0,0,15"/>
                
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ActiveAlerts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource AlertCardStyle}" Background="#3a2a2a" MouseLeftButtonDown="Alert_Click" Tag="{Binding Timestamp}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🚨" FontSize="14" Margin="0,0,8,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Alert}" Foreground="#E8A598" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock Text="{Binding DroneId}" Style="{StaticResource DataTextStyle}"/>
                                            <TextBlock Text="{Binding Timestamp}" Style="{StaticResource DataTextStyle}" FontSize="10"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Score, StringFormat=F2}" Foreground="#888" FontSize="10"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Footer / Action Buttons -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#1e1e1e">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Content="Acknowledge All Alerts" Style="{StaticResource ButtonStyle}" Margin="10" Click="AcknowledgeAlerts_Click"/>
                <Button Content="Refresh Data" Style="{StaticResource ButtonStyle}" Margin="10" Click="RefreshData_Click"/>
                <Button Content="Back to Dashboard" Style="{StaticResource ButtonStyle}" Margin="10" Click="BackToDashboard_Click"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
