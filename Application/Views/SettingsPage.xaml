<UserControl x:Class="DroneSurveillanceSystem.Views.SettingsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/6"
        xmlns:services="clr-namespace:DroneSurveillanceSystem.Services"
        Background="#1A1A1A">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <!-- Color Resources -->
        <Color x:Key="DarkBackground">#1A1A1A</Color>
        <Color x:Key="MediumBackground">#2D2D2D</Color>
        <Color x:Key="LightBackground">#404040</Color>
        <Color x:Key="AccentBlue">#3B82F6</Color>
        <Color x:Key="SuccessGreen">#10B981</Color>
        <Color x:Key="AccentPurple">#8B5CF6</Color>
        <Color x:Key="TextPrimary">#FFFFFF</Color>
        <Color x:Key="TextSecondary">#CCCCCC</Color>
        <Color x:Key="BorderColor">#555555</Color>
        <Color x:Key="DroneIconColor">#3B82F6</Color>
        <Color x:Key="CctvIconColor">#3B82F6</Color>
        
        <SolidColorBrush x:Key="DarkBackgroundBrush" Color="{StaticResource DarkBackground}"/>
        <SolidColorBrush x:Key="MediumBackgroundBrush" Color="{StaticResource MediumBackground}"/>
        <SolidColorBrush x:Key="LightBackgroundBrush" Color="{StaticResource LightBackground}"/>
        <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlue}"/>
        <SolidColorBrush x:Key="SuccessGreenBrush" Color="{StaticResource SuccessGreen}"/>
        <SolidColorBrush x:Key="AccentPurpleBrush" Color="{StaticResource AccentPurple}"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="DroneIconBrush" Color="{StaticResource DroneIconColor}"/>
        <SolidColorBrush x:Key="CctvIconBrush" Color="{StaticResource CctvIconColor}"/>

        <!-- Button Styles -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"
                                            Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#4B5563"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2D2D2D"/>
                    <Setter Property="BorderBrush" Value="#DC2626"/>
                    <Setter Property="Foreground" Value="#DC2626"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#3D3D3D"/>
                    <Setter Property="BorderBrush" Value="#B91C1C"/>
                    <Setter Property="Foreground" Value="#B91C1C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#DC2626"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B91C1C"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#991B1B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Text Styles -->
        <Style x:Key="SettingsLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="SubSectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Input Control Styles -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource DarkBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="MinWidth" Value="200"/>
            <Setter Property="Height" Value="36"/>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource DarkBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="MinWidth" Value="200"/>
            <Setter Property="Height" Value="36"/>
        </Style>

        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Card Style -->
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource MediumBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

        <!-- Icon Styles -->
        <Style x:Key="SectionIcon" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="DroneIcon" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DroneIconBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="CctvIcon" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource CctvIconBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource MediumBackgroundBrush}" Padding="20" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Settings Icon -->
                <TextBlock Grid.Column="0" Text="⚙️" Style="{StaticResource SectionIcon}" FontSize="24"/>
                
                <!-- Title -->
                <TextBlock Grid.Column="1" Text="Settings" 
                        Foreground="{StaticResource TextPrimaryBrush}" 
                        FontSize="22" 
                        FontWeight="Bold" 
                        VerticalAlignment="Center"/>
                
                <!-- Back Button -->
                <Button Grid.Column="2" 
                x:Name="BackButton" 
                Content="Close" 
                Click="BackButton_Click"
                Background="#dc3545" 
                Foreground="White"
                Height="40" 
                Width="120"
                Style="{StaticResource DangerButton}" 
                HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,2,0">
            <StackPanel>
                <!-- User Profile Section -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Center">
                            <TextBlock Text="👤" Style="{StaticResource SectionIcon}" Foreground="{StaticResource AccentPurpleBrush}"/>
                            <TextBlock Text="User Profile" Style="{StaticResource SectionHeader}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Profile Avatar -->
                            <Border Grid.Column="0" Width="64" Height="64" Background="#00B4D8" CornerRadius="32" Margin="0,0,16,0">
                                <TextBlock Text="{Binding UserInitials, Source={x:Static services:UserProfileService.Instance}}" 
                                           Foreground="White" FontSize="20" FontWeight="Bold" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            
                            <!-- Profile Info -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UserName, Source={x:Static services:UserProfileService.Instance}}" 
                                           Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="{Binding DisplayInfo, Source={x:Static services:UserProfileService.Instance}}" 
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" Margin="0,4,0,0" 
                                           Visibility="{Binding ShowContactInfo, Source={x:Static services:UserProfileService.Instance}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding LoginProvider, Source={x:Static services:UserProfileService.Instance}, StringFormat='Signed in with {0}'}" 
                                           Foreground="{StaticResource SuccessGreenBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="SignOutButton" 
                                Content="Sign Out" 
                                Click="SignOutButton_Click"
                                Background="#dc3545" 
                                Foreground="White"
                                Height="40" 
                                Width="120"
                                Style="{StaticResource DangerButton}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Device Configuration Section -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Center">
                            <TextBlock Text="📱" Style="{StaticResource SectionIcon}"/>
                            <TextBlock Text="Device Configuration" Style="{StaticResource SectionHeader}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Drones Column -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Drones" Style="{StaticResource SubSectionHeader}"/>
                                <ItemsControl ItemsSource="{Binding Drones}" BorderThickness="0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource DarkBackgroundBrush}" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                                                <Expander>
                                                    <Expander.Header>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="🚁" Style="{StaticResource DroneIcon}"/>
                                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                                                            <TextBlock Text=" • " Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Expander.Header>
                                                    <StackPanel Margin="8,12,0,0">
                                                        <TextBlock Text="Device ID (read-only):" Style="{StaticResource SettingsLabel}"/>
                                                        <TextBox Text="{Binding DeviceId}" IsReadOnly="True" Style="{StaticResource ModernTextBox}"/>
                                                        <TextBlock Text="Name:" Style="{StaticResource SettingsLabel}"/>
                                                        <TextBox Text="{Binding Name}" Style="{StaticResource ModernTextBox}"/>
                                                        <TextBlock Text="Bluetooth ID:" Style="{StaticResource SettingsLabel}"/>
                                                        <TextBox Text="{Binding BluetoothMacAddress}" Style="{StaticResource ModernTextBox}"/>
                                                        <TextBlock Text="Internet ID (IP Address):" Style="{StaticResource SettingsLabel}"/>
                                                        <TextBox Text="{Binding IpAddress}" Style="{StaticResource ModernTextBox}"/>
                                                        <TextBlock Text="Current Alert Detection:" Style="{StaticResource SettingsLabel}"/>
                                                        <StackPanel Margin="0,8,0,0">
                                                            <CheckBox Content="Fire" Style="{StaticResource ModernCheckBox}"/>
                                                            <CheckBox Content="Flood" Style="{StaticResource ModernCheckBox}"/>
                                                            <CheckBox Content="Blood" Style="{StaticResource ModernCheckBox}"/>
                                                            <CheckBox Content="Crowd" Style="{StaticResource ModernCheckBox}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Expander>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Separator -->
                            <Rectangle Grid.Column="1" Fill="{StaticResource BorderBrush}" Width="1" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,40,0,0"/>

                            <!-- CCTVs Column -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="CCTVs" Style="{StaticResource SubSectionHeader}"/>
                                <ItemsControl ItemsSource="{Binding Cctvs}" BorderThickness="0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource DarkBackgroundBrush}" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                                                <Expander>
                                                    <Expander.Header>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="📷" Style="{StaticResource CctvIcon}"/>
                                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                                                            <TextBlock Text=" • " Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Expander.Header>
                                                    <StackPanel Margin="8,12,0,0">
                                                        <TextBlock Text="Device ID (read-only):" Style="{StaticResource SettingsLabel}"/>
                                                        <TextBox Text="{Binding DeviceId}" IsReadOnly="True" Style="{StaticResource ModernTextBox}"/>
                                                        <TextBlock Text="Name:" Style="{StaticResource SettingsLabel}"/>
                                                        <TextBox Text="{Binding Name}" Style="{StaticResource ModernTextBox}"/>
                                                        <TextBlock Text="Bluetooth ID:" Style="{StaticResource SettingsLabel}"/>
                                                        <TextBox Text="{Binding BluetoothMacAddress}" Style="{StaticResource ModernTextBox}"/>
                                                        <TextBlock Text="Internet ID (IP Address):" Style="{StaticResource SettingsLabel}"/>
                                                        <TextBox Text="{Binding IpAddress}" Style="{StaticResource ModernTextBox}"/>
                                                        <TextBlock Text="Current Alert Detection:" Style="{StaticResource SettingsLabel}"/>
                                                        <StackPanel Margin="0,8,0,0">
                                                            <CheckBox Content="Fire" Style="{StaticResource ModernCheckBox}"/>
                                                            <CheckBox Content="Flood" Style="{StaticResource ModernCheckBox}"/>
                                                            <CheckBox Content="Blood" Style="{StaticResource ModernCheckBox}"/>
                                                            <CheckBox Content="Crowd" Style="{StaticResource ModernCheckBox}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Expander>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                        
                        <!-- Action Buttons - Moved inside Device Configuration card -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button x:Name="ResetButton" Content="Reset" Style="{StaticResource SecondaryButton}" MinWidth="100"/>
                            <Button x:Name="SaveButton" Content="Save Changes" Style="{StaticResource PrimaryButton}" MinWidth="120" Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- System Information Section -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Center">
                            <TextBlock Text="ℹ️" Style="{StaticResource SectionIcon}"/>
                            <TextBlock Text="System Information" Style="{StaticResource SectionHeader}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="App Version:" Style="{StaticResource SettingsLabel}" Margin="0,0,15,0"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="AppVersionLabel" Style="{StaticResource SettingsLabel}" Foreground="{StaticResource TextSecondaryBrush}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="OS Version:" Style="{StaticResource SettingsLabel}" Margin="0,0,15,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="OsVersionLabel" Style="{StaticResource SettingsLabel}" Foreground="{StaticResource TextSecondaryBrush}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Machine Name:" Style="{StaticResource SettingsLabel}" Margin="0,0,15,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="MachineNameLabel" Style="{StaticResource SettingsLabel}" Foreground="{StaticResource TextSecondaryBrush}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="User Name:" Style="{StaticResource SettingsLabel}" Margin="0,0,15,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="UserNameLabel" Style="{StaticResource SettingsLabel}" Foreground="{StaticResource TextSecondaryBrush}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="CLR Version:" Style="{StaticResource SettingsLabel}" Margin="0,0,15,0"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="ClrVersionLabel" Style="{StaticResource SettingsLabel}" Foreground="{StaticResource TextSecondaryBrush}"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Processor Count:" Style="{StaticResource SettingsLabel}" Margin="0,0,15,0"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="ProcessorCountLabel" Style="{StaticResource SettingsLabel}" Foreground="{StaticResource TextSecondaryBrush}"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Data Path:" Style="{StaticResource SettingsLabel}" Margin="0,0,15,0"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" x:Name="DataPathLabel" Style="{StaticResource SettingsLabel}" Foreground="{StaticResource TextSecondaryBrush}"/>

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Current Directory:" Style="{StaticResource SettingsLabel}" Margin="0,0,15,0"/>
                            <TextBlock Grid.Row="7" Grid.Column="1" x:Name="CurrentDirLabel" Style="{StaticResource SettingsLabel}" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>